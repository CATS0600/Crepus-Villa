---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="发送消息 - Crepus Villa">
    <Header />
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container" style="margin: 2rem auto; padding: 0 var(--container-padding, 1.5rem);">
                <div class="send-header">
                    <h1 style="text-align: center; margin-bottom: 0.5rem;">✨ Send Anything ✨</h1>
                    <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">
                        分享你的想法、建议或任何话。我们会认真对待每一条留言。 <br/> Share your thoughts, suggestions, or anything you like.
                    </p>
                </div>
                
                <div id="submitFormContainer" class="form-container-large">
                    <form id="messageForm">
                        <div class="form-group-large">
                            <label for="content">
                                <span class="label-icon">💭</span>
                                <span>你的想法 Your Thoughts</span>
                            </label>
                            <textarea 
                                id="content" 
                                name="content" 
                                required 
                                placeholder="支持最多2000字   Up to 2000 characters"
                                maxlength="2000"
                            ></textarea>
                            <small id="charCount">0/2000</small>
                        </div>

                        <div class="options-row">
                            <div class="form-group-inline">
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                    <input type="checkbox" id="is_public" name="is_public" />
                                    <span>让所有人看到这条留言 Public it</span>
                                </label>
                                <small style="display: block; margin-top: 0.25rem; color: var(--text-muted); font-size: 0.8rem;">
                                    若不启用，留言将仅对你可见，需通过私密 Token 查看。
                                </small>
                            </div>

                            <div class="form-group-inline">
                                <label for="reply_method">回复方式：</label>
                                <select id="reply_method" name="reply_method" required>
                                    <option value="web">🌐 网页查看 (Web)</option>
                                    <option value="email">📧 邮件通知 (Email)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group-large" id="emailGroup" style="display: none;">
                            <label for="email">
                                <span class="label-icon">📧</span>
                                <span>你的邮箱 Email</span>
                            </label>
                            <input type="email" id="email" name="email" placeholder="Your Email address" />
                        </div>

                        <button type="submit" id="submitBtn" class="submit-btn-large">📤 SEND</button>
                    </form>

                    <div id="successMessage" class="success-message-large" style="display: none;">
                        <div class="success-content">
                            <h3>✅ SENT SUCCESSFULLY!</h3>
                            <p>感谢你的留言！我会尽快查看并回复。</p>
                            <div id="tokenDisplay" style="display: none;">
                                <div class="token-box">
                                    <p><strong>🔐 你的私密 Token / Your Private Token:</strong></p>
                                    <code id="tokenValue"></code>
                                    <button type="button" class="copy-btn-large" id="copyBtn">📋 复制 Token</button>
                                </div>
                            </div>
                        </div>
                        <div class="success-actions">
                            <a href="/reply" class="action-link-btn">👀 查看公开回复</a> 
                            <a href="/" class="action-link-btn">🏠 回到首页</a>
                        </div>
                    </div>

                    <div id="errorMessage" class="error-message-large" style="display: none;">
                        <p id="errorText"></p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 样式合并与优化 */
    .main-content { background: var(--bg-color); min-height: 100vh; }
    .form-container-large {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: clamp(1.5rem, 4vw, 3rem);
        backdrop-filter: blur(10px);
        max-width: 800px;
        margin: 0 auto;
    }
    .form-group-large { margin-bottom: 2rem; }
    textarea {
        width: 100%; min-height: 200px; padding: 1rem;
        border: 2px solid var(--card-border); border-radius: 12px;
        background: var(--bg-color); color: var(--text-main); font-family: inherit;
    }
    .options-row {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem; margin-bottom: 2rem;
    }
    .submit-btn-large {
        width: 100%; padding: 1rem; border-radius: 12px; border: none;
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: white; font-weight: 700; cursor: pointer; transition: all 0.3s;
    }
    .submit-btn-large:disabled { opacity: 0.5; cursor: not-allowed; }
    .token-box { background: var(--bg-color); padding: 1.5rem; border-radius: 8px; margin: 1rem 0; border-left: 4px solid #22c55e; }
    code { display: block; padding: 1rem; background: #f4f4f4; border-radius: 4px; margin: 0.5rem 0; word-break: break-all; }
    .success-actions { margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .action-link-btn { padding: 0.75rem 1.5rem; background: #1d1d1f; color: white; border-radius: 8px; text-decoration: none; }
    
    @media (prefers-color-scheme: dark) {
        .submit-btn-large { background: linear-gradient(135deg, #f5f5f7 0%, #d1d1d6 100%); color: #1d1d1f; }
        code { background: #2d2d2d; color: #efefef; }
    }
</style>

<script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('messageForm');
        const contentField = document.getElementById('content');
        const charCount = document.getElementById('charCount');
        const replyMethodField = document.getElementById('reply_method');
        const emailGroup = document.getElementById('emailGroup');
        const emailField = document.getElementById('email');
        const submitBtn = document.getElementById('submitBtn');
        const successMsg = document.getElementById('successMessage');
        const errorMsg = document.getElementById('errorMessage');
        const tokenDisplay = document.getElementById('tokenDisplay');
        const tokenValue = document.getElementById('tokenValue');
        const copyBtn = document.getElementById('copyBtn');

        // 1. 字数统计
        contentField.addEventListener('input', () => {
            const len = contentField.value.length;
            charCount.textContent = `${len}/2000`;
            charCount.style.color = len > 1800 ? '#ef4444' : 'var(--text-muted)';
        });

        // 2. 回复方式切换
        replyMethodField.addEventListener('change', () => {
            const isEmail = replyMethodField.value === 'email';
            emailGroup.style.display = isEmail ? 'block' : 'none';
            emailField.required = isEmail;
        });

        // 3. 提交逻辑 (唯一监听)
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn.disabled) return;

            const content = contentField.value.trim();
            const is_public = document.getElementById('is_public').checked ? 1 : 0;
            const reply_method = replyMethodField.value;
            const email = emailField.value.trim();

            // 基础验证
            if (!content) return alert('请填写内容');
            if (reply_method === 'email' && !email) return alert('请填写邮箱');

            // 锁定按钮
            submitBtn.disabled = true;
            submitBtn.textContent = '⌛ SENDING...';
            errorMsg.style.display = 'none';

            try {
                const response = await fetch('/api/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content, is_public, reply_method, email })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    form.style.display = 'none';
                    successMsg.style.display = 'block';
                    if (!is_public && data.token) {
                        tokenValue.textContent = data.token;
                        tokenDisplay.style.display = 'block';
                    }
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    throw new Error(data.error || 'Server Error');
                }
            } catch (err) {
                document.getElementById('errorText').textContent = err.message;
                errorMsg.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = '📤 SEND';
            }
        });

        // 4. 复制功能
        copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(tokenValue.textContent);
            alert('✅ Token 已复制');
        });
    });
</script>