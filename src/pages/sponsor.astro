---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import wechatQR from '../tipwechat/b.jpg';
---

<Layout title="Sponsor - Crepuscular's Villa">
  <Header />
  <main class="container sponsor-page">
    <section class="reveal active">
      <h1>Support My Work If You Like To</h1>
      <h2>因为有你们对Crepus-Villa的支持，Cyril得以用更优质的资源投入创作。<br/>Thanks to your support of Crepus-Villa, Cyril is able to dedicate higher-quality resources to his creative work.</h2>
      <p class="section-desc">仅需 2 USD (14 CNY)，即可成为 Villa Member，享受 Villa 专属内容。</p>

      <div class="sponsor-stack">
        <!-- Alipay Card -->
        <a href="https://qr.alipay.com/fkx14778gmv86oc2fjnar31" class="option-card wide-card">
          <div class="card-info">
            <h3>Alipay</h3>
            <p class="description">跳转至支付宝进行赞助</p>
          </div>
          <div class="action-area">
            <span class="description">Press to Pay</span>
          </div>
        </a>

        <!-- Wechat Card -->
        <div class="wechat-container wide-card">
          <div class="wechat-content-wrapper">
            <div class="card-info">
              <h3>Wechat Pay</h3>
              <p class="description">使用微信扫描二维码赞助</p>
            </div>
            <div class="qr-wrapper">
              <img src={wechatQR.src} alt="Wechat QR" class="wechat-image-large" />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div id="copy-toast" class="toast"> 地址已成功复制 </div>
</Layout>

<style>
  /* 基础页面样式 */
  .sponsor-page { 
    padding-top: 100px; 
    padding-bottom: 80px; 
    text-align: center; 
    margin: 0 auto; 
    padding-left: var(--safe-area, 20px); 
    padding-right: var(--safe-area, 20px); 
    max-width: 1000px; 
  }
  h1 { font-size: 44px; font-weight: 800; margin-bottom: 20px; }
  h2 { font-size: 1.2rem; margin-bottom: 15px; line-height: 1.6; opacity: 0.9; }
  .section-desc { font-size: 1.1rem; opacity: 0.7; max-width: 700px; margin: 0 auto 50px; }

  /* 垂直堆叠布局 */
  .sponsor-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding: 0 20px;
  }

  /* 长方形大卡片 */
  .wide-card {
    background: var(--card-bg, #ffffff);
    color: var(--card-text, #1d1d1f);
    
    /* 宽度：屏幕宽度减去保留边距 */
    width: calc(100vw - 80px);
    max-width: 1000px;
    
    /* 增加高度与内边距 */
    min-height: 180px;
    padding: 40px 60px;
    
    border-radius: 32px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    border: 1px solid rgba(128, 128, 128, 0.1);
    
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    box-sizing: border-box;
  }

  /* 信息区块 */
  .card-info {
    text-align: left;
  }
  .card-info h3 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 10px 0;
  }
  .card-info .description {
    font-size: 1.1rem;
    opacity: 0.6;
    margin: 0;
  }

  /* 支付宝按钮区域 */
  .action-btn {
    background: #0071e3;
    color: white;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .wide-card:hover .action-btn {
    background: #0077ed;
  }

  /* 微信二维码显示 */
  .wechat-content-wrapper {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }
  .qr-wrapper {
    background: #ffffff;
    padding: 12px;
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  .wechat-image-large {
    width: 160px; /* 显著加大二维码 */
    height: 160px;
    display: block;
    object-fit: contain;
  }

  /* 悬停动效 */
  .wide-card:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
  }

  /* 深色模式 */
  @media (prefers-color-scheme: dark) {
    :root {
      --card-bg: #1c1c1e;
      --card-text: #f5f5f7;
    }
    .wide-card {
      box-shadow: 0 10px 40px rgba(0,0,0,0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    /* 即使在深色模式下，二维码背景也建议保持浅色以便扫描 */
    .qr-wrapper {
      background: #f5f5f7;
    }
  }

  /* 响应式适配 */
  @media (max-width: 768px) {
    .wide-card {
      width: calc(100vw - 40px);
      padding: 30px;
      min-height: auto;
    }
    .card-info h3 { font-size: 1.5rem; }
  }

  @media (max-width: 550px) {
    .wechat-content-wrapper {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
    .card-info { text-align: center; }
    .wide-card { flex-direction: column; gap: 20px; }
  }

  /* Toast 样式 */
  .toast {
    position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(100px);
    background: rgba(0, 0, 0, 0.85); color: white; padding: 14px 28px; border-radius: 30px;
    font-size: 1rem; transition: transform 0.3s ease-out; z-index: 1000;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
</style>