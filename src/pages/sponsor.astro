---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import wechatQR from '../tipwechat/b.jpg';
---

<Layout title="Sponsor - Crepuscular's Villa">
  <Header />
  <main class="container sponsor-page">
    <section class="reveal active">
      <h1>Support My Work If You Like To</h1>
      <h2>因为有你们对Crepus-Villa的支持，Cyril得以用更优质的资源投入创作。<br/>Thanks to your support of Crepus-Villa, Cyril is able to dedicate higher-quality resources to his creative work.</h2>
      <p class="section-desc">仅需2 USD (14 CNY)，即可成为Villa Member，享受Villa专属内容。<br/>Become a Villa Member for only 2 USD (320 JPY / 3000 KRW / 1.8 EUR) and enjoy exclusive Villa content.</p>
      <div class="sponsor-grid">
        <a href="https://qr.alipay.com/fkx14778gmv86oc2fjnar31" class="option-card">
          <h3>Alipay</h3>
          <!-- <p class="description">跳转支付宝支付</p> -->
        </a>

        <div class="option-card copy-card" data-address="0x6a9036be6bc85f50d73c8536f8cacf7a16f5e7ff">
          <h3>BNB / ETH / OKB</h3>
          <code class="address">0x6a90...e7ff</code>
          <!-- <p class="tip">点击复制地址</p> -->
        </div>

        <div class="option-card copy-card" data-address="bc1pcpn5ggzrtd47wqjvrrlz74nzdzdpusur7yq8tgzz3fe4ay0tm80srx67ex">
          <h3>BTC</h3>
          <code class="address">bc1pcp...67ex</code>
          <!-- <p class="tip">点击复制地址</p> -->
        </div>
      </div>

      <div class="wechat-solo">
        <div class="wechat-container">
          <h3>Wechat</h3>
          <img src={wechatQR.src} alt="Wechat QR" class="wechat-image" />
        </div>
      </div>
    </section>
  </main>

  <div id="copy-toast" class="toast"> 地址已成功复制 </div>
</Layout>

<style>
  /* 基础页面样式 */
  .sponsor-page { padding-top: 100px; text-align: center; padding-bottom: 80px; }
  h1 { font-size: 44px; font-weight: 800; margin-bottom: 20px; }
  h2 { font-size: 1.3rem; margin-bottom: 15px; }
  .section-desc { font-size: 1rem; opacity: 0.8; max-width: 600px; margin: 0 auto 50px; }

  /* 网格布局：强制正方形并支持自适应 */
  .sponsor-grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
    gap: 25px;
    max-width: 1100px;
    margin: 0 auto 40px;
    padding: 0 20px;
  }

  /* 卡片基础样式：适配深浅模式 */
  .option-card, .wechat-container {
    background: var(--card-bg, #ffffff);
    color: var(--card-text, #1d1d1f);
    aspect-ratio: 1 / 1; 
    padding: 30px;
    border-radius: 28px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    border: 1px solid rgba(128, 128, 128, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }

  /* 深色模式适配逻辑 (假设你使用 prefers-color-scheme 或类名) */
  @media (prefers-color-scheme: dark) {
    :root {
      --card-bg: #1c1c1e;
      --card-text: #f5f5f7;
      --code-bg: #2c2c2e;
    }
    .option-card, .wechat-container {
      box-shadow: 0 10px 40px rgba(0,0,0,0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  .option-card:hover { transform: translateY(-8px); box-shadow: 0 15px 50px rgba(0,0,0,0.15); }
  .copy-card { cursor: pointer; }

  /* 标题居中与大小 */
  h3 { font-size: 1.4rem; font-weight: 700; margin: 0 0 10px 0; text-align: center; width: 100%; }
  .description { font-size: 1rem; opacity: 0.7; margin: 0; }

  /* 代码块适配 */
  .address {
    background: var(--code-bg, #f5f5f7);
    padding: 10px 15px;
    border-radius: 10px;
    font-family: 'SF Mono', monospace;
    font-size: 0.95rem;
    margin: 15px 0;
    word-break: break-all;
  }

  .tip { font-size: 0.9rem; color: #0071e3; font-weight: 500; }

  /* 微信部分 */
  .wechat-solo { display: flex; justify-content: center; padding: 0 20px; }
  .wechat-container { aspect-ratio: auto; max-width: 350px; width: 100%; height: auto; padding: 40px; }
  .wechat-image { width: 180px; height: auto; margin-top: 20px; border-radius: 12px; }

  /* 弹窗样式 */
  .toast {
    position: fixed; bottom: 40px; left: 50%; transform: translateX(-50%) translateY(100px);
    background: rgba(0, 0, 0, 0.85); color: white; padding: 14px 28px; border-radius: 30px;
    font-size: 1rem; transition: transform 0.3s ease-out; z-index: 1000;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  @media (max-width: 480px) {
    .option-card { aspect-ratio: auto; padding: 40px 20px; }
  }
</style>

<script>
  const copyCards = document.querySelectorAll('.copy-card');
  const toast = document.getElementById('copy-toast');

  copyCards.forEach(card => {
    card.addEventListener('click', async () => {
      const address = card.getAttribute('data-address');
      if (address) {
        try {
          await navigator.clipboard.writeText(address);
          toast?.classList.add('show');
          setTimeout(() => toast?.classList.remove('show'), 2000);
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      }
    });
  });
</script>