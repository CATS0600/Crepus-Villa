---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="KEMDR - 香野放送局">
    <Header />

    <main class="main-content">
        <section class="kemdr-hero safe-zone">
            <h1 class="kemdr-title">KEMDR</h1>
            <p class="kemdr-subtitle">Kouno Earthquake Migration and Disaster Reduction Bureau · 香野放送局</p>
        </section>

        <section class="kemdr-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 KEMDR</h2>
                <div class="section-content">
                    <p class="section-text">
                        KEMDR，即 Kouno Earthquake Migration and Disaster Reduction Bureau，香野放送局，是一个专注地震观测和相关知识的 QQ 群。
                    </p>
                    <p class="section-text">
                        气氛随意，讨论不一定正经。对地震或地质活动感兴趣的都欢迎来，还可以学英语。
                    </p>
                </div>
            </div>
        </section>

        <section class="kemdr-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">加入须知</h2>
                <div class="section-content">
                    <ul class="requirements-list">
                        <li>
                            <span class="req-icon">🧠</span>
                            <div class="req-text-group">
                                <span class="req-text">一个脑子（最好能正常运转）。</span>
                                <span class="req-subtext">——我们不接受"笨傻蠢"中符合后两位之一的成员。少问多听为宜</span>
                            </div>
                        </li>
                        <li>
                            <span class="req-icon">🌍</span>
                            <span class="req-text">对地震或地球科学的兴趣。</span>
                        </li>
                        <li>
                            <span class="req-icon">🤝</span>
                            <span class="req-text">互相尊重的态度。</span>
                        </li>
                        <li>
                            <span class="req-icon">💬</span>
                            <span class="req-text">QQ 账号（你需要一个账号用于加群）。</span>
                        </li>
                        <li>
                            <span class="req-icon">🗣️</span>
                            <span class="req-text">愿意交流——中英文皆可。</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <div class="safe-zone">
            <div class="cta-container">
                <a href="/application/kemdr" class="action-button">
                    <span class="action-text">申请加入</span>
                </a>
            </div>
        </div>
    </main>
</Layout>

<style>
    .main-content {
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
    }

    .kemdr-hero {
        text-align: center;
        margin-bottom: 80px;
    }

    .kemdr-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .kemdr-subtitle {
        font-size: 1.1rem;
        color: #86868b;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .kemdr-title {
            color: #f5f5f7;
        }

        .kemdr-subtitle {
            color: #a1a1a6;
        }
    }

    .kemdr-section {
        margin-bottom: 60px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
    }

    @media (prefers-color-scheme: dark) {
        .kemdr-section {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }
    }

    .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin-bottom: 30px;
        letter-spacing: -0.01em;
    }

    @media (prefers-color-scheme: dark) {
        .section-title {
            color: #f5f5f7;
        }
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-text {
        font-size: 1rem;
        line-height: 1.8;
        color: #424245;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .section-text {
            color: #e0e0e2;
        }
    }

    .requirements-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .requirements-list li {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 10px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .requirements-list li:hover {
        transform: translateX(4px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    }

    @media (prefers-color-scheme: dark) {
        .requirements-list li {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .requirements-list li:hover {
            box-shadow: 0 4px 16px rgba(255, 255, 255, 0.06);
        }
    }

    .req-icon {
        font-size: 1.8rem;
        flex-shrink: 0;
        line-height: 1;
    }

    .req-text-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .req-text {
        font-size: 1rem;
        color: #424245;
        line-height: 1.5;
    }

    .req-subtext {
        font-size: 0.8rem;
        color: #a1a1a6;
        line-height: 1.4;
    }

    @media (prefers-color-scheme: dark) {
        .req-text {
            color: #e0e0e2;
        }

        .req-subtext {
            color: #6e6e73;
        }
    }

    .cta-container {
        display: flex;
        justify-content: center;
        padding: 20px 0;
    }

    .action-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px 64px;
        height: clamp(56px, 12vw, 90px);
        background: linear-gradient(135deg, #fff 0%, #f5f5f7 100%);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        color: #1d1d1f;
        border: 2px solid rgba(0,0,0,0.05);
        cursor: pointer;
        font-size: inherit;
        font-family: inherit;
        position: relative;
        overflow: hidden;
    }

    .action-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(247, 196, 108, 0.2), rgba(247, 196, 108, 0));
        transition: left 0.3s ease;
    }

    .action-button:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 16px 40px rgba(0,0,0,0.12);
        border-color: rgba(0,0,0,0.1);
    }
    .action-button:hover::before {
        left: 100%;
    }

    .action-button:hover {
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: #fff;
    }

    .action-icon {
        font-size: clamp(20px, 2vw, 28px);
        font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        z-index: 1;
    }
    .action-button:hover .action-icon {
        transform: scale(1.2) rotate(8deg);
    }

    .action-text {
        font-size: clamp(14px, 1.5vw, 18px);
        font-weight: 600;
        transition: color 0.3s ease;
        position: relative;
        z-index: 1;
    }

    @media (prefers-color-scheme: dark) {
        .action-button {
            background: linear-gradient(135deg, #1d1d1f 0%, #2a2a2c 100%);
            color: #f5f5f7;
            border-color: rgba(255,255,255,0.1);
        }
        .action-button:hover {
            background: linear-gradient(135deg, #f5f5f7 0%, #d1d1d6 100%);
            color: #1d1d1f;
        }
    }

    @media (max-width: 768px) {
        .kemdr-title {
            font-size: 2.5rem;
        }

        .kemdr-subtitle {
            font-size: 1rem;
        }

        .kemdr-section {
            padding: 40px 24px;
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.5rem;
        }
    }

    .reveal {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
    }

    .scroll-reveal.visible {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    import { initAboutPage } from '../../lib/about.js';
    initAboutPage();
</script>
