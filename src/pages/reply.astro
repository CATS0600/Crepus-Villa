---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="interests-grid">
                    <div class="loading-state" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-title {
        text-align: center; 
        margin-bottom: 3rem;
        font-weight: 700;
        color: #1d1d1f;
        font-size: 2.5rem;
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
    }

    .interest-item {
        padding: 24px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        border: 1.5px solid rgba(0, 0, 0, 0.1); 
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        align-items: center; 
        text-align: center;
        opacity: 0;
        animation: fadeInUp 0.6s ease forwards;
        backdrop-filter: blur(12px);
    }

    .interest-item:hover {
        transform: translateY(-5px);
        border-color: rgba(0, 0, 0, 0.3);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        width: 100%;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .interest-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .interest-date {
        font-size: 0.75rem;
        color: #86868b;
        font-family: monospace;
    }

    .interest-desc {
        font-size: 1rem;
        color: #424245; 
        line-height: 1.6;
        margin: 12px 0 20px 0;
        white-space: pre-wrap;
        width: 100%;
    }

    .reply-box {
        margin-top: auto;
        padding: 12px 16px;
        background: rgba(0, 0, 0, 0.03);
        border-top: 3px solid #1d1d1f;
        border-radius: 4px;
        width: 100%;
        box-sizing: border-box;
    }

    .reply-text {
        font-size: 0.95rem;
        color: #1d1d1f;
        margin: 0;
    }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .nav-links { display: flex; gap: 1rem; justify-content: center; margin-top: 4rem; }
    .nav-link { 
        padding: 10px 20px; 
        background: #fff;
        border: 1.5px solid rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        text-decoration: none;
        color: #1d1d1f;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    .nav-link:hover { border-color: #1d1d1f; transform: translateY(-1px); }

    @media (prefers-color-scheme: dark) {
        .page-title { color: #f5f5f7; }
        .interest-item { background: rgba(44, 44, 46, 0.8); border-color: rgba(255, 255, 255, 0.15); }
        .interest-item:hover { border-color: rgba(255, 255, 255, 0.4); }
        .interest-title { color: #f5f5f7; }
        .interest-desc { color: #e0e0e2; }
        .reply-box { background: rgba(255, 255, 255, 0.05); border-top-color: #f5f5f7; }
        .reply-text { color: #f5f5f7; }
        .nav-link { background: #1d1d1f; color: #f5f5f7; border-color: rgba(255, 255, 255, 0.1); }
    }
</style>

<script>
    const formatter = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Fetch failed');
            const data = await response.json();
            const visibleMessages = data.messages || [];

            if (visibleMessages.length === 0) {
                container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #86868b; padding: 3rem;">No public messages available.</p>`;
                return;
            }

            container.innerHTML = visibleMessages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                return `
                <div class="interest-item" style="animation-delay: ${index * 0.05}s">
                    <div class="card-header">
                        <h3 class="interest-title" style="font-weight: 700;">${escapeHtml(msg.title || 'Untitled')}</h3>
                        <span class="interest-date">${date}</span>
                    </div>
                    <p class="interest-desc">${escapeHtml(msg.content)}</p>
                    ${msg.reply ? `
                    <div class="reply-box">
                        <p class="reply-text"><strong>Reply:<br/></strong> ${escapeHtml(msg.reply)}</p>
                    </div>` : ''}
                </div>`;
            }).join('');
        } catch (error) {
            container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #ff6b6b;">Failed to load messages.</p>`;
        }
    }
    document.addEventListener('astro:page-load', loadMessages);
</script>