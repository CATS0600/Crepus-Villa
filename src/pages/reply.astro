---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="interests-grid">
                    <div class="loading-state" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 页面基础 */
    .page-title {
        text-align: center; 
        margin-bottom: 3rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #1d1d1f;
        font-size: 2.5rem;
    }

    /* 借用 About 页面的 Grid 布局 */
    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
    }

    /* --- 核心：完全对齐 About My Card 样式 --- */
    .interest-item {
        padding: 24px;
        /* 使用 About 页面的背景色与透明度 */
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        /* 强化边框可见度，确保在浅色背景下也有轮廓 */
        border: 1px solid rgba(0, 0, 0, 0.1); 
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        opacity: 0;
        animation: fadeInUp 0.6s ease forwards;
        backdrop-filter: blur(10px);
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-color: rgba(0, 0, 0, 0.15); /* 悬浮时边框略微加深 */
    }

    /* 卡片内部排版 */
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .interest-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
        line-height: 1.3;
    }

    .interest-date {
        font-size: 0.75rem;
        color: #86868b;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #424245; 
        line-height: 1.6;
        margin-bottom: 20px;
        white-space: pre-wrap;
    }

    /* 回复区样式 */
    .reply-box {
        margin-top: auto;
        padding: 12px 16px;
        background: rgba(0, 0, 0, 0.03);
        border-left: 3px solid #1d1d1f;
        border-radius: 4px;
    }

    .reply-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #86868b;
        font-weight: 700;
        margin-bottom: 4px;
        display: block;
    }

    .reply-text {
        font-size: 0.9rem;
        color: #1d1d1f;
        margin: 0;
    }

    /* 动画与响应式 */
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .nav-links { display: flex; gap: 1rem; justify-content: center; margin-top: 4rem; }
    .nav-link { 
        padding: 10px 20px; 
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        text-decoration: none;
        color: #424245;
        font-size: 0.85rem;
        transition: all 0.2s;
    }
    .nav-link:hover { background: #fff; transform: translateY(-1px); }

    /* 深色模式修正 */
    @media (prefers-color-scheme: dark) {
        .page-title { color: #f5f5f7; }
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.15);
        }
        .interest-item:hover { border-color: rgba(255, 255, 255, 0.25); }
        .interest-title { color: #f5f5f7; }
        .interest-desc { color: #e0e0e2; }
        .reply-box { background: rgba(255, 255, 255, 0.05); border-left-color: #f5f5f7; }
        .reply-text { color: #f5f5f7; }
        .nav-link { 
            background: rgba(44, 44, 46, 0.5); 
            border-color: rgba(255, 255, 255, 0.1); 
            color: #f5f5f7; 
        }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('en-GB', {
        day: '2-digit', month: 'short', year: 'numeric'
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Fetch failed');
            const data = await response.json();

            // 核心修改：通过 filter 过滤掉状态为 PENDING 的留言
            const publicMessages = (data.messages || []).filter(msg => msg.status !== 'PENDING');

            if (publicMessages.length === 0) {
                container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #86868b; padding: 3rem;">No messages yet.</p>`;
                return;
            }

            container.innerHTML = publicMessages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                
                return `
                    <div class="interest-item" style="animation-delay: ${index * 0.05}s">
                        <div class="card-header">
                            <h3 class="interest-title">${escapeHtml(msg.title || 'Note')}</h3>
                            <span class="interest-date">${date}</span>
                        </div>

                        <p class="interest-desc">${escapeHtml(msg.content)}</p>

                        ${msg.reply ? `
                        <div class="reply-box">
                            <span class="reply-label">Reply</span>
                            <p class="reply-text">${escapeHtml(msg.reply)}</p>
                        </div>
                        ` : ''}
                    </div>
                `;
            }).join('');
        } catch (error) {
            container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #ff6b6b;">Failed to load messages.</p>`;
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>