---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="interests-grid">
                    <div class="loading-state" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-title {
        text-align: center; 
        margin-bottom: 3rem;
        font-weight: 700;
        color: #1d1d1f;
        font-size: 2.5rem;
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
    }

    /* --- 显著边框版本 --- */
    .interest-item {
        padding: 24px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 12px;
        /* 增加边框可见度：使用更明显的灰色，并稍微加粗 */
        border: 2px solid rgba(128, 128, 128, 0.2); 
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        opacity: 0;
        animation: fadeInUp 0.6s ease forwards;
        backdrop-filter: blur(12px);
    }

    .interest-item:hover {
        transform: translateY(-5px);
        /* 悬浮时边框变为深色 */
        border-color: rgba(29, 29, 31, 0.3);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .interest-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    /* Type 标签样式 */
    .type-badge {
        font-size: 0.7rem;
        background: #1d1d1f;
        color: #fff;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
        margin-bottom: 4px;
        display: inline-block;
        width: fit-content;
    }

    .interest-date {
        font-size: 0.75rem;
        color: #86868b;
        font-family: monospace;
    }

    .interest-desc {
        font-size: 1rem;
        color: #424245; 
        line-height: 1.6;
        margin: 12px 0 20px 0;
        white-space: pre-wrap;
    }

    .reply-box {
        margin-top: auto;
        padding: 12px 16px;
        background: rgba(0, 0, 0, 0.05);
        border-left: 4px solid #1d1d1f;
        border-radius: 4px;
    }

    .reply-text {
        font-size: 0.95rem;
        color: #1d1d1f;
        margin: 0;
    }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .nav-links { display: flex; gap: 1rem; justify-content: center; margin-top: 4rem; }
    .nav-link { 
        padding: 10px 20px; 
        background: #fff;
        border: 2px solid rgba(128, 128, 128, 0.2);
        border-radius: 8px;
        text-decoration: none;
        color: #1d1d1f;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    .nav-link:hover { border-color: #1d1d1f; transform: translateY(-1px); }

    /* 深色模式强化边框 */
    @media (prefers-color-scheme: dark) {
        .page-title { color: #f5f5f7; }
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.2); /* 深色模式下边框颜色稍亮 */
        }
        .interest-item:hover { border-color: rgba(255, 255, 255, 0.5); }
        .interest-title { color: #f5f5f7; }
        .interest-desc { color: #e0e0e2; }
        .type-badge { background: #f5f5f7; color: #000; }
        .reply-box { background: rgba(255, 255, 255, 0.08); border-left-color: #f5f5f7; }
        .reply-text { color: #f5f5f7; }
        .nav-link { background: #1d1d1f; color: #f5f5f7; border-color: rgba(255, 255, 255, 0.1); }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('en-GB', {
        day: '2-digit', month: 'short', year: 'numeric'
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Fetch failed');
            const data = await response.json();

            // 1. 只有 status 为 PENDING 的被隐藏
            const visibleMessages = (data.messages || []).filter(msg => msg.status !== 'PENDING');

            if (visibleMessages.length === 0) {
                container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #86868b; padding: 3rem;">No public messages available.</p>`;
                return;
            }

            container.innerHTML = visibleMessages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                
                return `
                    <div class="interest-item" style="animation-delay: ${index * 0.05}s">
                        <div class="card-header">
                            <div>
                                <span class="type-badge">${escapeHtml(msg.type || 'PUBLIC')}</span>
                                <h3 class="interest-title">${escapeHtml(msg.title || 'Note')}</h3>
                            </div>
                            <span class="interest-date">${date}</span>
                        </div>

                        <p class="interest-desc">${escapeHtml(msg.content)}</p>

                        ${msg.reply ? `
                        <div class="reply-box">
                            <p class="reply-text"><strong>Reply:</strong> ${escapeHtml(msg.reply)}</p>
                        </div>
                        ` : ''}
                    </div>
                `;
            }).join('');
        } catch (error) {
            container.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: #ff6b6b;">Failed to load messages.</p>`;
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>