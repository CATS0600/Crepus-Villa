---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="message-list">
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    .page-title { text-align: center; margin-bottom: 2.5rem; font-weight: 300; letter-spacing: 1px; }
    .message-list { display: flex; flex-direction: column; gap: 1rem; min-height: 200px; }

    .msg-item { width: 100%; opacity: 0; animation: slideUp 0.5s ease forwards; }

    /* 按钮基础样式 */
    .msg-btn {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-bg, #fff);
        border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 12px;
        padding: 1.2rem 1.5rem;
        cursor: pointer;
        text-align: left;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        position: relative;
        z-index: 5; /* 确保层级高于 wrapper */
    }

    .msg-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }
    
    /* 激活状态：强制去除圆角和阴影 */
    .msg-item.open .msg-btn,
    .msg-btn.active {
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        border-bottom-color: transparent !important;
        transform: none !important;
        box-shadow: none !important;
    }

    .btn-left { flex: 1; padding-right: 1rem; }
    .btn-title { font-size: 1.1rem; font-weight: 700; color: var(--text-main); word-break: break-all; }
    .btn-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; min-width: 120px; }
    .status-badge { font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; background: var(--text-main); color: var(--bg-color, #fff); text-transform: uppercase; }
    .msg-time { font-size: 0.8rem; color: var(--text-muted); font-family: monospace; }

    /* 折叠面板核心逻辑 */
    .msg-detail-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s;
        background: rgba(0,0,0,0.02);
        border: 1px solid transparent;
        border-top: none;
        border-radius: 0 0 12px 12px;
        margin-top: -1px; /* 向上移动 1px 覆盖按钮底边 */
        overflow: hidden;
    }

    /* 展开状态 */
    .msg-item.open .msg-detail-wrapper {
        grid-template-rows: 1fr;
        border-color: var(--card-border, rgba(0,0,0,0.1));
    }

    .msg-detail-inner { min-height: 0; }
    .detail-content { padding: 1.5rem; }
    .content-block { margin-bottom: 1.5rem; }
    .block-label { display: inline-block; font-size: 0.75rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem; }
    .block-text { font-size: 1rem; line-height: 1.6; color: var(--text-main); white-space: pre-wrap; }
    .reply-block { padding-left: 1rem; border-left: 3px solid var(--text-main); }
    .pending-block { padding: 1rem; background: rgba(0,0,0,0.03); border-radius: 8px; color: var(--text-muted); text-align: center; border: 1px dashed rgba(0,0,0,0.1); }

    .detail-meta { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(0,0,0,0.05); }

    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .nav-links { display: flex; gap: 0.8rem; justify-content: center; margin-top: 3rem; }
    .nav-link { padding: 0.6rem 1.2rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 8px; text-decoration: none; color: var(--text-main); font-size: 0.9rem; }

    @media (prefers-color-scheme: dark) {
        .msg-btn, .nav-link { background: #1c1c1e; border-color: rgba(255,255,255,0.05); }
        .msg-detail-wrapper, .pending-block { background: rgba(255,255,255,0.02); }
        .msg-item.open .msg-detail-wrapper { border-color: rgba(255,255,255,0.1); }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false
    });

    window.toggleMsg = function(id) {
        const targetItem = document.getElementById(`msg-item-${id}`);
        const isAlreadyOpen = targetItem.classList.contains('open');

        // 关闭所有已打开的项
        document.querySelectorAll('.msg-item.open').forEach(el => {
            el.classList.remove('open');
            el.querySelector('.msg-btn').classList.remove('active');
        });

        // 如果点击的原本不是打开状态，则打开它
        if (!isAlreadyOpen) {
            targetItem.classList.add('open');
            targetItem.querySelector('.msg-btn').classList.add('active');
        }
    };

    async function loadMessages() {
        const container = document.getElementById('messageList');
        try {
            const response = await fetch('/api/get-messages');
            const data = await response.json();
            if (!data.messages?.length) {
                container.innerHTML = `<p style="text-align:center; padding:3rem; color:var(--text-muted)">暂无留言</p>`;
                return;
            }

            container.innerHTML = data.messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                return `
                    <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${index * 0.05}s">
                        <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                            <div class="btn-left">
                                <div class="btn-title">${msg.title || 'Untitled'}</div>
                            </div>
                            <div class="btn-right">
                                <span class="status-badge">${msg.type || 'PUBLIC'}</span>
                                <span class="msg-time">${date}</span>
                            </div>
                        </button>
                        <div class="msg-detail-wrapper">
                            <div class="msg-detail-inner">
                                <div class="detail-content">
                                    <div class="content-block"><span class="block-label">Message</span><div class="block-text">${msg.content}</div></div>
                                    ${msg.reply ? `<div class="content-block reply-block"><span class="block-label">Admin Reply</span><div class="block-text">${msg.reply}</div></div>` : `<div class="pending-block">暂无回复</div>`}
                                    <div class="detail-meta"><span>ID: ${msg.id}</span><span>${date}</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) { container.innerHTML = `<p style="color:red;text-align:center">加载失败</p>`; }
    }
    document.addEventListener('DOMContentLoaded', loadMessages);
</script>