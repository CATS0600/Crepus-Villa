---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="message-list">
                    </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 容器布局 */
    .message-list { display: flex; flex-direction: column; gap: 1.2rem; }
    .msg-item { width: 100%; opacity: 0; animation: slideUp 0.5s ease forwards; }

    /* 核心按钮样式：彻底覆盖 HTML 默认样式 */
    .msg-btn {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        
        /* 视觉设计：对标 Index 的卡片感 */
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 12px;
        padding: 1.2rem 1.5rem;
        
        /* 交互 */
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
        font-family: inherit;
        color: var(--text-main);
        position: relative;
        z-index: 10;
    }

    .msg-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border-color: var(--text-main);
    }

    /* 展开时的按钮形态变化 */
    .msg-item.open .msg-btn {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom-color: transparent;
        box-shadow: none;
        transform: none;
    }

    /* 内部元素 */
    .btn-title { font-size: 1.1rem; font-weight: 600; }
    .btn-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }
    .status-badge { font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; background: var(--text-main); color: var(--bg-color); }
    .msg-time { font-size: 0.8rem; color: var(--text-muted); font-family: monospace; }

    /* 折叠面板内容区 */
    .msg-detail-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-top: none;
        border-radius: 0 0 12px 12px;
        margin-top: -1px;
        overflow: hidden;
    }

    .msg-item.open .msg-detail-wrapper {
        grid-template-rows: 1fr;
    }

    .detail-content { padding: 1.5rem; min-height: 0; }
    .block-text { white-space: pre-wrap; line-height: 1.6; }
    .reply-block { margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--card-border); color: var(--text-main); }

    @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* 暗色模式适配 */
    @media (prefers-color-scheme: dark) {
        .msg-btn { background: #1c1c1e; border-color: rgba(255,255,255,0.1); }
        .msg-detail-wrapper { background: #1c1c1e; border-color: rgba(255,255,255,0.1); }
    }
</style>

<script>
    //@ts-nocheck
    // 逻辑保持不变，确保渲染出来的 HTML 结构与 CSS 匹配
    window.toggleMsg = function(id) {
        const item = document.getElementById(`msg-item-${id}`);
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.msg-item.open').forEach(el => el.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    };

    async function loadMessages() {
        const container = document.getElementById('messageList');
        try {
            const res = await fetch('/api/get-messages');
            const data = await res.json();
            container.innerHTML = data.messages.map((msg, i) => `
                <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${i*0.05}s">
                    <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                        <div class="btn-title">${msg.title || 'Untitled'}</div>
                        <div class="btn-right">
                            <span class="status-badge">${msg.type}</span>
                            <span class="msg-time">${new Date(msg.created_at).toLocaleDateString()}</span>
                        </div>
                    </button>
                    <div class="msg-detail-wrapper">
                        <div class="msg-detail-inner">
                            <div class="detail-content">
                                <div class="block-text">${msg.content}</div>
                                ${msg.reply ? `<div class="reply-block"><strong>ADMIN:</strong> ${msg.reply}</div>` : ''}
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        } catch (e) { container.innerHTML = 'Load Failed'; }
    }
    document.addEventListener('DOMContentLoaded', loadMessages);
</script>