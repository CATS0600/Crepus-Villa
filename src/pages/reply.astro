---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 700px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="message-list">
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">✍️ 写新留言 Write New Message</a>
                    <a href="/reply/private" class="nav-link">🔐 查看私密留言 View Private</a>
                    <a href="/" class="nav-link">🏠 回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 页面基础 */
    .page-title {
        text-align: center; 
        margin-bottom: 2.5rem;
        font-weight: 300;
        letter-spacing: 1px;
    }

    .message-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        min-height: 200px;
    }

    /* 留言卡片动画 */
    .message-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        opacity: 0; /* 初始透明，由 JS 控制动画 */
        animation: slideUp 0.6s ease forwards;
    }

    .message-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .message-content {
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 1.2rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* 回复区块及其特有动画 */
    .reply-section {
        background: rgba(var(--text-main-rgb, 0,0,0), 0.03);
        border-left: 3px solid var(--text-main);
        padding: 1.2rem;
        border-radius: 6px;
        margin-top: 1rem;
        position: relative;
        overflow: hidden;
        animation: expandReply 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reply-label {
        font-weight: 700;
        font-size: 0.8rem;
        color: var(--text-main);
        margin-bottom: 0.6rem;
        opacity: 0.7;
    }

    /* Meta 信息 */
    .message-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--card-border-rgb, 0,0,0), 0.1);
    }

    /* 动画定义 */
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes expandReply {
        from { opacity: 0; transform: translateX(-10px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .fade-in {
        animation: fadeIn 1s ease forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* 导航样式 */
    .nav-links {
        display: flex;
        gap: 0.8rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 3rem;
    }

    .nav-link {
        padding: 0.6rem 1.2rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 8px;
        text-decoration: none;
        color: var(--text-main);
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        background: var(--text-main);
        color: var(--bg-color);
    }

    .nav-link.primary {
        background: var(--text-main);
        color: var(--bg-color);
    }

    .loading-state {
        text-align: center;
        padding: 2rem;
        color: var(--text-muted);
    }
</style>

<script>
    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false
    });

    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Network response was not ok');
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                container.innerHTML = `
                    <div class="empty-state fade-in" style="text-align: center; padding: 4rem 0;">
                        <span style="font-size: 3rem;">📭</span>
                        <p style="margin-top: 1rem; color: var(--text-muted);">还没有公开留言呢... No Messages Yet</p>
                    </div>`;
                return;
            }

            // 使用 DocumentFragment 减少重排
            const fragment = document.createDocumentFragment();
            
            data.messages.forEach((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                const card = document.createElement('div');
                card.className = 'message-card';
                // 设置交错动画延迟
                card.style.animationDelay = `${index * 0.1}s`;
                
                card.innerHTML = `
                    <div class="message-content">${escapeHtml(msg.content)}</div>
                    ${msg.reply ? `
                        <div class="reply-section">
                            <div class="reply-label">REPLY / 回复</div>
                            <div class="reply-text">${escapeHtml(msg.reply)}</div>
                        </div>
                    ` : ''}
                    <div class="message-meta">
                        <span>#${msg.id}</span>
                        <span>${date}</span>
                    </div>
                `;
                fragment.appendChild(card);
            });

            container.innerHTML = '';
            container.appendChild(fragment);

        } catch (error) {
            container.innerHTML = `
                <div class="error-state" style="text-align: center; color: #ff6b6b; padding: 2rem;">
                    <p>⚠️ 无法加载留言板，请稍后再试</p>
                </div>`;
            console.error('Fetch error:', error);
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>