---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="message-list">
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>等待数据加载中...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 基础页面布局 */
    .page-title {
        text-align: center; 
        margin-bottom: 2.5rem;
        font-weight: 300;
        letter-spacing: 1px;
    }

    .message-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 200px;
    }

    .loading-state {
        text-align: center;
        padding: 3rem 0;
        color: var(--text-muted);
    }

    .spinner {
        width: 30px;
        height: 30px;
        border: 2px solid rgba(0,0,0,0.1);
        border-top-color: var(--text-main);
        border-radius: 50%;
        margin: 0 auto 1rem;
        animation: spin 1s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* 留言项外层 */
    .msg-item {
        width: 100%;
        opacity: 0;
        animation: slideUp 0.5s ease forwards;
        margin-bottom: 0.5rem;
    }

    /* 留言美化按钮 */
    .msg-btn {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-bg, #ffffff);
        border: 1px solid var(--card-border, rgba(0, 0, 0, 0.08));
        border-radius: 16px;
        padding: 1.4rem 1.8rem;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .msg-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08);
        border-color: var(--text-main, #333);
    }

    /* 信息图标样式 */
    .info-icon {
        width: 18px;
        height: 18px;
        color: var(--text-main);
        flex-shrink: 0;
    }

    .btn-left { 
        display: flex; 
        align-items: center; 
        gap: 12px; 
        flex: 1; 
        padding-right: 1rem; 
    }
    
    .btn-title { 
        font-size: 1.1rem; 
        font-weight: 600; 
        color: var(--text-main); 
        word-break: break-all;
    }

    .btn-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; min-width: 120px; }

    .status-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        background: var(--text-main, #000);
        color: var(--bg-color, #fff);
    }

    .msg-time { font-size: 0.75rem; color: var(--text-muted); font-family: monospace; }

    /* 详情容器 */
    .msg-detail-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        background: var(--card-bg, #fff);
        border-radius: 0 0 16px 16px;
        overflow: hidden;
    }

    .msg-item.open .msg-detail-wrapper { grid-template-rows: 1fr; }

    .detail-content { padding: 1.8rem; }
    .block-label { display: block; font-size: 0.7rem; font-weight: 800; color: var(--text-muted); margin-bottom: 0.6rem; }
    .block-text { font-size: 1rem; line-height: 1.7; white-space: pre-wrap; }

    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .fade-in { animation: fadeIn 1s ease forwards; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .nav-links { display: flex; gap: 0.8rem; justify-content: center; margin-top: 3rem; }
    .nav-link { padding: 0.6rem 1.2rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 8px; text-decoration: none; color: var(--text-main); font-size: 0.9rem; }

    @media (prefers-color-scheme: dark) {
        .msg-btn { background: #1c1c1e; border-color: rgba(255,255,255,0.1); }
        .status-badge { background: #f5f5f7; color: #000; }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    window.toggleMsg = function(id) {
        const item = document.getElementById(`msg-item-${id}`);
        if (!item) return;
        document.querySelectorAll('.msg-item.open').forEach(el => {
            if (el.id !== `msg-item-${id}`) el.classList.remove('open');
        });
        item.classList.toggle('open');
    };

    // 2. 从云端获取数据并渲染
    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Network error');
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                container.innerHTML = `<div class="fade-in" style="text-align: center; padding: 4rem 0; color: var(--text-muted);">暂无公开留言数据</div>`;
                return;
            }

            // 4. 全部加载并渲染
            container.innerHTML = data.messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                
                return `
                    <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${index * 0.05}s">
                        <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                            <div class="btn-left">
                                <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <div class="btn-title">${escapeHtml(msg.title || 'Untitled')}</div>
                            </div>
                            <div class="btn-right">
                                <span class="status-badge">${msg.type || 'PUBLIC'}</span>
                                <span class="msg-time">${date}</span>
                            </div>
                        </button>
                        <div class="msg-detail-wrapper">
                            <div class="detail-content">
                                <div class="content-block">
                                    <span class="block-label">Message</span>
                                    <div class="block-text">${escapeHtml(msg.content)}</div>
                                </div>
                                ${msg.reply ? `
                                <div class="content-block reply-block">
                                    <span class="block-label">Admin Reply</span>
                                    <div class="block-text">${escapeHtml(msg.reply)}</div>
                                </div>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (error) {
            container.innerHTML = `<div style="text-align: center; color: #ff6b6b; padding: 2rem;">加载失败，请检查网络。</div>`;
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>