---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="message-list">
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 基础样式变量兜底 */
    :root {
        --text-main: #2c3e50;
        --text-muted: #7f8c8d;
        --card-bg: #ffffff;
        --card-border: rgba(0,0,0,0.08);
        --accent: #34495e;
    }

    .page-title {
        text-align: center; 
        margin-bottom: 2.5rem;
        font-weight: 300;
        letter-spacing: 1px;
        color: var(--text-main);
    }

    /* 消息列表容器 */
    .message-list {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        min-height: 200px;
    }

    .msg-item {
        width: 100%;
        opacity: 0;
        animation: slideUp 0.5s ease forwards;
    }

    /* 美化后的按钮 */
    .msg-btn {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 1.2rem 1.5rem;
        cursor: pointer;
        text-align: left;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        position: relative;
        z-index: 2;
    }

    .msg-btn:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }

    /* 状态同步：展开时的视觉修正 */
    .msg-btn.active {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        background: var(--card-bg);
        box-shadow: none;
    }

    /* 动态箭头 */
    .msg-btn::after {
        content: '→';
        font-family: serif;
        font-size: 1.1rem;
        margin-left: 1rem;
        opacity: 0.3;
        transition: transform 0.4s;
    }

    .msg-item.open .msg-btn::after {
        transform: rotate(90deg);
        opacity: 0.8;
    }

    .btn-left { flex: 1; padding-right: 1rem; }
    .btn-title { 
        font-size: 1.1rem; 
        font-weight: 600; 
        color: var(--text-main); 
        word-break: break-all;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .btn-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; min-width: 110px; }

    .status-badge {
        font-size: 0.65rem;
        font-weight: 800;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: var(--accent);
        color: #fff;
    }

    .msg-time { font-size: 0.75rem; color: var(--text-muted); font-family: ui-monospace, monospace; }

    /* 详情展示区域 */
    .msg-detail-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        background: rgba(0,0,0,0.01);
        border: 1px solid transparent;
        border-top: none;
        border-radius: 0 0 12px 12px;
        margin-top: -1px;
        overflow: hidden;
    }

    .msg-item.open .msg-detail-wrapper {
        grid-template-rows: 1fr;
        border-color: var(--card-border);
        background: var(--card-bg);
        box-shadow: 0 10px 20px rgba(0,0,0,0.02);
    }

    .detail-content { padding: 1.5rem; }
    .content-block { margin-bottom: 1.5rem; }
    .block-label { display: inline-block; font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.6rem; letter-spacing: 1px; }
    .block-text { font-size: 1rem; line-height: 1.7; color: var(--text-main); white-space: pre-wrap; word-break: break-word; }
    
    .reply-block { 
        padding-left: 1.2rem; 
        border-left: 2px solid var(--accent); 
        background: rgba(0,0,0,0.01);
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .pending-block { padding: 1.2rem; background: rgba(0,0,0,0.02); border-radius: 8px; color: var(--text-muted); text-align: center; font-size: 0.85rem; border: 1px dashed var(--card-border); }

    /* 底部导航 */
    .nav-links { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 4rem; }
    .nav-link { 
        padding: 0.7rem 1.5rem; 
        background: var(--card-bg); 
        border: 1px solid var(--card-border); 
        border-radius: 50px; 
        text-decoration: none; 
        color: var(--text-main); 
        font-size: 0.85rem; 
        transition: all 0.3s; 
    }
    
    .nav-link:hover { 
        background: var(--accent); 
        color: #fff; 
        transform: translateY(-2px);
    }

    /* 加载动画 */
    .spinner {
        width: 24px; height: 24px;
        border: 2px solid var(--card-border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 1rem;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .fade-in { animation: fadeIn 0.8s ease forwards; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @media (prefers-color-scheme: dark) {
        :root {
            --text-main: #e1e1e6;
            --text-muted: #8e8e93;
            --card-bg: #1c1c1e;
            --card-border: rgba(255,255,255,0.1);
            --accent: #f5f5f7;
        }
        .msg-detail-wrapper { background: rgba(255,255,255,0.02); }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false
    });

    let currentOpenId = null;

    window.toggleMsg = function(id) {
        const item = document.getElementById(`msg-item-${id}`);
        const btn = item.querySelector('.msg-btn');
        
        // 排他性展开逻辑：仅操作变化的部分，优化性能
        if (currentOpenId && currentOpenId !== id) {
            const prevItem = document.getElementById(`msg-item-${currentOpenId}`);
            if (prevItem) {
                prevItem.classList.remove('open');
                prevItem.querySelector('.msg-btn').classList.remove('active');
            }
        }

        const isOpen = item.classList.toggle('open');
        btn.classList.toggle('active', isOpen);
        currentOpenId = isOpen ? id : null;
    };

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Network error');
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                container.innerHTML = `<div class="fade-in" style="text-align: center; padding: 4rem 0; color: var(--text-muted);">暂无公开留言数据</div>`;
                return;
            }

            container.innerHTML = data.messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                const type = msg.type || 'PUBLIC';
                
                return `
                    <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${index * 0.05}s">
                        <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                            <div class="btn-left">
                                <div class="btn-title">${escapeHtml(msg.title || 'Untitled')}</div>
                            </div>
                            <div class="btn-right">
                                <span class="status-badge">${type}</span>
                                <span class="msg-time">${date}</span>
                            </div>
                        </button>
                        <div class="msg-detail-wrapper">
                            <div class="msg-detail-inner">
                                <div class="detail-content">
                                    <div class="content-block">
                                        <span class="block-label">Message</span>
                                        <div class="block-text">${escapeHtml(msg.content)}</div>
                                    </div>
                                    ${msg.reply ? `
                                    <div class="content-block reply-block">
                                        <span class="block-label">Admin Reply</span>
                                        <div class="block-text">${escapeHtml(msg.reply)}</div>
                                    </div>
                                    ` : `<div class="pending-block">暂无公开回复</div>`}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (error) {
            container.innerHTML = `<div style="text-align: center; color: #ff6b6b; padding: 2rem;">加载失败，请检查网络。</div>`;
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>