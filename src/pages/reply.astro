---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="公开留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">公开留言板 Public Message Board</h1>
                
                <div id="messageList" class="interests-grid">
                    <div class="loading-state" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                        <p>Loading...</p>
                    </div>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/send" class="nav-link">写新留言 Write New</a>
                    <a href="/reply/private" class="nav-link">查看私密 View Private</a>
                    <a href="/" class="nav-link">回到首页 Return</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 基础页面布局 */
    .page-title {
        text-align: center; 
        margin-bottom: 3rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #1d1d1f;
        font-size: 2rem;
    }

    /* 借用 About 页面的 Grid 布局 */
    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
        min-height: 200px;
    }

    /* 借用 About 页面的 interest-item 样式 */
    .interest-item {
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
        opacity: 0;
        animation: fadeInUp 0.5s ease forwards;
        backdrop-filter: blur(10px);
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    /* 头部排版 */
    .interest-title-container {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding-bottom: 16px;
    }

    .interest-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
        word-break: break-word;
        line-height: 1.4;
    }

    .interest-meta {
        text-align: right;
        min-width: 85px;
    }

    .interest-badge {
        font-size: 0.65rem;
        background: #1d1d1f;
        color: #fff;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .interest-date {
        font-size: 0.75rem;
        color: #86868b;
        margin-top: 8px;
        font-family: monospace;
    }

    /* 正文区排版 */
    .interest-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #86868b;
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #424245; 
        line-height: 1.7;
        margin: 0 0 20px 0;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* 回复区排版 */
    .reply-box {
        padding: 16px;
        background: rgba(0,0,0,0.03);
        border-left: 3px solid #1d1d1f;
        border-radius: 4px 8px 8px 4px;
        margin-top: auto; /* 保证底部对齐 */
    }

    .reply-text {
        font-size: 0.95rem;
        color: #1d1d1f;
        line-height: 1.7;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
    }

    .no-reply {
        font-size: 0.85rem;
        color: #86868b;
        font-style: italic;
        text-align: center;
        padding: 16px;
        border: 1px dashed rgba(0,0,0,0.1);
        border-radius: 8px;
        margin-top: auto; /* 保证底部对齐 */
    }

    /* 动画与导航底栏 */
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .fade-in { animation: fadeIn 1s ease forwards; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .nav-links { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 4rem; }
    .nav-link { 
        padding: 0.8rem 1.5rem; 
        background: rgba(251, 251, 253, 0.8); 
        border: 1px solid rgba(0,0,0,0.05); 
        border-radius: 8px; 
        text-decoration: none; 
        color: #1d1d1f; 
        font-size: 0.9rem; 
        font-weight: 500;
        transition: all 0.3s ease; 
    }
    .nav-link:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); 
    }

    /* 深色模式修正 */
    @media (prefers-color-scheme: dark) {
        .page-title { color: #f5f5f7; }
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
        }
        .interest-item:hover { box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1); }
        .interest-title-container { border-bottom-color: rgba(255, 255, 255, 0.1); }
        
        .interest-title, .reply-text { color: #f5f5f7; }
        .interest-desc { color: #e0e0e2; }
        .interest-label, .interest-date { color: #a1a1a6; }
        
        .interest-badge { background: #f5f5f7; color: #000; }
        
        .reply-box {
            background: rgba(255, 255, 255, 0.05);
            border-left-color: #f5f5f7;
        }
        .no-reply { 
            border-color: rgba(255, 255, 255, 0.15); 
            color: #a1a1a6; 
        }
        
        .nav-link { 
            background: rgba(44, 44, 46, 0.8); 
            border-color: rgba(255, 255, 255, 0.1); 
            color: #f5f5f7; 
        }
    }

    @media (max-width: 768px) {
        .interests-grid { grid-template-columns: 1fr; }
        .page-title { font-size: 1.6rem; }
    }
</style>

<script>
    // @ts-nocheck
    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function loadMessages() {
        const container = document.getElementById('messageList');
        if (!container) return;
        
        try {
            const response = await fetch('/api/get-messages');
            if (!response.ok) throw new Error('Network error');
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                container.innerHTML = `<div class="fade-in" style="grid-column: 1 / -1; text-align: center; padding: 4rem 0; color: #86868b;">暂无公开留言数据</div>`;
                return;
            }

            container.innerHTML = data.messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                const type = msg.type || 'PUBLIC';
                
                return `
                    <div class="interest-item" style="animation-delay: ${index * 0.1}s">
                        <div class="interest-title-container">
                            <h3 class="interest-title">${escapeHtml(msg.title || 'Untitled')}</h3>
                            <div class="interest-meta">
                                <span class="interest-badge">${type}</span>
                                <div class="interest-date">${date}</div>
                            </div>
                        </div>

                        <span class="interest-label">Message</span>
                        <div class="interest-desc">${escapeHtml(msg.content)}</div>

                        ${msg.reply ? `
                        <div class="reply-box">
                            <span class="interest-label">Admin Reply</span>
                            <div class="reply-text">${escapeHtml(msg.reply)}</div>
                        </div>
                        ` : `
                        <div class="no-reply">尚未收到公开回复</div>
                        `}
                    </div>
                `;
            }).join('');
        } catch (error) {
            container.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: #ff6b6b; padding: 2rem;">加载失败，请检查网络。</div>`;
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>