---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="申请管理后台 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto;">
                <h1 style="text-align: center; margin-bottom: 2rem;">📋 申请管理后台</h1>
                
                <!-- 密码输入 -->
                <div id="passwordPanel" class="auth-panel" style="display: none;">
                    <div style="text-align: center; padding: 2rem;">
                        <p style="font-size: 1.1rem; margin-bottom: 1rem;">🔐 管理员密码</p>
                        <input 
                            type="password" 
                            id="adminPassword" 
                            placeholder="输入管理员密码"
                            style="width: 100%; max-width: 300px; padding: 0.75rem; border: 1px solid var(--card-border); border-radius: 8px; font-size: 1rem;"
                        />
                        <button id="loginBtn" onclick="authenticate()" style="display: block; margin-top: 1rem; padding: 0.75rem 2rem; background: var(--text-main); color: var(--bg-color); border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                            登录
                        </button>
                    </div>
                </div>

                <!-- 应用列表 -->
                <div id="applicationsPanel" style="display: none;">
                    <div style="margin-bottom: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                        <select id="groupFilter" onchange="filterByGroup()" style="padding: 0.75rem; border: 1px solid var(--card-border); border-radius: 8px;">
                            <option value="">所有群组</option>
                            <option value="dpmbg">DPMBG</option>
                        </select>
                        <button onclick="loadApplications()" style="padding: 0.75rem 1.5rem; background: var(--text-main); color: var(--bg-color); border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                            🔄 刷新
                        </button>
                    </div>

                    <div id="adminPanel" class="admin-panel">
                        <div style="text-align: center; padding: 2rem;">
                            <p>加载中...</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .main-content {
        background: var(--bg-color);
        min-height: 100vh;
    }

    .auth-panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .admin-panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .application-item {
        padding: 2rem;
        border-bottom: 1px solid var(--card-border);
        transition: background 0.2s;
    }

    .application-item:hover {
        background: var(--bg-color);
    }

    .application-item:last-child {
        border-bottom: none;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .app-info {
        flex: 1;
        min-width: 0;
    }

    .app-id {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }

    .app-status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-right: 0.5rem;
        margin-top: 0.5rem;
    }

    .status-pending {
        background: rgba(249, 115, 22, 0.2);
        color: #f97316;
    }

    .status-approved {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .app-username {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-main);
        margin-bottom: 0.5rem;
    }

    .app-social {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        word-break: break-all;
    }

    .app-time {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .app-content {
        background: var(--bg-color);
        padding: 1rem;
        border-radius: 6px;
        margin: 1rem 0;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .app-reply-info {
        font-size: 0.9rem;
        margin: 0.5rem 0;
        padding: 0.5rem;
        background: rgba(100, 200, 255, 0.1);
        border-left: 3px solid #3b82f6;
        border-radius: 4px;
    }

    .app-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-approve {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
        border: 1px solid #22c55e;
    }

    .btn-approve:hover {
        background: #22c55e;
        color: white;
    }

    .btn-reject {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
        border: 1px solid #ef4444;
    }

    .btn-reject:hover {
        background: #ef4444;
        color: white;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .reply-section {
        margin-top: 1rem;
    }

    .reply-textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        background: var(--bg-color);
        color: var(--text-main);
        resize: vertical;
        min-height: 100px;
    }

    .reply-textarea:focus {
        outline: none;
        border-color: var(--text-main);
    }

    @media (max-width: 768px) {
        .app-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<script>
    let adminPassword = null;
    const passwordPanel = document.getElementById('passwordPanel');
    const applicationsPanel = document.getElementById('applicationsPanel');
    const adminPasswordInput = document.getElementById('adminPassword');

    // 检查是否已登录（从 sessionStorage）
    const savedPassword = sessionStorage.getItem('adminPassword');
    if (savedPassword) {
        adminPassword = savedPassword;
        showApplications();
    } else {
        passwordPanel.style.display = 'block';
    }

    function authenticate() {
        const password = adminPasswordInput.value;
        if (!password) {
            alert('请输入密码');
            return;
        }
        adminPassword = password;
        sessionStorage.setItem('adminPassword', password);
        passwordPanel.style.display = 'none';
        showApplications();
    }

    function showApplications() {
        applicationsPanel.style.display = 'block';
        loadApplications();
    }

    async function loadApplications() {
        const group = document.getElementById('groupFilter').value || 'dpmbg';
        const adminPanel = document.getElementById('adminPanel');

        try {
            const response = await fetch(`/api/exam/admin?group=${encodeURIComponent(group)}`, {
                headers: {
                    'X-Admin-Password': adminPassword
                }
            });

            if (response.status === 401) {
                alert('❌ 密码错误');
                sessionStorage.removeItem('adminPassword');
                location.reload();
                return;
            }

            const data = await response.json();

            if (data.applications.length === 0) {
                adminPanel.innerHTML = `
                    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                        <p>📭 暂无申请</p>
                    </div>
                `;
                return;
            }

            adminPanel.innerHTML = data.applications.map(app => {
                const date = new Date(app.created_at);
                const formattedDate = date.toLocaleString('zh-CN');
                const statusText = app.status === 'approved' ? '✓ 已批准' : app.status === 'rejected' ? '✗ 已拒绝' : '⏳ 待审核';
                const statusClass = `status-${app.status}`;

                return `
                    <div class="application-item">
                        <div class="app-header">
                            <div class="app-info">
                                <div class="app-id">ID: ${app.id}</div>
                                <div class="app-username">${escapeHtml(app.username)}</div>
                                <div class="app-social">📱 ${escapeHtml(app.social_id)}</div>
                                <div class="app-time">${formattedDate}</div>
                            </div>
                            <span class="app-status ${statusClass}">${statusText}</span>
                        </div>

                        <div class="app-content">${escapeHtml(app.answers)}</div>

                        ${app.reply_method === 'email' && app.email ? `
                            <div class="app-reply-info">
                                📧 回复方式：邮件通知 | 邮箱：${escapeHtml(app.email)}
                            </div>
                        ` : `
                            <div class="app-reply-info">
                                🌐 回复方式：网页查看
                            </div>
                        `}

                        <div class="app-actions">
                            ${app.status !== 'approved' ? `<button class="btn btn-approve" onclick="updateStatus(${app.id}, 'approved')">✓ 批准</button>` : ''}
                            ${app.status !== 'rejected' ? `<button class="btn btn-reject" onclick="updateStatus(${app.id}, 'rejected')">✗ 拒绝</button>` : ''}
                            ${app.status !== 'pending' ? `<button class="btn btn-reject" onclick="updateStatus(${app.id}, 'pending')">⏳ 设为待审</button>` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        } catch (error) {
            adminPanel.innerHTML = '<p style="color: red; padding: 2rem; text-align: center;">加载失败，请检查网络</p>';
            console.error(error);
        }
    }

    async function updateStatus(id, newStatus) {
        try {
            const response = await fetch('/api/exam/admin', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Admin-Password': adminPassword
                },
                body: JSON.stringify({ id, status: newStatus })
            });

            const data = await response.json();

            if (data.success) {
                alert(`✅ ${data.message}`);
                loadApplications();
            } else {
                alert(`❌ ${data.error}`);
            }
        } catch (error) {
            alert('❌ 更新失败');
            console.error(error);
        }
    }

    function filterByGroup() {
        loadApplications();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // 防止直接访问
    adminPasswordInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            authenticate();
        }
    });
</script>
