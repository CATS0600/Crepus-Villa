---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="查看私密留言 - Crepuscular's Villa" narrative={{ chapter: "ENDURE", quote: "Stories converge here." }}>
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
                <h1 class="page-title">私密查询 Private Query</h1>
                
                <div class="search-container" style="text-align: center; margin-bottom: 3rem;">
                    <input 
                        type="text" 
                        id="tokenInput" 
                        placeholder="ENTER YOUR TOKEN" 
                        class="token-input"
                    />
                    <button id="searchBtn" class="search-btn">查询 Query</button>
                </div>

                <div id="messageList" class="interests-grid">
                    <p style="grid-column: 1/-1; text-align: center; color: #86868b;">请输入 Token 以查看您的留言内容。</p>
                </div>

                <nav class="nav-links fade-in">
                    <a href="/reply" class="nav-link">公开留言板 Public</a>
                    <a href="/" class="nav-link">回到首页 Home</a>
                </nav>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 复用 reply 的核心样式 */
    .page-title { text-align: center; margin-bottom: 2rem; font-weight: 700; color: #1d1d1f; font-size: 2.5rem; }
    
    /* 修正 Token 输入框字体与样式 */
    .token-input {
        padding: 12px 20px;
        border-radius: 8px;
        border: 1.5px solid rgba(0, 0, 0, 0.1);
        font-size: 1rem;
        width: 300px;
        max-width: 100%;
        /* 强制使用与页面相同的 Apple 字体家族 */
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        outline: none;
        transition: border-color 0.2s;
    }
    .token-input:focus { border-color: #1d1d1f; }
    
    .search-btn {
        padding: 12px 24px;
        background: #1d1d1f;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        margin-left: 10px;
        transition: opacity 0.2s;
    }
    .search-btn:hover { opacity: 0.8; }

    .interests-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }

    /* 居中卡片样式 */
    .interest-item {
        padding: 24px; background: rgba(255, 255, 255, 0.7); border-radius: 12px;
        border: 1.5px solid rgba(0, 0, 0, 0.1); box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
        display: flex; flex-direction: column; align-items: center; text-align: center;
        animation: fadeInUp 0.6s ease forwards; backdrop-filter: blur(12px);
    }

    .card-header { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
    .interest-title { font-size: 1.15rem; font-weight: 600; color: #1d1d1f; }
    .type-badge { font-size: 0.7rem; background: #1d1d1f; color: #fff; padding: 2px 8px; border-radius: 4px; }
    .interest-date { font-size: 0.75rem; color: #86868b; font-family: monospace; }
    .interest-desc { font-size: 1rem; color: #424245; line-height: 1.6; margin: 12px 0 20px 0; white-space: pre-wrap; width: 100%; }
    .reply-box { margin-top: auto; padding: 12px 16px; background: rgba(0, 0, 0, 0.03); border-top: 3px solid #1d1d1f; border-radius: 4px; width: 100%; box-sizing: border-box; }
    .reply-text { font-size: 0.95rem; color: #1d1d1f; margin: 0; }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .nav-links { display: flex; gap: 1rem; justify-content: center; margin-top: 4rem; }
    .nav-link { padding: 10px 20px; background: #fff; border: 1.5px solid rgba(0, 0, 0, 0.1); border-radius: 8px; text-decoration: none; color: #1d1d1f; font-size: 0.85rem; }

    @media (prefers-color-scheme: dark) {
        .page-title { color: #f5f5f7; }
        .token-input { background: #1d1d1f; border-color: rgba(255, 255, 255, 0.1); color: #f5f5f7; }
        .search-btn { background: #f5f5f7; color: #000; }
        .interest-item { background: rgba(44, 44, 46, 0.8); border-color: rgba(255, 255, 255, 0.15); }
        .interest-title, .reply-text { color: #f5f5f7; }
        .interest-desc { color: #e0e0e2; }
        .type-badge { background: #f5f5f7; color: #000; }
        .reply-box { border-top-color: #f5f5f7; }
        .nav-link { background: #1d1d1f; color: #f5f5f7; border-color: rgba(255, 255, 255, 0.1); }
    }
</style>

<script>
    const formatter = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    async function searchPrivate() {
        const token = document.getElementById('tokenInput').value.trim();
        const container = document.getElementById('messageList');
        if (!token) return;

        container.innerHTML = '<p style="grid-column: 1/-1; text-align: center;">Searching...</p>';

        try {
            const response = await fetch(`/api/get-messages?token=${encodeURIComponent(token)}`);
            const data = await response.json();
            const messages = data.messages || [];

            if (messages.length === 0) {
                container.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #86868b;">未找到相关留言。请检查 Token 是否正确。</p>';
                return;
            }

            container.innerHTML = messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                return `
                <div class="interest-item" style="animation-delay: ${index * 0.05}s">
                    <div class="card-header">
                        <span class="type-badge">${escapeHtml(msg.type || 'PRIVATE')}</span>
                        <h3 class="interest-title">${escapeHtml(msg.title || 'Untitled')}</h3>
                        <span class="interest-date">${date}</span>
                    </div>
                    <p class="interest-desc">${escapeHtml(msg.content)}</p>
                    ${msg.reply ? `
                    <div class="reply-box">
                        <p class="reply-text"><strong>Reply:<br/></strong> ${escapeHtml(msg.reply)}</p>
                    </div>` : `
                    <div class="reply-box" style="border-top-color: #86868b; opacity: 0.6;">
                        <p class="reply-text">Waiting for reply...</p>
                    </div>`}
                </div>`;
            }).join('');
        } catch (error) {
            container.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #ff6b6b;">查询出错，请稍后再试。</p>';
        }
    }

    document.getElementById('searchBtn').addEventListener('click', searchPrivate);
    document.getElementById('tokenInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') searchPrivate();
    });
</script>