---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="私密留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 style="text-align: center; margin-bottom: 2rem; font-weight: 300; letter-spacing: 1px;">私密留言 Private Messages</h1>
                
                <div id="tokenInputForm" class="form-container">
                    <p style="text-align: center; color: var(--text-muted); margin-bottom: 1.5rem;">输入 8 位 Token 检索您的留言及回复状态</p>
                    <form id="tokenForm">
                        <div class="form-group">
                            <input type="text" id="token" name="token" required placeholder="ENTER TOKEN" maxlength="8" autocomplete="off" />
                        </div>
                        <button type="submit" class="submit-btn">EXECUTE SEARCH</button>
                    </form>
                    <div id="errorMessage" class="error-message" style="display: none;"><p id="errorText"></p></div>
                </div>

                <div id="messageDisplay" style="display: none;">
                    <div id="messageList" class="message-list"></div>
                    <div class="nav-links">
                        <button type="button" onclick="location.reload()" class="nav-link">查询其他 Token</button>
                        <a href="/send" class="nav-link">写新留言</a>
                        <a href="/reply" class="nav-link">返回广场</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .form-container {
        max-width: 500px; margin: 0 auto;
        background: var(--card-bg, #fff); border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 12px; padding: 2.5rem;
    }
    
    .form-group { margin-bottom: 1.5rem; }
    
    input[type="text"] {
        width: 100%; padding: 1rem; border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 8px; font-family: monospace; font-size: 1.2rem; text-align: center;
        background: var(--bg-color, #f5f5f7); color: var(--text-main);
        text-transform: uppercase; letter-spacing: 4px; transition: 0.2s; outline: none;
    }
    input[type="text"]:focus { border-color: var(--text-main); }

    .submit-btn {
        width: 100%; padding: 1rem; background: var(--text-main); color: var(--bg-color, #fff);
        border: none; border-radius: 8px; font-weight: 700; cursor: pointer; letter-spacing: 1px;
    }

    .error-message {
        margin-top: 1.5rem; padding: 1rem; background: rgba(239, 68, 68, 0.1);
        border-radius: 8px; color: #ff453a; text-align: center; font-size: 0.9rem;
    }

    /* 继承自公开版的折叠样式 */
    .message-list { display: flex; flex-direction: column; gap: 1rem; }
    .msg-item { width: 100%; opacity: 0; animation: slideUp 0.5s ease forwards; }
    .msg-btn {
        width: 100%; display: flex; justify-content: space-between; align-items: center;
        background: var(--card-bg, #fff); border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 12px; padding: 1.2rem 1.5rem; cursor: pointer; text-align: left;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); z-index: 2; position: relative;
    }
    .msg-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
    .msg-btn.active { border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-bottom-color: transparent; transform: none; box-shadow: none; }
    
    .btn-left { flex: 1; padding-right: 1rem; }
    .btn-title { font-size: 1.1rem; font-weight: 700; color: var(--text-main); word-break: break-all; }
    .btn-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; min-width: 120px; }
    .status-badge { font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; letter-spacing: 0.5px; text-transform: uppercase; background: var(--text-main); color: var(--bg-color, #fff); }
    .msg-time { font-size: 0.8rem; color: var(--text-muted); font-family: monospace; }

    .msg-detail-wrapper {
        display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        background: rgba(0,0,0,0.02); border: 1px solid transparent; border-top: none; border-radius: 0 0 12px 12px; margin-top: -1px;
    }
    .msg-item.open .msg-detail-wrapper { grid-template-rows: 1fr; border-color: var(--card-border, rgba(0,0,0,0.1)); }
    .msg-detail-inner { overflow: hidden; }
    .detail-content { padding: 1.5rem; }
    .content-block { margin-bottom: 1.5rem; }
    .content-block:last-child { margin-bottom: 0; }
    .block-label { display: inline-block; font-size: 0.75rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 1px; }
    .block-text { font-size: 1rem; line-height: 1.6; color: var(--text-main); white-space: pre-wrap; word-break: break-word; }
    .reply-block { padding-left: 1rem; border-left: 3px solid var(--text-main); }
    .pending-block { padding: 1rem; background: rgba(0,0,0,0.03); border-radius: 8px; color: var(--text-muted); text-align: center; font-size: 0.9rem; border: 1px dashed rgba(0,0,0,0.1); }
    .detail-meta { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(0,0,0,0.05); font-family: monospace; }

    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .nav-links { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 3rem; }
    .nav-link { padding: 0.6rem 1.2rem; background: transparent; border: 1px solid var(--card-border); border-radius: 8px; text-decoration: none; color: var(--text-main); font-size: 0.9rem; cursor: pointer; }
    
    @media (prefers-color-scheme: dark) {
        .form-container, .msg-btn { background: #1c1c1e; border-color: rgba(255,255,255,0.05); }
        input[type="text"] { background: #000; border-color: rgba(255,255,255,0.1); color: #fff; }
        .msg-detail-wrapper, .pending-block { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05); }
        .msg-item.open .msg-detail-wrapper { border-color: rgba(255,255,255,0.05); }
        .status-badge { background: #f5f5f7; color: #000; }
        .block-label { color: rgba(255,255,255,0.5); }
        .detail-meta { border-top-color: rgba(255,255,255,0.05); }
        .nav-link { border-color: rgba(255,255,255,0.1); }
    }
</style>

<script>
    // @ts-nocheck
    const tokenForm = document.getElementById('tokenForm');
    const tokenInput = document.getElementById('token');
    const errorMsg = document.getElementById('errorMessage');
    const tokenInputForm = document.getElementById('tokenInputForm');
    const messageDisplay = document.getElementById('messageDisplay');
    const messageList = document.getElementById('messageList');

    const formatter = new Intl.DateTimeFormat('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false
    });

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    window.toggleMsg = function(id) {
        const item = document.getElementById(`msg-item-${id}`);
        const btn = item.querySelector('.msg-btn');
        item.classList.toggle('open');
        btn.classList.toggle('active');
    };

    tokenForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = tokenInput.value.trim().toUpperCase();

        if (token.length !== 8) {
            showError('Token 验证失败：长度必须为 8 位');
            return;
        }

        try {
            const response = await fetch(`/api/get-messages?token=${encodeURIComponent(token)}`);
            if (!response.ok) throw new Error('Query failed');
            
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                showError('查询不到对应数据，请核对 Token 是否输入正确。');
                return;
            }

            messageList.innerHTML = data.messages.map((msg, index) => {
                const date = formatter.format(new Date(msg.created_at));
                const title = msg.title || 'Untitled';
                const type = msg.type || 'UNKNOWN';
                
                // 根据 Type 决定回复区域的显示逻辑
                let replyAreaHtml = '';
                if (type === 'PENDING') {
                    replyAreaHtml = `<div class="pending-block">尚未回复 (Awaiting Admin Reply)</div>`;
                } else if (msg.reply) {
                    replyAreaHtml = `
                        <div class="content-block reply-block">
                            <span class="block-label">Replied</span>
                            <div class="block-text">${escapeHtml(msg.reply)}</div>
                        </div>`;
                } else {
                    replyAreaHtml = `<div class="pending-block">无需回复或记录已完结</div>`;
                }

                return `
                    <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${index * 0.05}s">
                        <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                            <div class="btn-left">
                                <div class="btn-title">${escapeHtml(title)}</div>
                            </div>
                            <div class="btn-right">
                                <span class="status-badge">${type}</span>
                                <span class="msg-time">${date}</span>
                            </div>
                        </button>
                        
                        <div class="msg-detail-wrapper">
                            <div class="msg-detail-inner">
                                <div class="detail-content">
                                    <div class="content-block">
                                        <span class="block-label">Sent Content</span>
                                        <div class="block-text">${escapeHtml(msg.content)}</div>
                                    </div>
                                    
                                    ${replyAreaHtml}
                                    
                                    <div class="detail-meta">
                                        <span>MSG_ID #${msg.id}</span>
                                        <span>${date}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            tokenInputForm.style.display = 'none';
            messageDisplay.style.display = 'block';

        } catch (error) {
            showError('数据拉取失败，服务器可能暂时不可用。');
        }
    });

    function showError(message) {
        document.getElementById('errorText').textContent = message;
        errorMsg.style.display = 'block';
    }
</script>