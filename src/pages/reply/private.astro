---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="私密留言 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 600px; margin: 2rem auto; padding: 0 1rem;">
                <h1 style="text-align: center; margin-bottom: 2rem; font-weight: 300;">我的私密留言 Private Messages</h1>
                
                <div id="tokenInputForm" class="form-container">
                    <p style="text-align: center; color: var(--text-muted); margin-bottom: 1.5rem;">
                        输入你的 Token 查看私密留言及其回复
                    </p>
                    
                    <form id="tokenForm">
                        <div class="form-group">
                            <label for="token">Token (8-bit)</label>
                            <input 
                                type="text" 
                                id="token" 
                                name="token" 
                                required 
                                placeholder="ENTER TOKEN..."
                                maxlength="8"
                            />
                        </div>
                        <button type="submit" class="submit-btn">查询留言 Search</button>
                    </form>

                    <div id="errorMessage" class="error-message" style="display: none;">
                        <p id="errorText"></p>
                    </div>
                </div>

                <div id="messageDisplay" style="display: none;">
                    <div id="messageList" class="message-list"></div>
                    <div class="nav-links">
                        <button type="button" onclick="location.reload()" class="action-btn">查询其他 Token</button>
                        <a href="/send" class="action-btn">✍️ 写新留言</a>
                        <a href="/reply" class="action-btn">🏠 返回广场</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .form-container {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 2rem;
    }

    .form-group { margin-bottom: 1.5rem; }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-main);
        font-size: 0.9rem;
    }

    input[type="text"] {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        font-family: 'Courier New', monospace;
        font-size: 1.1rem;
        background: var(--bg-color);
        color: var(--text-main);
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: border-color 0.2s;
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem;
        background: var(--text-main);
        color: var(--bg-color);
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    /* 留言卡片样式 - 保持与公开版一致 */
    .message-list { display: flex; flex-direction: column; gap: 1.5rem; }
    
    .message-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .status-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        margin-bottom: 0.8rem;
        text-transform: uppercase;
    }

    .badge-sent { background: rgba(var(--text-main-rgb, 0,0,0), 0.1); color: var(--text-main); }
    .badge-replied { background: var(--text-main); color: var(--bg-color); }

    .message-content { font-size: 1.05rem; line-height: 1.7; margin-bottom: 0.5rem; white-space: pre-wrap; }

    .reply-section {
        background: rgba(var(--text-main-rgb, 0,0,0), 0.03);
        border-left: 3px solid var(--text-main);
        padding: 1.2rem;
        border-radius: 0 6px 6px 0;
        margin-top: 1.5rem;
    }

    .message-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(var(--card-border-rgb, 0,0,0), 0.1);
    }

    .nav-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2.5rem;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 0.6rem 1.2rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 8px;
        text-decoration: none;
        color: var(--text-main);
        font-size: 0.9rem;
        cursor: pointer;
    }

    .error-message {
        margin-top: 1rem;
        padding: 0.8rem;
        background: rgba(239, 68, 68, 0.1);
        border-radius: 8px;
        color: #ff6b6b;
        text-align: center;
        font-size: 0.9rem;
    }
</style>

<script>
    //@ts-nocheck
    const tokenForm = document.getElementById('tokenForm');
    const tokenInput = document.getElementById('token');
    const errorMsg = document.getElementById('errorMessage');
    const tokenInputForm = document.getElementById('tokenInputForm');
    const messageDisplay = document.getElementById('messageDisplay');
    const messageList = document.getElementById('messageList');

    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text ? text.replace(/[&<>"']/g, m => map[m]) : '';
    }

    tokenForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = tokenInput.value.trim().toUpperCase();

        if (token.length !== 8) {
            showError('Token 格式不正确');
            return;
        }

        try {
            // 注意：确保你的 API 支持通过 token 参数查询私密留言
            const response = await fetch(`/api/get-messages?token=${encodeURIComponent(token)}`);
            if (!response.ok) throw new Error('Query failed');
            
            const data = await response.json();

            if (!data.messages || data.messages.length === 0) {
                showError('未找到该 Token 对应的留言，请检查输入');
                return;
            }

            messageList.innerHTML = data.messages.map(msg => `
                <div class="message-card">
                    <div class="sent-container">
                        <span class="status-badge badge-sent">Private Sent / 私密留言</span>
                        <div class="message-content">${escapeHtml(msg.content)}</div>
                    </div>
                    
                    ${msg.reply ? `
                        <div class="reply-section">
                            <span class="status-badge badge-replied">Replied / 回复</span>
                            <div class="reply-text" style="white-space: pre-wrap;">${escapeHtml(msg.reply)}</div>
                        </div>
                    ` : `
                        <div style="margin-top: 1rem; opacity: 0.5; font-size: 0.85rem; padding-left: 0.5rem;">
                            ⏳ 正在等待管理员的回应...
                        </div>
                    `}

                    <div class="message-meta">
                        <span>ID: ${msg.id}</span>
                        <span>${new Date(msg.created_at).toLocaleString('zh-CN')}</span>
                    </div>
                </div>
            `).join('');

            tokenInputForm.style.display = 'none';
            messageDisplay.style.display = 'block';

        } catch (error) {
            showError('服务器连接失败，请稍后再试');
            console.error(error);
        }
    });

    function showError(message) {
        document.getElementById('errorText').textContent = message;
        errorMsg.style.display = 'block';
    }
</script>