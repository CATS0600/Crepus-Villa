---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="私密留言 - Crepus Villa">
    <Header />
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 800px; margin: 2rem auto; padding: 0 1rem;">
                <h1 style="text-align: center; margin-bottom: 2.5rem; font-weight: 300;">私密留言检索 Private</h1>
                
                <div id="tokenInputForm" class="form-container">
                    <form id="tokenForm">
                        <div class="form-group">
                            <input type="text" id="token" name="token" required placeholder="ENTER TOKEN" maxlength="8" autocomplete="off" />
                        </div>
                        <button type="submit" class="submit-btn">EXECUTE SEARCH</button>
                    </form>
                    <div id="errorMessage" class="error-message" style="display: none;"><p id="errorText"></p></div>
                </div>

                <div id="messageDisplay" style="display: none;">
                    <div id="messageList" class="message-list"></div>
                    <div class="nav-links">
                        <button type="button" onclick="location.reload()" class="nav-link">重置查询</button>
                        <a href="/reply" class="nav-link">返回广场</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 基础表单样式 */
    .form-container { max-width: 500px; margin: 0 auto; background: var(--card-bg, #fff); border: 1px solid var(--card-border, rgba(0,0,0,0.1)); border-radius: 12px; padding: 2.5rem; }
    input[type="text"] { width: 100%; padding: 1rem; border: 1px solid var(--card-border); border-radius: 8px; font-family: monospace; font-size: 1.2rem; text-align: center; letter-spacing: 4px; background: var(--bg-color); color: var(--text-main); outline: none; margin-bottom: 1.5rem; }
    .submit-btn { width: 100%; padding: 1rem; background: var(--text-main); color: var(--bg-color); border: none; border-radius: 8px; font-weight: 700; cursor: pointer; }
    .error-message { margin-top: 1.5rem; color: #ff453a; text-align: center; font-size: 0.9rem; }

    /* 列表核心样式 (同步优化版) */
    .message-list { display: flex; flex-direction: column; gap: 1rem; }
    .msg-item { width: 100%; opacity: 0; animation: slideUp 0.5s ease forwards; }
    .msg-btn {
        width: 100%; display: flex; justify-content: space-between; align-items: center;
        background: var(--card-bg, #fff); border: 1px solid var(--card-border, rgba(0,0,0,0.1));
        border-radius: 12px; padding: 1.2rem 1.5rem; cursor: pointer; position: relative; z-index: 5;
        transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* 状态同步：强制视觉覆盖 */
    .msg-item.open .msg-btn, .msg-btn.active {
        border-bottom-left-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        border-bottom-color: transparent !important;
        transform: none !important;
        box-shadow: none !important;
    }

    .btn-title { font-size: 1.1rem; font-weight: 700; color: var(--text-main); }
    .status-badge { font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 4px; background: var(--text-main); color: var(--bg-color); text-transform: uppercase; }

    .msg-detail-wrapper {
        display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        background: rgba(0,0,0,0.02); border: 1px solid transparent; border-top: none; border-radius: 0 0 12px 12px; margin-top: -1px; overflow: hidden;
    }
    .msg-item.open .msg-detail-wrapper { grid-template-rows: 1fr; border-color: var(--card-border, rgba(0,0,0,0.1)); }
    .msg-detail-inner { min-height: 0; }
    .detail-content { padding: 1.5rem; }
    .reply-block { padding-left: 1rem; border-left: 3px solid var(--text-main); margin-top: 1rem; }
    .pending-block { padding: 1rem; background: rgba(0,0,0,0.03); border-radius: 8px; color: var(--text-muted); text-align: center; font-size: 0.9rem; border: 1px dashed rgba(0,0,0,0.1); }

    .nav-links { display: flex; gap: 0.8rem; justify-content: center; margin-top: 3rem; }
    .nav-link { padding: 0.6rem 1.2rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 8px; text-decoration: none; color: var(--text-main); cursor: pointer; }

    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    // @ts-nocheck
    window.toggleMsg = function(id) {
        const item = document.getElementById(`msg-item-${id}`);
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.msg-item.open').forEach(el => {
            el.classList.remove('open');
            el.querySelector('.msg-btn').classList.remove('active');
        });
        if (!isOpen) {
            item.classList.add('open');
            item.querySelector('.msg-btn').classList.add('active');
        }
    };

    document.getElementById('tokenForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const token = document.getElementById('token').value.trim().toUpperCase();
        if (token.length !== 8) return;

        try {
            const res = await fetch(`/api/get-messages?token=${token}`);
            const data = await res.json();
            if (!data.messages?.length) {
                document.getElementById('errorText').innerText = "未找到记录";
                document.getElementById('errorMessage').style.display = 'block';
                return;
            }

            document.getElementById('messageList').innerHTML = data.messages.map((msg, i) => `
                <div class="msg-item" id="msg-item-${msg.id}" style="animation-delay: ${i*0.05}s">
                    <button class="msg-btn" onclick="toggleMsg('${msg.id}')">
                        <div class="btn-title">${msg.title || 'Private'}</div>
                        <span class="status-badge">${msg.type}</span>
                    </button>
                    <div class="msg-detail-wrapper">
                        <div class="msg-detail-inner">
                            <div class="detail-content">
                                <p>${msg.content}</p>
                                ${msg.reply ? `<div class="reply-block"><strong>Reply:</strong><br>${msg.reply}</div>` : `<div class="pending-block">待回复</div>`}
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            document.getElementById('tokenInputForm').style.display = 'none';
            document.getElementById('messageDisplay').style.display = 'block';
        } catch (err) { console.error(err); }
    });
</script>