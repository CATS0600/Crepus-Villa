---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="关于 - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="about-hero safe-zone">
            <h1 class="about-title">关于我</h1>
            <p class="about-subtitle">Crepuscular's Villa 背后的故事</p>
        </section>

        <!-- About Me Section -->
        <section class="about-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于我</h2>
                <div class="section-content">
                    <p class="section-text">
                        如你所知，我是 Crepuscular。虽然年龄不大(16 April 2012)，但我仍是一位充满热情的创造者和探索家。我热爱探索技术、创意和地球科学的交汇点。
                    </p>
                    <p class="section-text">
                        我相信乐观主义，且对国际互联网很感兴趣。无论是通过代码、设计，还是享受生活的美好时刻，我都致力于为所在社区做出有意义的贡献。
                    </p>
                    <p class="section-text">
                        我乐于与朋友聊天/分享我的想法和观点/向他人学习（有待考究:( 我也能成为你特有的倾听者。Ypa！
                    </p>
                </div>
            </div>
        </section>

        <!-- About My Interests & Friends Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于我的</h2>
                <div class="section-content">
                    <div class="interests-grid">
                        <div class="interest-item">
                            <h3 class="interest-title">技术</h3>
                            <p class="interest-desc">热衷于网页开发、云基础设施和新兴技术。</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">旅行</h3>
                            <p class="interest-desc">探索新地方、认识不同的人、捕捉美好时刻。</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">地球科学</h3>
                            <p class="interest-desc">探索地球科学的奇迹与防灾减灾。</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">社区</h3>
                            <p class="interest-desc">受不断成长的社区和有意义的连接所启发。</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">朋友</h3>
                            <p class="interest-desc">何乐而不为？</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">音乐</h3>
                            <p class="interest-desc">不同的流派，不同的情感，音乐跨越文化和代际连接我。</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Favorite Music Section -->
       <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于音乐</h2>
                    <div class="section-content">
                    <div class="music-grid">
                        <a href="https://www.bilibili.com/video/BV16J41167eM/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌆</div>
                            <h3 class="music-category">City Pop & 复古</h3>
                            <p class="music-desc">黄金时代的霓虹夜间风景。<br/>街のドルフィン - 滨田金吾</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1EY4y1V71F/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🤖</div>
                            <h3 class="music-category">VOCALOID</h3>
                            <p class="music-desc">数字生命与高能合成器。<br/>転生林檎 - ピノキオピー</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1A4411w7vc/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🍃</div>
                            <h3 class="music-category">永恒经典</h3>
                            <p class="music-desc">定义一代人的永恒旋律。<br/>My Love - Westlife</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1vpWEzXEqA/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🏎️</div>
                            <h3 class="music-category">竞速</h3>
                            <p class="music-desc">为肾上腺素飙升而生的高能曲目。<br/>Lose My Mind - Doja Cat</p>
                        </a>
                         <a href="https://www.bilibili.com/video/BV16t411D7Rt/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🎷</div>
                            <h3 class="music-category">爵士乐</h3>
                            <p class="music-desc">光滑的节奏和精致的器乐灵魂。<br/>Be Mine - Jazzinuf</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1bb41157eF/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌙</div>
                            <h3 class="music-category">古典音乐</h3>
                            <p class="music-desc">空灵的钢琴杰作，带来宁静的冥想。<br/>夜光 - Achille-Claude Debussy </p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1dT411T7W4/" target="_blank" rel="noopener noreferrer" class="music-card">
                        <div class="music-card-icon">🪖</div>
                            <h3 class="music-category">二战风云</h3>
                            <p class="music-desc">管弦乐国歌和历史氛围。<br/>Bella Ciao(钢铁雄心四：唯有浴血) - Paradox Interactive</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1QV6PBhEda/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">✨</div>
                            <h3 class="music-category">特别推荐</h3>
                            <p class="music-desc">有可能经常更新。不要错过！<br/>Reply - 超时空辉夜姬<br/>此链接为Bilibili『毕业演唱会』，包含 瞬間、シンフォニー。 与 Reply</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About DPMBG Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 DPMBG</h2>
                <div class="section-content">
                    <p class="section-text">
                        DPMBG，即Disaster Prevention and Mitigation Basic Group，灾害防减基础群。探索地球科学的美妙之处。群位于 QQ 中国。
                    </p>
                    <div class="button-container">
                        <a href="/application/dpmbg" class="cta-button">探索 DPMBG（即将推出）</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    // Scroll reveal animation using Intersection Observer
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, observerOptions);

    // Observe all scroll-reveal elements
    document.querySelectorAll('.scroll-reveal').forEach(element => {
        observer.observe(element);
    });
</script>

<style>
    .main-content {
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 80px;
    }

    .about-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .about-subtitle {
        font-size: 1.25rem;
        color: #86868b;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .about-title {
            color: #f5f5f7;
        }

        .about-subtitle {
            color: #a1a1a6;
        }
    }

    .about-section {
        margin-bottom: 60px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
    }

    .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin-bottom: 30px;
        letter-spacing: -0.01em;
    }

    @media (prefers-color-scheme: dark) {
        .about-section {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .section-title {
            color: #f5f5f7;
        }
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-text {
        font-size: 1rem;
        line-height: 1.8;
        color: #424245;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .section-text {
            color: #e0e0e2;
        }
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 20px;
    }

    .music-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .music-card {
        padding: 30px 20px;
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.05) 0%, rgba(66, 66, 69, 0.05) 100%);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .music-card:hover {
        transform: translateY(-8px);
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.1) 0%, rgba(66, 66, 69, 0.1) 100%);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: rgba(0, 0, 0, 0.15);
    }

    @media (prefers-color-scheme: dark) {
        .music-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(200, 200, 200, 0.05) 100%);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .music-card:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(200, 200, 200, 0.1) 100%);
            box-shadow: 0 12px 32px rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
        }
    }

    .music-card-icon {
        font-size: 2.5rem;
        display: inline-block;
    }

    .music-category {
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .music-desc {
        font-size: 0.9rem;
        color: #86868b;
        margin: 0;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .music-category {
            color: #f5f5f7;
        }

        .music-desc {
            color: #a1a1a6;
        }
    }

    .interest-item {
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .interest-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0 0 12px 0;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #86868b;
        line-height: 1.6;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .interest-item:hover {
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
        }

        .interest-title {
            color: #f5f5f7;
        }

        .interest-desc {
            color: #a1a1a6;
        }
    }

    .button-container {
        margin-top: 30px;
        display: flex;
        gap: 16px;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 32px;
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(29, 29, 31, 0.25);
    }

    @media (prefers-color-scheme: dark) {
        .cta-button {
            background: linear-gradient(135deg, #f5f5f7 0%, #d1d1d6 100%);
            color: #000000;
        }

        .cta-button:hover {
            box-shadow: 0 8px 24px rgba(245, 245, 247, 0.25);
        }
    }

    @media (max-width: 768px) {
        .about-title {
            font-size: 2.5rem;
        }

        .about-subtitle {
            font-size: 1rem;
        }

        .about-section {
            padding: 40px 24px;
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.5rem;
        }

        .interests-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Reveal animation */
    .reveal {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }

    /* Scroll reveal animation */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
    }

    .scroll-reveal.visible {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
