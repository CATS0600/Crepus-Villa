---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="关于 - Crepuscular's Villa" narrative={{ chapter: "DEFINE", quote: "每个人都有一段故事。这是她的。/ Everyone has a story. This is hers." }}>
    <Header />
    
    <main class="main-content">
        <section class="about-hero safe-zone">
            <h1 class="about-title">关于我</h1>
            <p class="about-subtitle">Crepuscular's Villa 背后的故事</p>
        </section>

        <!-- About Me Section -->
        <section class="about-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于我</h2>
                <div class="section-content">
                    <p class="section-text">
                        你可能已经知道了，我是 Crepuscular，也可以叫我 Cyril (S)。
                    </p>
                    <p class="section-text">
                        14岁（16 April 2012），你没有看错。技术、做东西、地球科学都有在学，顺序不固定。
                    </p>
                    <p class="section-text">
                        不盯着屏幕的时候，我时常享受生活的美好时刻。(不过大多数时候还是在盯着屏幕
                    </p>
                    <p class="section-text">
                        我常在网上聊天、分享想法、偶尔学到一点东西（效果存疑）。需要的话我也能当你的倾听者。Ypa！
                    </p>
                </div>
            </div>
        </section>
        
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于我的</h2>
                <div class="section-content">
                    <div class="interests-grid">
                        <div class="interest-item">
                            <h3 class="interest-title">💻 技术</h3>
                            <p class="interest-desc">网页开发、云基础、新兴技术与国际互联网。<br/>HTML理解不能，CSS理解不能，JS理解不能。</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">✈️ 旅行</h3>
                            <p class="interest-desc">探索新地方、认识不同的人、捕捉美好时刻。<br/>什么啊，南宁飞河内600CNY??</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🌍 地球科学</h3>
                            <p class="interest-desc">EEW - 予报 #1<br/>震中 : Crepuscular's Villa<br/>强度 : M 9.0<br/>深度 : 10km</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🏎️ 赛车</h3>
                            <p class="interest-desc">Is there a leakage?<br/>A leakage of what?<br/>I have the seat full of water! Like, full of water.<br/>Must be the water.</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🎮 游戏</h3>
                            <p class="interest-desc">"Sir why you play roblox"<br/>I learn English.<br/>"You know that you cant learn English by pla-<br/>I learn English.</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">👥 朋友</h3>
                            <p class="interest-desc">"彩叶, suki"<br/>-"UEEE 我嘛??"<br/>"你知道吗 也许我该和你结婚啊 彩叶"<br/>"哈???"</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Favorite Music Section -->
       <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于音乐</h2>
                    <div class="section-content">
                    <div class="music-grid">
                        <a href="https://www.bilibili.com/video/BV16J41167eM/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌆</div>
                            <h3 class="music-category">City Pop & 复古</h3>
                            <p class="music-desc">深夜、霓虹、一座可能从未真实存在过的城市。<br/>街のドルフィン - 滨田金吾</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV15HFVz1EvM/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🤖</div>
                            <h3 class="music-category">VOCALOID</h3>
                            <p class="music-desc">沃卡洛依得。<br/>月が綺麗ねと言われたい！ - カササギ</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1A4411w7vc/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🍃</div>
                            <h3 class="music-category">永恒经典</h3>
                            <p class="music-desc">经典常谈。<br/>My Love - Westlife</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1vpWEzXEqA/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🏎️</div>
                            <h3 class="music-category">竞速</h3>
                            <p class="music-desc">想开车但只能坐在椅子上的时候。<br/>Lose My Mind - Doja Cat</p>
                        </a>
                         <a href="https://www.bilibili.com/video/BV16t411D7Rt/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🎷</div>
                            <h3 class="music-category">爵士乐</h3>
                            <p class="music-desc">慢下来。没关系的。<br/>Be Mine - Jazzinuf</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1bb41157eF/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌙</div>
                            <h3 class="music-category">古典音乐</h3>
                            <p class="music-desc">凌晨三点，世界难得安静一次。<br/>夜光 - Achille-Claude Debussy </p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1dT411T7W4/" target="_blank" rel="noopener noreferrer" class="music-card">
                        <div class="music-card-icon">🪖</div>
                            <h3 class="music-category">二战风云</h3>
                            <p class="music-desc">是的，20年代的歌。<br/>Bella Ciao(钢铁雄心四：唯有浴血) - Paradox Interactive</p>
                        </a>
                        <a href="https://www.bilibili.com/video/BV1QV6PBhEda/" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">✨</div>
                            <h3 class="music-category">特别推荐</h3>
                            <p class="music-desc">有可能经常更新。不要错过！<br/>Bilibili 超时空辉夜姬『毕业演唱会』，包含 瞬間、シンフォニー。 与 Reply</p>
                        </a>
                    </div>
                    <!-- 另起一行，添加网易音乐 -->
                    <div class="music-grid-full">
                        <a href="https://music.163.com/#/playlist?id=8369421831&uct2=U2FsdGVkX19EdPnaxkc/gbSJbatcIca6b0IERVNYW9w=" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🎵</div>
                            <h3 class="music-category">Netease Music</h3>
                            <p class="music-desc">可能是世界最好的歌单<br/>My favourite tracks</p>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="about-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于名</h2>
                <div class="section-content">
                    <p class="section-text">
                        如果你在2025年之前认识的我，那时候我还叫"CATS"。后来改叫 Crepus / Crepuscular。现实里用得最多的是 Cyril [读作 Searul]。
                    </p>
                    <p class="section-text">
                        Crepuscular 是那种昼与夜刚好交接时的光。不够亮，不够暗，主要是好听。
                    </p>
                    <p class="section-text">
                        Cyril 这个名字则老一些，安静一些。有点像放在书架角落里装帧不错的旧书。希腊语里有"大气庄重"的意思，先拿名字撑着我的Aura。
                    </p>
                    <p class="section-text">
                       "Cyril"、"Crepus"、"KAZ"，叫哪个都行，都是我。
                    </p>
                </div>
            </div>
        </section>

        <!-- About Projects Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 Projects</h2>
                <div class="section-content">
                    <div class="projects-grid">
                        <div class="project-card">
                            <div class="project-icon">🤖</div>
                            <div class="project-info">
                                <h3 class="project-title">Cyril-Steward</h3>
                                <p class="project-type">QQ Bot</p>
                                <p class="project-desc">基于 QQ 平台的机器人，负责自动化和群管理。用的不多，但是让我第一次搞明白怎么让代码真正干点事。</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">🏠</div>
                            <div class="project-info">
                                <h3 class="project-title">Crepuscular's Villa</h3>
                                <p class="project-type">个人 Web</p>
                                <p class="project-desc">你现在正在访问的这个地方。用 Astro 框架构建的个人主页，同时也是我最大的互联网项目。</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">☕</div>
                            <div class="project-info">
                                <h3 class="project-title">Romi Cafe Mix</h3>
                                <p class="project-type">Restaurant Tycoon 3</p>
                                <p class="project-desc">Roblox 上的一家餐厅。对，就是这样。欢迎来喝一杯。</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">🚀</div>
                            <div class="project-info">
                                <h3 class="project-title">更多项目待探索</h3>
                                <p class="project-type">More</p>
                                <p class="project-desc">还有更多东西在做。没有时间表，没有保证。</p>
                            </div>
                        </div>
                        <a href="mailto:E-Crepuscular@outlook.com" class="project-card project-card--collab">
                            <div class="project-icon">🤝</div>
                            <div class="project-info">
                                <h3 class="project-title">商业合作</h3>
                                <p class="project-type">Business</p>
                                <p class="project-desc">欢迎商业合作，发邮件聊聊。</p>
                                <span class="project-link">E-Crepuscular@outlook.com<br/>→</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 临时注释掉 About DPMBG Section
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 DPMBG</h2>
                <div class="section-content">
                    <p class="section-text">
                        DPMBG，即Disaster Prevention and Mitigation Basic Group，灾害防减基础群。探索地球科学的美妙之处。群位于 QQ 中国。（绝对不是TTCCTCTC粉丝群
                    </p>
                    <div class="button-container">
                        <a href="/application/dpmbg" class="cta-button">申请 DPMBG（即将推出）</a>
                    </div>
                </div>
            </div>
        </section>
        -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 KEMDR</h2>
                <div class="section-content">
                    <p class="section-text">
                        KEMDR，即Kouno Earthquake Migration and Disaster Reduction Bureau，香野放送局，是一个专注地震观测和相关知识的QQ群。
                    </p>
                    <p class="section-text">
                        气氛随意，讨论不一定正经。对地震或地质活动感兴趣的都欢迎来，还可以学英语(绝对不是小张张粉丝群
                    </p>
                    <div class="button-container">
                        <a href="../application/kemdr" class="cta-button" target="_blank" rel="noopener noreferrer">申请加入</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Villa Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">关于 Villa</h2>
                <div class="section-content">
                    <p class="section-text">
                        Crepus Villa，但却不仅仅是Villa。<br/>从零开始搭这个东西，IDE、CloudFlare、Github，一路踩坑。自己的东西学起来就是不一样，会真的在意。<br/>本来只是个主页，结果变成了一个不断回来折腾的地方。一半是实验，一半是目前互联网上唯一完全属于自己的角落。<br/>"Villa"这个词更多是一种心理状态——幻想自己在托斯卡纳，然后build第三次失败。
                    </p>
                    <p class="section-text">
                    <p class="section-text" style="margin-top: 2rem;">
                        <span style="font-size: 11px; letter-spacing: 0.15em; color: var(--accent-color, #f7c46c); font-weight: 700; text-transform: uppercase;">· MANIFEST ·</span>
                    </p>
                    <p class="section-text">
                        Crepuscular's Villa 的简要时间线 — <span style="font-style: italic;">从零建造这座 Villa</span>:
                    </p>
                    </p>
                    <ul class="timeline">
                        <li data-key="timeline-1">
                            <strong>20 Feb 2026 V1</strong> - Villa V1, 成功创建了Astro框架。
                        </li>
                        <li data-key="timeline-2">
                            <strong>20 Feb 2026 V2</strong> - 同日发布 Villa V2，初步部署Villa
                        </li>
                        <li data-key="timeline-3">
                            <strong>21 Feb 2026 V3</strong> - 迅速地发布 Villa V3，极大完善了基础设施。
                        </li>
                        <li data-key="timeline-4">
                            <strong>3 Mar 2026 V4E</strong> - Villa V4E 发布，全新加入./about, No-where, Now-here。
                        </li>
                         <li data-key="timeline-5">
                            <strong>7 Mar 2026 V4</strong> - 经过半月艰苦Push后，Villa V4正式与大家见面。
                        </li>
                        <li data-key="timeline-6">
                            <strong>12 / 17 / 25 Mar / 9 Apr 2026 V4 - Block 12 / 32 / 52 / 77 / 99 <br/></strong>无论是Lenis平滑，还是页面的美化，Villa V4的每一个批次都在不断提升用户体验。
                        </li>
                        <li data-key="timeline-7">
                            <strong>16 Apr 2026 V5S</strong> - 🎂
                        </li>
                        <li contenteditable="true" data-key="timeline-8">
                            <strong>11 Apr 2026 V5</strong> - <i>Villa V5, 撰写你的更新。</i>
                        </li>
                        <li data-key="timeline-9">
                            <strong>14 May 2026 V5 Block 39</strong> - 感谢一直以来支持我们的人，サンキュー！！
                        </li>
                        <li data-key="timeline-10">
                            <strong>17 May 2026 V5 Block 44</strong> - Villa & KEMDR?? Why not!
                        </li>
                        <li data-key="timeline-11">
                            <strong>26 May 2026 V5 Block 55</strong> - OpenCode荣幸参与Admin面板重构、KEMDR双语适配及性能优化，见证其持续进化。🎉
                        </li>
                        <li data-key="timeline-12">
                            <strong>5 Jun 2026 V5 Block 67</strong> - 安全与自然语言升级 # 67777。
                        </li>
                    </ul>
                </div>
            </div>
        </section>
        

    </main>
</Layout>

<script>
    import { initAboutPage } from '../../lib/about.js';
    initAboutPage();
</script>

<style>
    .main-content {
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 80px;
    }

    .about-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .about-subtitle {
        font-size: 1.25rem;
        color: #86868b;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .about-title {
            color: #f5f5f7;
        }

        .about-subtitle {
            color: #a1a1a6;
        }
    }

    .about-section {
        margin-bottom: 60px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
    }

    .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin-bottom: 30px;
        letter-spacing: -0.01em;
    }

    @media (prefers-color-scheme: dark) {
        .about-section {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .section-title {
            color: #f5f5f7;
        }
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-text {
        font-size: 1rem;
        line-height: 1.8;
        color: #424245;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .section-text {
            color: #e0e0e2;
        }
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 20px;
    }

    .music-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .music-card {
        padding: 30px 20px;
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.05) 0%, rgba(66, 66, 69, 0.05) 100%);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    
    /* 新增：专门用于占据满宽度的音乐卡片容器 */
    .music-grid-full {
        display: grid;
        grid-template-columns: 1fr; /* 强制单列 */
        margin-top: 20px;
    }

    /* 调整原有 music-card 在满宽模式下的表现 */
    .music-grid-full .music-card {
        flex-direction: row; /* 横向排列图标和文字 */
        justify-content: center;
        padding: 20px;
        gap: 24px;
    }

/* 响应式微调：小屏幕下回到堆叠布局 */
    @media (max-width: 768px) {
        .music-grid-full .music-card {
        flex-direction: column;
        gap: 12px;
        }
    }

    .music-card:hover {
        transform: translateY(-8px);
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.1) 0%, rgba(66, 66, 69, 0.1) 100%);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: rgba(0, 0, 0, 0.15);
    }

    @media (prefers-color-scheme: dark) {
        .music-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(200, 200, 200, 0.05) 100%);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .music-card:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(200, 200, 200, 0.1) 100%);
            box-shadow: 0 12px 32px rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
        }
    }

    .music-card-icon {
        font-size: 2.5rem;
        display: inline-block;
    }

    .music-category {
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .music-desc {
        font-size: 0.9rem;
        color: #86868b;
        margin: 0;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .music-category {
            color: #f5f5f7;
        }

        .music-desc {
            color: #a1a1a6;
        }
    }

    .interest-item {
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .interest-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0 0 12px 0;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #86868b;
        line-height: 1.6;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .interest-item:hover {
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
        }

        .interest-title {
            color: #f5f5f7;
        }

        .interest-desc {
            color: #a1a1a6;
        }
    }

    /* Projects Grid */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .project-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: transform 0.3s, box-shadow 0.3s;
        text-decoration: none;
        color: inherit;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
