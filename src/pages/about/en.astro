---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="About - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="about-hero safe-zone">
            <h1 class="about-title">About</h1>
            <p class="about-subtitle">Stories behind Crepuscular's Villa</p>
        </section>

        <!-- About Me Section -->
        <section class="about-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Me</h2>
                <div class="section-content">
                    <p class="section-text">
                        You probably know me as Crepuscular. Cyril (S) works too.
                    </p>
                    <p class="section-text">
                        14 y/o (16 April 2012), Yes it is. Into tech, making stuff, and earth science — not necessarily in that order.
                    </p>
                    <p class="section-text">
                        I poke around with code and design when I'm not just staring at the internet. Mostly the latter.
                    </p>
                    <p class="section-text">
                        Online a lot, chatting, sharing opinions, occasionally learning things (results inconclusive). Also a decent listener if you need one. Ypa!
                    </p>
                </div>
            </div>
        </section>

        <!-- About My Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About My</h2>
                <div class="section-content">
                    <div class="interests-grid">
                        <div class="interest-item">
                            <h3 class="interest-title">💻 Technology</h3>
                            <p class="interest-desc">Web development, cloud infrastructure, emerging technologies and the Global Internet.<br/>Unable to understand HTML, unable to understand CSS, unable to understand JS.</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">✈️ Traveling</h3>
                            <p class="interest-desc">Explore new places, meet different people, and capture beautiful moments.<br/>BRO What?! 600 CNY from Nanning to Hanoi??</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🌍 Earth Science</h3>
                            <p class="interest-desc">EEW - Forecast #1<br/>Epicenter : Crepuscular's Villa<br/>Magnitude : 9.0<br/>Depth : 10km</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🏎️ Racing</h3>
                            <p class="interest-desc">Is there a leakage?<br/>A leakage of what?<br/>I have the seat full of water! Like, full of water.<br/>Must be the water.</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">🎮 Games</h3>
                            <p class="interest-desc">"Sir why you play roblox"<br/>I learn English.<br/>"You know that you cant learn English by pla-<br/>I learn English.</p>
                        </div>
                        <div class="interest-item">
                            <h3 class="interest-title">👥 Friends</h3>
                            <p class="interest-desc">"Iroha, suki"<br/>-"UEEE Me??"<br/>"Do you know that I should have married you Iroha"<br/>"WHAAAAA??? "</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Favorite Music Section -->
       <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Music</h2>
                    <div class="section-content">
                    <div class="music-grid">
                        <a href="https://www.youtube.com/watch?v=x2aA6GEEABA" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌆</div>
                            <h3 class="music-category">City Pop & Retro</h3>
                            <p class="music-desc">Late nights, neon signs, and cities that probably never existed.<br/>Druin of the City - Kingo Hamada</p>
                        </a>
                        <a href="https://youtu.be/B3IClmMbH6w" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🤖</div>
                            <h3 class="music-category">Vocaloid & ACG</h3>
                            <p class="music-desc">I have that feelings<br/>I Want to Be Told 'The Moon Is Beautiful'! - Kasasagi</p>
                        </a>
                        <a href="https://www.youtube.com/watch?v=ulOb9gIGGd0" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🍃</div>
                            <h3 class="music-category">Evergreens</h3>
                            <p class="music-desc">Plain Talk on the Classics.<br/>My Love - Westlife</p>
                        </a>
                        <a href="https://www.youtube.com/watch?v=whbczRUgYQw" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🏎️</div>
                            <h3 class="music-category">Racing</h3>
                            <p class="music-desc">For when you want to go fast but can't leave your chair.<br/>Lose My Mind - Doja Cat</p>
                        </a>
                         <a href="https://www.youtube.com/watch?v=hUbF1EXOcfI" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🎷</div>
                            <h3 class="music-category">Jazz</h3>
                            <p class="music-desc">Slow down. It's fine.<br/>Be Mine - Jazzinuf</p>
                        </a>
                        <a href="https://www.youtube.com/watch?v=XnKsbXW72-8" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🌙</div>
                            <h3 class="music-category">Classical</h3>
                            <p class="music-desc">3am and the world is actually quiet for once.<br/>Suite bergamasque: 3. Clair de lune - Debussy/Zoltán Kocsis</p>
                        </a>
                        <a href="https://www.youtube.com/watch?v=u-qTuXDEnFo" target="_blank" rel="noopener noreferrer" class="music-card">
                        <div class="music-card-icon">🪖</div>
                            <h3 class="music-category">WWII Style</h3>
                            <p class="music-desc">Yes, songs from the 20s.<br/>Bella Ciao (HOI IV) - Paradox Interactive</p>
                        </a>
                        <a href="https://www.youtube.com/watch?v=aaA0bivRRaA" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">✨</div>
                            <h3 class="music-category">Special</h3>
                            <p class="music-desc">Current obsession—don't miss out!<br/>Reply - Super Kaguya-hime</p>
                        </a>
                    </div>                    <!-- break line for music grid -->
                    <div class="music-grid-full">
                        <a href="https://music.163.com/#/playlist?id=8369421831&uct2=U2FsdGVkX19EdPnaxkc/gbSJbatcIca6b0IERVNYW9w=" target="_blank" rel="noopener noreferrer" class="music-card">
                            <div class="music-card-icon">🎵</div>
                            <h3 class="music-category">Netease Music</h3>
                            <p class="music-desc">Playlist on Netease Cloud Music<br/>My favourite tracks</p>
                        </a>
                    </div>           
                </div>
            </div>
        </section>

        <section class="about-section content-card reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Name</h2>
                <div class="section-content">
                    <p class="section-text">
                        If you knew me before 2025, I was "CATS." Now I go by Crepus, Crepuscular, or Cyril — Cyril being the one I actually use day-to-day.
                    </p>
                    <p class="section-text">
                        Crepuscular is the light right at the edge of day and night — not quite either one. I liked the idea of that. It's not dark, mainly sounds good.
                    </p>
                    <p class="section-text">
                        Cyril is older, quieter. A bit classical. The kind of name that sounds like it belongs in a library somewhere. It's got this air of "calm and collected" which. My Aurafarm is all thanks to it.
                    </p>
                    <p class="section-text">
                       "Cyril," "Crepus," "KAZ" — pick whichever. Its all me.
                    </p>
                </div>
            </div>
        </section>

        <!-- About Projects Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Projects</h2>
                <div class="section-content">
                    <div class="projects-grid">
                        <div class="project-card">
                            <div class="project-icon">🤖</div>
                            <div class="project-info">
                                <h3 class="project-title">Cyril-Steward</h3>
                                <p class="project-type">QQ Bot</p>
                                <p class="project-desc">A QQ bot that handles automated stuff and group management. Not used all that much, but it's where I first figured out how to make code actually do something.</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">🏠</div>
                            <div class="project-info">
                                <h3 class="project-title">Crepuscular's Villa</h3>
                                <p class="project-type">Personal Website</p>
                                <p class="project-desc">The place you are currently visiting. Built with the Astro framework, this is my personal homepage and also my largest internet project.</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">☕</div>
                            <div class="project-info">
                                <h3 class="project-title">Romi Cafe Mix</h3>
                                <p class="project-type">Restaurant Tycoon 3</p>
                                <p class="project-desc">A restaurant on Roblox. Yes, really. Come have a coffee.</p>
                            </div>
                        </div>
                        <div class="project-card">
                            <div class="project-icon">🚀</div>
                            <div class="project-info">
                                <h3 class="project-title">More Projects</h3>
                                <p class="project-type">More</p>
                                <p class="project-desc">More things coming. No timeline. No promises.</p>
                            </div>
                        </div>
                        <a href="mailto:E-Crepuscular@outlook.com" class="project-card project-card--collab">
                            <div class="project-icon">🤝</div>
                            <div class="project-info">
                                <h3 class="project-title">Business Collaboration</h3>
                                <p class="project-type">Business</p>
                                <p class="project-desc">Open to business collaborations. Drop a message and we'll talk.</p>
                                <span class="project-link">E-Crepuscular@outlook.com<br/>→</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 临时注释掉 About DPMBG Section
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About DPMBG</h2>
                <div class="section-content">
                    <p class="section-text">
                        The DPMBG, or Disaster Prevention and Mitigation Basic Group. Explore the beauty of Earth Science. Currently running on QQ China.
                    </p>
                    <div class="button-container">
                        <a href="/application/dpmbg" class="cta-button">Apply DPMBG (Coming Soon)</a>
                    </div>
                </div>
            </div>
        </section>
        -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About KEMDR</h2>
                <div class="section-content">
                    <p class="section-text">
                        KEMDR — Kouno Earthquake Migration and Disaster Reduction Bureau — is a QQ group for people actually interested in earthquakes. We track seismic activity, share knowledge, and talk about geological stuff.
                    </p>
                    <p class="section-text">
                        Low-drama, open discussion (The topic may not be safe for work). If you're into earthquakes or just curious about what's happening under the ground, come join. You can also learn some English and Chinese there.
                    </p>
                    <div class="button-container">
                        <a href="../application/kemdr" class="cta-button" target="_blank" rel="noopener noreferrer">Apply to Join</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Villa Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Villa</h2>
                <div class="section-content">
                    <p class="section-text">
                        Crepus Villa, but it's more than just a villa.<br/>Building this from scratch gave me a real space to figure things out — IDEs, Cloudflare, GitHub, the whole mess. You learn differently when something is actually yours.<br/>It started as a personal homepage and kind of turned into something I keep coming back to. Part playground, part experiment, part the only corner of the internet that's fully mine.<br/>The "villa" part is aspirational. Like imagining you're in Tuscany while your build fails for the third time. (Web dev is genuinely more stressful lol)
                    </p>
                    <p class="section-text" style="margin-top: 2rem;">
                        <span style="font-size: 11px; letter-spacing: 0.15em; color: var(--accent-color, #f7c46c); font-weight: 700; text-transform: uppercase;">· MANIFEST ·</span>
                    </p>
                    <p class="section-text">
                        A brief timeline of Crepuscular's Villa — <span style="font-style: italic;">从零建造这座 Villa</span>:
                    </p>
                    <ul class="timeline">
                        <li data-key="timeline-en-1">
                            <strong>20 Feb 2026</strong> - Villa V1 , successfully created the Astro framework.
                        </li>
                        <li data-key="timeline-en-2">
                            <strong>20 Feb 2026</strong> - Villa V2 was released on the same day, marking the initial deployment of Villa.
                        </li>
                        <li data-key="timeline-en-3">
                            <strong>21 Feb 2026</strong> - The rapid release of Villa V3 greatly improved the infrastructure.
                        </li>
                        <li data-key="timeline-en-4">
                            <strong>3 Mar 2026</strong> - Villa V4E was released with ./about , No-where, Now-here.
                        </li>
                         <li data-key="timeline-en-5">
                            <strong>7 Mar 2026</strong> - After a grueling two-week push, the Villa V4 has officially been released.
                        </li>
                        <li data-key="timeline-en-6">
                            <strong>12 / 17 / 25 Mar / 9 Apr 2026 V4 <br/> Block 12 / 32 / 52 / 77 / 99 </strong> - Whether Lenis smoothing or page beautification, each batch of Villa V4 continuously improves the user experience.
                        </li>
                        <li data-key="timeline-en-7">
                            <strong>16 Apr 2026 V5S</strong> - 🎂
                        </li>
                        <li contenteditable="true" data-key="timeline-en-8">
                            <strong>11 Apr 2026 V5</strong> - <i>Villa V5, write your own update.</i>
                        </li>
                        <li data-key="timeline-en-9">
                            <strong>14 May 2026 V5 Block 39</strong> - Thank you all for your continuous support,サンキュー！！
                        </li>
                        <li data-key="timeline-en-10">
                            <strong>17 May 2026 V5 Block 44</strong> - Villa & KEMDR?? Why not!
                        </li>
                        <li data-key="timeline-en-11">
                            <strong>26 May 2026 V5 Block 55</strong> - OpenCode is honored to have participated in the reconstruction of the Admin panel, the bilingual adaptation of KEMDR, and performance optimization, witnessing its continuous evolution. 🎉
                        </li>
                        <li data-key="timeline-en-12">
                            <strong>5 Jun 2026 V5 Block 67</strong> - Security and Natural Language Upgrade # 67777
                        </li>
                    </ul>
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    import { initAboutPage } from '../../lib/about.js';
    initAboutPage();
</script>

<style>
    .main-content {
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 80px;
    }

    .about-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .about-subtitle {
        font-size: 1.25rem;
        color: #86868b;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .about-title {
            color: #f5f5f7;
        }

        .about-subtitle {
            color: #a1a1a6;
        }
    }

    .about-section {
        margin-bottom: 60px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
    }

    .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin-bottom: 30px;
        letter-spacing: -0.01em;
    }

    @media (prefers-color-scheme: dark) {
        .about-section {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .section-title {
            color: #f5f5f7;
        }
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-text {
        font-size: 1rem;
        line-height: 1.8;
        color: #424245;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .section-text {
            color: #e0e0e2;
        }
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 20px;
    }

    .music-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    /* 新增：专门用于占据满宽度的音乐卡片容器 */
    .music-grid-full {
        display: grid;
        grid-template-columns: 1fr; /* 强制单列 */
        margin-top: 20px;
    }

    /* 调整原有 music-card 在满宽模式下的表现 */
    .music-grid-full .music-card {
        flex-direction: row; /* 横向排列图标和文字 */
        justify-content: center;
        padding: 20px;
        gap: 24px;
    }

/* 响应式微调：小屏幕下回到堆叠布局 */
    @media (max-width: 768px) {
        .music-grid-full .music-card {
        flex-direction: column;
        gap: 12px;
        }
    }

    .music-card {
        padding: 30px 20px;
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.05) 0%, rgba(66, 66, 69, 0.05) 100%);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .music-card:hover {
        transform: translateY(-8px);
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.1) 0%, rgba(66, 66, 69, 0.1) 100%);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: rgba(0, 0, 0, 0.15);
    }

    @media (prefers-color-scheme: dark) {
        .music-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(200, 200, 200, 0.05) 100%);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .music-card:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(200, 200, 200, 0.1) 100%);
            box-shadow: 0 12px 32px rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
        }
    }

    .music-card-icon {
        font-size: 2.5rem;
        display: inline-block;
    }

    .music-category {
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .music-desc {
        font-size: 0.9rem;
        color: #86868b;
        margin: 0;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .music-category {
            color: #f5f5f7;
        }

        .music-desc {
            color: #a1a1a6;
        }
    }

    .interest-item {
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .interest-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0 0 12px 0;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #86868b;
        line-height: 1.6;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .interest-item:hover {
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
        }

        .interest-title {
            color: #f5f5f7;
        }

        .interest-desc {
            color: #a1a1a6;
        }
    }


    /* Projects Grid */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .project-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: transform 0.3s, box-shadow 0.3s;
        text-decoration: none;
        color: inherit;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .project-card--collab {
        border: 1px solid rgba(29, 29, 31, 0.15);
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.04) 0%, rgba(66, 66, 69, 0.04) 100%);
        cursor: pointer;
        padding-right: 40px;
    }

    .project-card--collab:hover {
        border-color: rgba(29, 29, 31, 0.3);
        box-shadow: 0 8px 24px rgba(29, 29, 31, 0.12);
    }

    .project-icon {
        font-size: 2rem;
        flex-shrink: 0;
        line-height: 1;
        margin-top: 2px;
    }

    .project-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .project-title {
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .project-type {
        font-size: 0.75rem;
        font-weight: 500;
        color: #86868b;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin: 0;
    }

    .project-desc {
        font-size: 0.9rem;
        color: #424245;
        line-height: 1.6;
        margin: 4px 0 0 0;
    }

    .project-link {
        display: inline-block;
        margin-top: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        color: #1d1d1f;
        opacity: 0.6;
        transition: opacity 0.2s;
    }

    .project-card--collab:hover .project-link {
        opacity: 1;
    }

    @media (prefers-color-scheme: dark) {
        .project-card {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .project-card:hover {
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.08);
        }

        .project-card--collab {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(200, 200, 200, 0.04) 100%);
            border-color: rgba(255, 255, 255, 0.12);
        }

        .project-card--collab:hover {
            border-color: rgba(255, 255, 255, 0.25);
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
        }

        .project-title {
            color: #f5f5f7;
        }

        .project-desc {
            color: #e0e0e2;
