                        <a href="https://ks.wjx.com/vm/e7vWXP0.aspx#" class="cta-button" target="_blank" rel="noopener noreferrer">Apply to Join (Chinese External Link)</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Villa Section -->
        <section class="about-section content-card scroll-reveal">
            <div class="safe-zone">
                <h2 class="section-title">About Villa</h2>
                <div class="section-content">
                    <p class="section-text">
                        A brief timeline of Crepuscular's Villa:
                    </p>
