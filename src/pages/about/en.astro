    </main>
</Layout>

<script>
    // Scroll reveal animation using Intersection Observer
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, observerOptions);

    // Observe all scroll-reveal elements
    document.querySelectorAll('.scroll-reveal').forEach(element => {
        observer.observe(element);
    });
</script>

<style>
    .main-content {
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
    }

    .about-hero {
        text-align: center;
        margin-bottom: 80px;
    }

    .about-title {
        font-size: 3.5rem;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
    }

    .about-subtitle {
        font-size: 1.25rem;
        color: #86868b;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .about-title {
            color: #f5f5f7;
        }

        .about-subtitle {
            color: #a1a1a6;
        }
    }

    .about-section {
        margin-bottom: 60px;
        padding: 60px 40px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        backdrop-filter: blur(10px);
    }

    .section-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1d1d1f;
        margin-bottom: 30px;
        letter-spacing: -0.01em;
    }

    @media (prefers-color-scheme: dark) {
        .about-section {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .section-title {
            color: #f5f5f7;
        }
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .section-text {
        font-size: 1rem;
        line-height: 1.8;
        color: #424245;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .section-text {
            color: #e0e0e2;
        }
    }

    .interests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 20px;
    }

    .music-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .music-card {
        padding: 30px 20px;
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.05) 0%, rgba(66, 66, 69, 0.05) 100%);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .music-card:hover {
        transform: translateY(-8px);
        background: linear-gradient(135deg, rgba(29, 29, 31, 0.1) 0%, rgba(66, 66, 69, 0.1) 100%);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: rgba(0, 0, 0, 0.15);
    }

    @media (prefers-color-scheme: dark) {
        .music-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(200, 200, 200, 0.05) 100%);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .music-card:hover {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(200, 200, 200, 0.1) 100%);
            box-shadow: 0 12px 32px rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.15);
        }
    }

    .music-card-icon {
        font-size: 2.5rem;
        display: inline-block;
    }

    .music-category {
        font-size: 1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0;
    }

    .music-desc {
        font-size: 0.9rem;
        color: #86868b;
        margin: 0;
        font-weight: 400;
    }

    @media (prefers-color-scheme: dark) {
        .music-category {
            color: #f5f5f7;
        }

        .music-desc {
            color: #a1a1a6;
        }
    }

    .interest-item {
        padding: 24px;
        background: rgba(251, 251, 253, 0.8);
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .interest-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .interest-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 0 0 12px 0;
    }

    .interest-desc {
        font-size: 0.95rem;
        color: #86868b;
        line-height: 1.6;
        margin: 0;
    }

    @media (prefers-color-scheme: dark) {
        .interest-item {
            background: rgba(44, 44, 46, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .interest-item:hover {
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
        }

        .interest-title {
            color: #f5f5f7;
        }

        .interest-desc {
            color: #a1a1a6;
        }
    }

    .timeline {
        list-style: none;
        padding: 0;
    }

    .timeline li {
        margin-bottom: 10px;
        opacity: 0;
        transform: translateX(-20px);
        animation: timelineFadeIn 0.5s ease forwards;
    }

    .timeline li:nth-child(1) { animation-delay: 0.1s; }
    .timeline li:nth-child(2) { animation-delay: 0.2s; }
    .timeline li:nth-child(3) { animation-delay: 0.3s; }
    .timeline li:nth-child(4) { animation-delay: 0.4s; }

    @keyframes timelineFadeIn {
        to { opacity: 1; transform: translateX(0); }
    }

      /* The actual timeline (vertical line) */
    .timeline {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    }

    .button-container {
        margin-top: 30px;
        display: flex;
        gap: 16px;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 32px;
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(29, 29, 31, 0.25);
    }

    @media (prefers-color-scheme: dark) {
        .cta-button {
            background: linear-gradient(135deg, #f5f5f7 0%, #d1d1d6 100%);
            color: #000000;
        }

        .cta-button:hover {
            box-shadow: 0 8px 24px rgba(245, 245, 247, 0.25);
        }
    }

    @media (max-width: 768px) {
        .about-title {
            font-size: 2.5rem;
        }

        .about-subtitle {
            font-size: 1rem;
        }

        .about-section {
            padding: 40px 24px;
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.5rem;
        }

        .interests-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Reveal animation */
    .reveal {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }

    /* Scroll reveal animation */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
    }

    .scroll-reveal.visible {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
