---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import villav4icon from '../v4icon/villav4icon.jpg';
// 引入位于 switchphoto 中的电影比例图片
import switchImg from '../switchphoto/a.jpg';

const images = await Astro.glob('/src/photos/*.{jpg,jpeg,png,webp,avif}');

// 2 & 6. 在 const 中定义图片注释
const photoCaptions = [
    "Shenzhen, China, Apr 2023",
    "Dali, China,Jul 2023",
    "Lijiang, China, Jul 2023",
    "Nanning, China, Feb 2024",
    "Robloxia, Jun 2024",
    "New York, Robloxia, Jul 2024",
    "Bangkok, Thailand, Aug 2024",
    "Chiang Mai, Thailand, Aug 2024",
    "Robloxia, Nov 2024",
    "Frappe, Robloxia, Oct 2024",
    "Sara, Robloxia, Dec 2024",
    "Greenville, Robloxia, Jan 2025",
    "Shanghai, China, Aug 2025",
    "Changsha, China, May 2025",
    "Nanning, China, Jun 2025",
    "Beihai, China, Oct 2025",
    "Slong City, Cities: Skylines, Dec 2025",
    "Chongqing, China, Feb 2026",
    "Guangxi, China, Feb 2026",
];

const partners = ["Paramecium", "Hydrolight", "Odysphere", "Roblox", "Google", "CloudFlare", "Astro", "Github", "Gemini", "You can be next"];
const pr_web = [
    "https://paramecium2010.top", "https://hydrolight.top", "https://www.odysphere.tech", "https://www.roblox.com",
    "https://www.google.com", "https://www.cloudflare.com", "https://astro.build",
    "https://github.com", "https://gemini.google.com", "./sponsor"
];

const galleryQuote = "It doesn't matter where you start, it's how you progress from there.";
---

<Layout title="Crepuscular's Villa">
    <Header />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

    <main class="main-content">
        <div class="scrolling-text" id="scrollText">CREPUSCULAR'S VILLA, RELAX AND ENJOY LIFE STYLES.DA BEST PIZZA IN ALL OF AMERICA AND ALL OF GLOBE A DOLLA A SLICE YOU AINT FINDIN THIS TASTE ANYWHERE ELSE ONLY AT NEW YOK</div>

        <section class="content-section reveal">
            <div class="container safe-zone">
                <h1 class="hero-title">
                    Where Ideas <span id="lineBreak"></span><span id="typewriter" class="accent-text"></span><span class="cursor"></span>
                </h1>
                <p class="sub-text">Relax, and enjoy.</p>
            </div>
        </section>

        <section class="photo-gallery-section safe-zone">
            <div class="gallery-stack">
                
                {images.map((img, index) => {
                    // 1. 动态计算尺寸与位置
                    const isEven = index % 2 === 0;
                    // 循环定义三种大小档位
                    const sizes = ['size-s', 'size-m', 'size-l'];
                    const sizeClass = sizes[index % 3];
                    const alignClass = isEven ? 'align-left' : 'align-right';
                    
                    return (
                        <div class={`photo-container ${sizeClass} ${alignClass}`}>
                            {/* 6. 图片旁的注释小字 */}
                            {photoCaptions[index] && (
                                <span class="photo-annotation">{photoCaptions[index]}</span>
                            )}
                            <div class="photo-wrapper">
                                <img src={img.default.src} alt={`Gallery item ${index}`} loading="lazy" />
                            </div>
                        </div>
                    );
                })}

                <div class="gallery-quote-box">
                    <p class="quote-text">{galleryQuote}</p>
                    <span class="quote-author">— Lando Norris</span>
                </div>

                <div class="send-section" style="margin: 80px 0; text-align: center;">
                    <p class="partner-desc" style="margin-bottom: 20px;">Have something to say?</p>
                    <div class="button-group">
                        <a href="/send" class="send-button">
                            <span class="send-icon">✍️</span>
                            <span class="send-text">Share Your Message</span>
                        </a>
                        <a href="/reply" class="send-button">
                            <span class="send-icon">📫</span>
                            <span class="send-text">Check The Reply</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="auto-scroll-section">
            <div class="horizontal-view">
                <div class="partner-intro safe-zone">
                    <h2 class="partner-sub-title">PARTNERS & SPONSORS</h2>
                    <p class="partner-desc">Simply Lovely!</p>
                </div>
                
                <div class="infinite-scroll-container">
                    <div class="partner-list">
                                {partners.map((p, i) => (
                            <a href={pr_web[i]} class="logo-card" target="_blank" rel="noopener noreferrer">
                                <span class="logo-name">{p}</span>
                            </a>
                        ))}
                        {partners.map((p, i) => (
                            <a href={pr_web[i]} class="logo-card" target="_blank" rel="noopener noreferrer">
                                <span class="logo-name">{p}</span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- ✅ 修改1：图片扩大到占满界面左右，移除 safe-zone 限制和 max-width -->
        <section class="cl16-switch-section">
            <div class="cl16-container" id="cl16Trigger">
                <div class="cl16-overlay"></div>
                <img src={switchImg.src} alt="Cinematic Visual" class="cl16-bg" />
                <div class="cl16-content">
                    <h2 class="cl16-title">RACING SPIRIT</h2>
                    <!-- ✅ 修改2：移除"Click to switch"副标题 -->
                </div>
            </div>
        </section>

        <!-- ✅ 修改3：各模块间距加大，统一使用 section-gap class -->
        <section class="applications-section section-gap">
            <div class="safe-zone" style="max-width: 1000px; margin: 0 auto;">
                <div class="app-header" style="text-align: center; margin-bottom: 60px;">
                    <h2 class="partner-sub-title" style="margin-bottom: 10px;">APPLICATIONS</h2>
                    <p class="partner-desc">Join Our Communities</p>
                </div>
                <div class="applications-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
                    <a href="/application/dpmbg" class="app-card" style="text-decoration: none;">
                        <div class="app-card-icon">🌍</div>
                        <h3 class="app-card-title">DPMBG Application</h3>
                        <p class="app-card-desc">Disaster Prevention and Mitigation Basic Group</p>
                        <span class="app-arrow">→</span>
                    </a>
                    <a href="https://ks.wjx.com/vm/e7vWXP0.aspx#" class="app-card" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
                        <div class="app-card-icon">📻</div>
                        <h3 class="app-card-title">KEMDR Application</h3>
                        <p class="app-card-desc">Kouno Earthquake Migration and Disaster Reduction Bureau</p>
                        <span class="app-arrow">↗</span>
                    </a>
                </div>
            </div>
        </section>

            <div class="contact-container safe-zone section-gap" style="padding-bottom: 100px;">
                <h2 class="contact-title">WHAT'S UP ON INTERNET</h2>
                <p class="partner-desc">Follow Me on socials</p>
                <div class="social-links">
                    <a href="https://qm.qq.com/q/Qme3jDzp2G" class="social-card" target="_blank" rel="noopener noreferrer">
                        <span class="social-icon">🐧</span>
                        <span class="social-name">QQ</span>
                    </a>
                    <a href="https://www.youtube.com/@Crepuscular_official" class="social-card" target="_blank" rel="noopener noreferrer">
                        <span class="social-icon">▶</span>
                        <span class="social-name">Youtube</span>
                    </a>
                    <a href="https://www.tiktok.com/@crepuscu1ar" class="social-card" target="_blank" rel="noopener noreferrer">
                        <span class="social-icon">🎶</span>
                        <span class="social-name">Tiktok</span>
                    </a>
                    <a href="https://www.douyin.com/user/MS4wLjABAAAAqaOxzbO4yrIUjNbo3HLSUkM3D4RzArWCi9DnFTtQNPlogqyIL6gnrRnzmPwB3WZ7?from_tab_name=main" class="social-card" target="_blank" rel="noopener noreferrer">
                        <span class="social-icon">🎵</span>
                        <span class="social-name">Douyin</span>
                    </a>
                    <a href="https://www.roblox.com/users/3328635171/profile" class="social-card" target="_blank" rel="noopener noreferrer">
                        <span class="social-icon">✨</span>
                        <span class="social-name">Roblox</span>
                    </a>
                </div>

                <!-- ✅ 修改3：Radio check 与上方间距加大 -->
                <p class="partner-desc" style="margin-top: 120px; margin-bottom: 30px;">Radio check? send me</p>
                <div class="email-container" style="margin-top: 50px;">
                    <a href="mailto:E-Crepuscular@outlook.com" class="email-button">
                        <span class="email-icon">✉</span>
                        <span class="email-text">E-Crepuscular@outlook.com</span>
                    </a>
                </div>

                <!-- ✅ 修改3：explore something random 与上方间距加大 -->
                <div style="margin-top: 120px; margin-bottom: 60px;">
                    <p class="partner-desc" style="margin-bottom: 20px;">Want to explore something random?</p>
                    <div class="explore-buttons" style="display: flex; gap: 16px; flex-wrap: wrap; justify-content: center;">
                        <button id="jumpBtnCN" class="action-button cn-button">
                            <span class="action-icon">🐍</span>
                            <span class="action-text">China Mainland</span>
                        </button>
                        <button id="jumpBtnGlobal" class="action-button global-button">
                            <span class="action-icon">🌍</span>
                            <span class="action-text">Global</span>
                        </button>
                    </div>
                    
                    <div class="villa-icon-below-random" style="margin-top: 100px;">
                        <img src={villav4icon.src} alt="Crepus Villa V4 Icon" class="villa-v4-icon" title="Crepuscular's Villa V4" />
                        <span class="photo-annotation"><br/>i really drew this during the english exam, 3 mar 2026</span>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* ✅ 修改1：CL16 图片占满全宽，无 safe-zone、无 max-width、无左右 padding */
    .cl16-switch-section {
        padding: 60px 0;
        width: 100%;
    }
    .cl16-container {
        position: relative;
        width: 100%;
        aspect-ratio: 21 / 9;
        /* ✅ 移除 border-radius，让图片真正贴边 */
        border-radius: 0;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .cl16-container:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }
    .cl16-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transform: scale(1.01);
    }
    .cl16-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.6));
        z-index: 1;
    }
    .cl16-content {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #ffffff;
        text-align: center;
        user-select: none; 
    }
    .cl16-title {
        font-size: clamp(32px, 5vw, 64px);
        font-weight: 800;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 4px;
        text-shadow: 0 4px 12px rgba(0,0,0,0.3);
    }
    /* ✅ 修改2：cl16-subtitle 样式保留但已从 HTML 中移除，不影响其他元素 */

    /* ✅ 修改3：底部模块间距统一加大 */
    .section-gap {
        padding-top: 160px !important;
    }

    /* Explore Section */
    .action-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 12px 32px;
        height: clamp(48px, 10vw, 80px);
        background: linear-gradient(135deg, #fff 0%, #f5f5f7 100%);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        color: #1d1d1f;
        border: 2px solid rgba(0,0,0,0.05);
        cursor: pointer;
        font-size: inherit;
        font-family: inherit;
        flex: 1;
        min-width: 140px;
        position: relative;
        overflow: hidden;
    }

    .action-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(247, 196, 108, 0.2), rgba(247, 196, 108, 0));
        transition: left 0.3s ease;
    }

    .action-button:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 16px 40px rgba(0,0,0,0.12);
        border-color: rgba(0,0,0,0.1);
    }

    .action-button:hover::before {
        left: 100%;
    }

    .action-button.cn-button:hover {
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: #fff;
    }

    .action-button.global-button:hover {
        background: linear-gradient(135deg, #1d1d1f 0%, #424245 100%);
        color: #fff;
    }

    .action-icon {
        font-size: clamp(20px, 2vw, 28px);
        font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        z-index: 1;
    }

    .action-button:hover .action-icon {
        transform: scale(1.2) rotate(8deg);
    }

    .action-text {
        font-size: clamp(14px, 1.5vw, 18px);
        font-weight: 600;
        transition: color 0.3s ease;
        position: relative;
        z-index: 1;
    }

    @media (prefers-color-scheme: dark) {
        .action-button {
            background: linear-gradient(135deg, #1d1d1f 0%, #2a2a2c 100%);
            color: #f5f5f7;
            border-color: rgba(255,255,255,0.1);
        }
        .action-button:hover {
            background: linear-gradient(135deg, #f5f5f7 0%, #d1d1d6 100%);
            color: #1d1d1f;
        }
    }

    /* Villa V4 Icon Section */
    .villa-v4-icon {
        width: clamp(80px, 15vw, 250px);
        height: auto;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .villa-v4-icon:hover {
        transform: scale(1.05) rotate(2deg);
        box-shadow: 0 12px 32px rgba(0,0,0,0.15);
    }

    @media (prefers-color-scheme: dark) {
        .villa-v4-icon {
            box-shadow: 0 8px 24px rgba(255,255,255,0.1);
        }
        .villa-v4-icon:hover {
            box-shadow: 0 12px 32px rgba(255,255,255,0.15);
        }
    }

    .button-group {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Send Button Style */
    .send-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: auto;
        min-width: 200px;
        flex: 1;
        max-width: 400px;
        height: clamp(48px, 10vw, 80px);
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        text-decoration: none;
        transition: all 0.3s ease;
        color: #1d1d1f;
        cursor: pointer;
        border: none;
        font-size: inherit;
        font-family: inherit;
    }

    .send-button:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0,0,0,0.08);
        background: #1d1d1f;
        color: #fff;
    }

    .send-icon {
        font-size: clamp(24px, 2vw, 32px);
        font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif;
        transition: color 0.3s ease;
    }

    .send-text {
        font-size: clamp(16px, 1.5vw, 20px);
        font-weight: 600;
        transition: color 0.3s ease;
    }

    @media (prefers-color-scheme: dark) {
        .send-button {
            background: #1d1d1f;
            color: #f5f5f7;
        }
        .send-button:hover {
            background: #f5f5f7;
            color: #1d1d1f;
        }
        .send-icon {
            color: #f5f5f7;
        }
    }

    .applications-section {
        padding: 100px 0;
        background: #f5f5f7;
    }

    /* Applications Cards Style */
    .app-card { 
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        padding: 30px 24px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .app-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: rgba(247, 196, 108, 0.1);
        transition: left 0.3s ease;
        z-index: -1;
    }

    .app-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
        border-color: rgba(0, 0, 0, 0.1);
    }

    .app-card:hover::before {
        left: 0;
    }

    .app-card-icon {
        font-size: 48px;
        font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif;
        margin-bottom: 16px;
    }

    .app-card-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #1d1d1f;
        margin: 12px 0;
    }

    .app-card-desc {
        font-size: 0.95rem;
        color: #86868b;
        margin: 12px 0 0 0;
        line-height: 1.6;
    }

    .app-arrow {
        position: absolute;
        top: 24px;
        right: 24px;
        font-size: 20px;
        opacity: 0;
        transition: all 0.3s ease;
    }

    .app-card:hover .app-arrow {
        opacity: 1;
        transform: translate(4px, -4px);
    }

    @media (prefers-color-scheme: dark) {
        .app-card {
            background: rgba(32, 32, 34, 0.5);
            border-color: rgba(255, 255, 255, 0.1);
        }
        .app-card-title {
            color: #f5f5f7;
        }
        .app-card-desc {
            color: #a1a1a6;
        }
        .app-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
        }
        .applications-section {
            background: #000000;
        }
    }

    @keyframes spin {
        0% { transform: rotateY(0deg); }
        100% { transform: rotateY(360deg); }
    }
    
    :root {
        --accent-color: #f7c46c;
        --sub-title-size: clamp(34px, 7vw, 85px); 
    }

    .main-content { background-color: #f5f5f7; overflow-x: hidden; }
    @media (prefers-color-scheme: dark) {
        .main-content { background-color: #000000; }
    }

    /* --- 图片模块样式 --- */
    .photo-gallery-section {
        padding: 15vh var(--safe-area);
        display: flex;
        justify-content: center;
    }

    .gallery-stack {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 2000px;
        gap: 12vh;
    }

    .photo-container {
        display: flex;
        flex-direction: column;
        position: relative;
        &.align-left { align-self: flex-start; }
        &.align-right { align-self: flex-end; }
    }

    .size-s { width: 35vw; min-width: 250px; max-width: 650px; }
    .size-m { width: 45vw; min-width: 300px; max-width: 750px; }
    .size-l { width: 55vw; min-width: 350px; max-width: 850px; }

    .photo-wrapper {
        width: 100%;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }

    .photo-wrapper img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 0;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .photo-container:hover img {
        transform: scale(1.05);
    }

    .photo-annotation {
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #86868b;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .gallery-quote-box {
        margin: 12vh auto;
        text-align: center;
        max-width: 1600px;
        font-family: 'RAGE', cursive;
        font-size: 1.75rem;
    }

    .quote-text {
        font-family: serif;
        font-size: clamp(20px, 3vw, 32px);
        font-style: italic;
        line-height: 1.3;
        margin-bottom: 15px;
        color: #1d1d1f;
    }

    @media (prefers-color-scheme: dark) {
        .quote-text {
            color: #f5f5f7;
        }
    }

    /* --- 原有样式 --- */
    .logo-name { font-family: 'RAGE', cursive; font-size: 48px; font-weight: 600; color: #1d1d1f; }
    .scrolling-text { position: fixed; top: 25%; left: 0; font-size: 15vw; font-weight: 900; color: rgba(247, 196, 108, 0.05); white-space: nowrap; pointer-events: none; z-index: 0; }
    .content-section { min-height: 100vh; display: flex; align-items: center; position: relative; z-index: 1; }
    .hero-title { font-size: clamp(44px, 12vw, 130px); font-weight: 800; line-height: 1.1; }
    .accent-text { color: var(--accent-color); }
    .auto-scroll-section { padding: 100px 0; background: #f5f5f7; overflow: hidden; }
    @media (prefers-color-scheme: dark) {
        .auto-scroll-section { background: #000000; }
    }
    .horizontal-view { display: flex; flex-direction: column; gap: 60px; }
    .partner-sub-title { font-size: var(--sub-title-size); font-weight: 800; line-height: 1; margin: 0; }
    .partner-desc { font-size: clamp(16px, 2vw, 24px); color: #86868b; margin: 0 0 60px 0; font-weight: var(--fw-light); line-height: 1.6; }
    .infinite-scroll-container { width: 100%; overflow: hidden; display: flex; -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); }
    .partner-list { display: flex; gap: 40px; padding: 20px 0; animation: scroll-left 30s linear infinite; width: max-content; }
