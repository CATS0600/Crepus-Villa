---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="DPMBG Application - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 700px; margin: 2rem auto;">
                <div class="lang-switch">
                    <button id="toggleLang" class="action-btn-sm">English / 中文</button>
                </div>

                <h1 style="text-align: center; margin-bottom: 1rem; font-size: 2.4rem;">
                    <span class="lang-zh">🌍 DPMBG 入群申请(Comming Soon)</span>
                    <span class="lang-en">🌍 DPMBG Application(Comming Soon)</span>
                </h1>
                <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">
                    Disaster Prevention and Mitigation Basic Group<br/>
                    <span class="lang-zh">DPMBG - 探索地球科学的美妙之处</span>
                    <span class="lang-en">DPMBG - Exploring the wonders of Earth science</span>
                </p>
                
                <div id="examForm" class="form-container">
                    <form id="applicationForm">
                        <div class="form-group">
                            <label for="username">
                                <span class="lang-zh">昵称/用户名 *</span>
                                <span class="lang-en">Username / Nickname *</span>
                            </label>
                            <input 
                                type="text" id="username" name="username" required maxlength="100"
                                data-zh-placeholder="请输入你的昵称" data-en-placeholder="Enter your nickname"
                            />
                            <small id="usernameCount">0/100</small>
                        </div>

                        <div class="form-group">
                            <label for="social_id">
                                <span class="lang-zh">社交媒体账号/ID *</span>
                                <span class="lang-en">Social Media ID *</span>
                            </label>
                            <input 
                                type="text" id="social_id" name="social_id" required maxlength="100"
                                data-zh-placeholder="如 抖音号 或 @Youtube" data-en-placeholder="e.g. @handle or Discord ID"
                            />
                            <p class="hint-text">
                                <span class="lang-zh">用于核查你的身份</span>
                                <span class="lang-en">Used for identity verification by the admin</span>
                            </p>
                        </div>

                        <div class="form-group">
                            <label for="answers">
                                <span class="lang-zh">请简略阐述你加入DPMBG的理由。 *</span>
                                <span class="lang-en">Please briefly explain your reasons for joining DPMBG. *</span>
                            </label>
                            <textarea 
                                id="answers" name="answers" required rows="8" maxlength="2000"
                                data-zh-placeholder="Start Describe..." data-en-placeholder="Start Describe..."
                            ></textarea>
                            <small id="answersCount">0/2000</small>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="reply_method">
                                    <span class="lang-zh">📧 审核结果回复方式</span>
                                    <span class="lang-en">📧 Reply Method</span>
                                </label>
                                <select id="reply_method" name="reply_method" class="styled-select">
                                    <option value="web">Web / 网页查看</option>
                                    <option value="email">Email / 邮件通知</option>
                                </select>
                            </div>

                            <div class="form-group slide-in" id="emailGroup">
                                <label for="email">
                                    <span class="lang-zh">📬 邮箱地址</span>
                                    <span class="lang-en">📬 Email Address</span>
                                </label>
                                <input type="email" id="email" name="email" placeholder="your@email.com" maxlength="100" />
                            </div>
                        </div>

                        <input type="hidden" id="group_id" name="group_id" value="dpmbg" />
                        <button type="submit" class="submit-btn">
                            <span class="lang-zh">Coming Soon</span>
                            <span class="lang-en">Coming Soon</span>
                        </button>
                    </form>

                    <div id="successMessage" class="success-message" style="display: none;">
                        <h3>
                            <span class="lang-zh">✅ 申请已提交！</span>
                            <span class="lang-en">✅ Submitted Successfully!</span>
                        </h3>
                        <div class="message-content">
                            <p class="lang-zh">感谢你的申请，我们会在 24-48 小时内处理。</p>
                            <p class="lang-en">Thanks for applying. We will review it within 24-48 hours.</p>
                        </div>
                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
                            <button type="button" class="action-btn" onclick="location.reload()">
                                <span class="lang-zh">再次申请</span><span class="lang-en">Apply Again</span>
                            </button>
                            <a href="/" class="action-btn-secondary">
                                <span class="lang-zh">返回首页</span><span class="lang-en">Home</span>
                            </a>
                        </div>
                    </div>

                    <div id="errorMessage" class="error-message" style="display: none;">
                        <p id="errorText"></p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 双语显示逻辑 */
    :root { --lang-zh-display: block; --lang-en-display: none; }
    :global(html[lang="en"]) { --lang-zh-display: none; --lang-en-display: block; }
    .lang-zh { display: var(--lang-zh-display); }
    .lang-en { display: var(--lang-en-display); }

    .main-content { background: var(--bg-color); min-height: 100vh; }
    .lang-switch { display: flex; justify-content: flex-end; margin-bottom: 1rem; }
    .form-container { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem; }
    .form-group { margin-bottom: 1.5rem; }
    
    .form-row { 
        display: grid; 
        grid-template-columns: 1fr; 
        gap: 0; 
        transition: all 0.3s ease;
    }
    
    /* 当邮箱显示时切换为两列 */
    .form-row.has-email { grid-template-columns: 1fr 1fr; gap: 1rem; }

    label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); }
    input, textarea, .styled-select {
        width: 100%; padding: 0.75rem; border: 1px solid var(--card-border);
        border-radius: 8px; background: var(--bg-color); color: var(--text-main);
    }

    .slide-in { 
        opacity: 0; max-height: 0; overflow: hidden; pointer-events: none;
        transition: all 0.3s ease-in-out;
    }
    .slide-in.active { opacity: 1; max-height: 100px; pointer-events: auto; margin-bottom: 1.5rem; }

    .hint-text { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
    .submit-btn { 
        width: 100%; padding: 0.8rem; background: var(--text-main); color: var(--bg-color);
        border: none; border-radius: 8px; font-weight: 600; cursor: pointer;
    }
    .action-btn-sm { padding: 0.4rem 0.8rem; font-size: 0.8rem; border-radius: 6px; border: 1px solid var(--card-border); background: none; color: var(--text-muted); cursor: pointer; }
    .action-btn { background: var(--text-main); color: var(--bg-color); border: none; padding: 0.6rem 1.2rem; border-radius: 6px; cursor: pointer; }
    .action-btn-secondary { border: 1px solid var(--card-border); color: var(--text-main); padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; }
</style>

<script>
    // @ts-nocheck
    const html = document.documentElement;
    const form = document.getElementById('applicationForm');
    const replyMethod = document.getElementById('reply_method');
    const emailGroup = document.getElementById('emailGroup');
    const formRow = document.querySelector('.form-row');
    const langBtn = document.getElementById('toggleLang');

    // 1. 语言切换逻辑
    function updatePlaceholders() {
        const isEn = html.getAttribute('lang') === 'en';
        document.querySelectorAll('input, textarea').forEach(el => {
            const ph = isEn ? el.dataset.enPlaceholder : el.dataset.zhPlaceholder;
            if (ph) el.placeholder = ph;
        });
    }

    langBtn.addEventListener('click', () => {
        const newLang = html.getAttribute('lang') === 'en' ? 'zh' : 'en';
        html.setAttribute('lang', newLang);
        updatePlaceholders();
    });

    // 2. 邮箱输入框优化显示逻辑
    replyMethod.addEventListener('change', () => {
        if (replyMethod.value === 'email') {
            emailGroup.classList.add('active');
            formRow.classList.add('has-email');
            document.getElementById('email').required = true;
        } else {
            emailGroup.classList.remove('active');
            formRow.classList.remove('has-email');
            document.getElementById('email').required = false;
        }
    });

    // 3. 字数统计与提交逻辑 (保持原逻辑并适配多语言报错)
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const isEn = html.getAttribute('lang') === 'en';
        
        // ... 原有的 fetch 逻辑，可根据 isEn 变量定制报错文本 ...
        // 示例：showError(isEn ? "Please fill all fields" : "请填写所有必填字段");
        
        // 此处省略重复的提交代码以保持简洁，逻辑同你原有的脚本
    });

    // 初始化占位符
    updatePlaceholders();
</script>