---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="DPMBG 申请 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 700px; margin: 2rem auto;">
                <h1 style="text-align: center; margin-bottom: 1rem;">🌍 DPMBG 入群申请</h1>
                <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">
                    Disaster Prevention and Mitigation Basic Group<br/>灾害防减基础群 - 探索地球科学的美妙之处
                </p>
                
                <div id="examForm" class="form-container">
                    <form id="applicationForm">
                        <div class="form-group">
                            <label for="username">昵称/用户名 *</label>
                            <input 
                                type="text" 
                                id="username" 
                                name="username" 
                                required 
                                placeholder="请输入你的昵称"
                                maxlength="100"
                            />
                            <small id="usernameCount">0/100</small>
                        </div>

                        <div class="form-group">
                            <label for="social_id">社交媒体账号/ID *</label>
                            <input 
                                type="text" 
                                id="social_id" 
                                name="social_id" 
                                required 
                                placeholder="如 @twitter_handle 或 QQ 号"
                                maxlength="100"
                            />
                            <small id="socialCount">0/100</small>
                            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem;">
                                用于方便群主确认身份
                            </p>
                        </div>

                        <div class="form-group">
                            <label for="answers">致申请者：你为什么想加入 DPMBG？你能为群贡献什么？ *</label>
                            <textarea 
                                id="answers" 
                                name="answers" 
                                required 
                                placeholder="请详细介绍你的动机、兴趣和能力（<1000字）"
                                rows="8"
                                maxlength="2000"
                            ></textarea>
                            <small id="answersCount">0/2000</small>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label for="reply_method">📧 审核结果回复方式</label>
                                <select 
                                    id="reply_method" 
                                    name="reply_method"
                                    style="width: 100%; padding: 0.75rem; border: 1px solid var(--card-border); border-radius: 8px; background: var(--bg-color); color: var(--text-main); font-size: 1rem;"
                                >
                                    <option value="web">网页查看</option>
                                    <option value="email">邮件通知</option>
                                </select>
                            </div>

                            <div class="form-group" id="emailGroup" style="display: none; margin-bottom: 0;">
                                <label for="email">📬 邮箱地址</label>
                                <input 
                                    type="email" 
                                    id="email" 
                                    name="email"
                                    placeholder="your@email.com"
                                    maxlength="100"
                                />
                            </div>
                        </div>

                        <input type="hidden" id="group_id" name="group_id" value="dpmbg" />

                        <button type="submit" class="submit-btn">提交申请</button>
                    </form>

                    <div id="successMessage" class="success-message" style="display: none;">
                        <h3>✅ 申请已提交！</h3>
                        <p style="margin: 1rem 0;">感谢你的申请，我们会尽快审核。</p>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">
                            群主通常在 24-48 小时内完成审核。<br/>
                            请确保你的社交媒体账号信息正确，方便群主找到你。
                        </p>
                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                            <button type="button" class="action-btn" onclick="resetForm()">再次申请</button>
                            <a href="/" class="action-btn" style="text-decoration: none;">返回首页</a>
                        </div>
                    </div>

                    <div id="errorMessage" class="error-message" style="display: none;">
                        <p id="errorText"></p>
                    </div>
                </div>

                <!-- 信息卡片 -->
                <div style="margin-top: 3rem; padding: 2rem; background: var(--card-bg); border-radius: 12px; border: 1px solid var(--card-border);">
                    <h3 style="margin-top: 0;">ℹ️ 关于 DPMBG</h3>
                    <p style="color: var(--text-muted); line-height: 1.8;">
                        DPMBG（Disaster Prevention and Mitigation Basic Group）是致力于探索地球科学和防灾减灾的社区。
                        我们相信知识分享和社区力量能够帮助人们更好地理解和应对自然灾害。
                    </p>
                    <p style="color: var(--text-muted); line-height: 1.8;">
                        加入我们，你将获得：
                    </p>
                    <ul style="color: var(--text-muted); line-height: 1.8;">
                        <li>与志同道合的地球科学爱好者交流</li>
                        <li>获取最新的防灾减灾知识</li>
                        <li>参与群组内的讨论和活动</li>
                        <li>在开放和包容的环境中学习和成长</li>
                    </ul>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .main-content {
        background: var(--bg-color);
        min-height: 100vh;
    }

    .form-container {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-main);
    }

    input[type="text"], textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        font-family: inherit;
        font-size: 1rem;
        background: var(--bg-color);
        color: var(--text-main);
        transition: border-color 0.2s;
    }

    input[type="text"]:focus, textarea:focus {
        outline: none;
        border-color: var(--text-main);
    }

    textarea {
        resize: vertical;
        min-height: 150px;
    }

    small {
        display: block;
        text-align: right;
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem 1.5rem;
        background: var(--text-main);
        color: var(--bg-color);
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .submit-btn:hover {
        opacity: 0.8;
    }

    .submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .success-message, .error-message {
        margin-top: 1.5rem;
        padding: 1.5rem;
        border-radius: 8px;
    }

    .success-message {
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        color: var(--text-main);
    }

    .success-message h3 {
        margin-top: 0;
        color: #22c55e;
    }

    .error-message {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: var(--text-main);
    }

    .action-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: var(--text-main);
        color: var(--bg-color);
        border: none;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .action-btn:hover {
        opacity: 0.8;
    }

    ul {
        padding-left: 1.5rem;
    }

    li {
        margin-bottom: 0.5rem;
    }
</style>

<script>
    const form = document.getElementById('applicationForm');
    const usernameField = document.getElementById('username');
    const socialField = document.getElementById('social_id');
    const answersField = document.getElementById('answers');
    const replyMethodField = document.getElementById('reply_method');
    const emailField = document.getElementById('email');
    const emailGroup = document.getElementById('emailGroup');
    const successMsg = document.getElementById('successMessage');
    const errorMsg = document.getElementById('errorMessage');
    const submitBtn = form.querySelector('button[type="submit"]');

    // 邮箱验证函数
    function validateEmail(email) {
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return re.test(email);
    }

    // 实时字数统计
    usernameField.addEventListener('input', (e) => {
        document.getElementById('usernameCount').textContent = `${e.target.value.length}/100`;
    });

    socialField.addEventListener('input', (e) => {
        document.getElementById('socialCount').textContent = `${e.target.value.length}/100`;
    });

    answersField.addEventListener('input', (e) => {
        document.getElementById('answersCount').textContent = `${e.target.value.length}/2000`;
    });

    // 根据回复方式更新邮箱字段显示
    function updateReplyMethodUI() {
        const method = replyMethodField.value;
        if (method === 'email') {
            emailGroup.style.display = 'block';
            emailField.required = true;
        } else {
            emailGroup.style.display = 'none';
            emailField.required = false;
            emailField.value = '';
        }
    }

    replyMethodField.addEventListener('change', updateReplyMethodUI);

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const username = usernameField.value.trim();
        const social_id = socialField.value.trim();
        const answers = answersField.value.trim();
        const group_id = document.getElementById('group_id').value;
        const reply_method = replyMethodField.value;
        const email = emailField.value.trim();

        // 前端验证
        if (!username || !social_id || !answers) {
            showError('请填写所有必填字段');
            return;
        }

        if (answers.length > 1000) {
            showError('回答内容不能超过 1000 字');
            return;
        }

        // 如果选择邮件回复，验证邮箱
        if (reply_method === 'email') {
            if (!email) {
                showError('请输入邮箱地址');
                return;
            }
            if (!validateEmail(email)) {
                showError('邮箱格式不正确');
                return;
            }
        }

        submitBtn.disabled = true;
        errorMsg.style.display = 'none';

        try {
            const response = await fetch('/api/exam/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    username, 
                    social_id, 
                    answers, 
                    group_id,
                    reply_method,
                    email: reply_method === 'email' ? email : null
                })
            });

            const data = await response.json();

            if (data.success) {
                form.style.display = 'none';
                successMsg.style.display = 'block';
            } else {
                showError(data.error || '提交失败，请重试');
            }
        } catch (error) {
            showError('网络错误，请重试');
            console.error(error);
        }

        submitBtn.disabled = false;
    });

    function showError(message) {
        document.getElementById('errorText').textContent = message;
        errorMsg.style.display = 'block';
    }

    function resetForm() {
        form.reset();
        form.style.display = 'block';
        successMsg.style.display = 'none';
        errorMsg.style.display = 'none';
        document.getElementById('usernameCount').textContent = '0/100';
        document.getElementById('socialCount').textContent = '0/100';
        document.getElementById('answersCount').textContent = '0/2000';
        replyMethodField.value = 'web';
        updateReplyMethodUI();
        usernameField.focus();
    }
</script>
