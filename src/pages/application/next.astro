---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

export const prerender = false;
const country = Astro.request.headers.get('cf-ipcountry') ?? '';
const initialLang = country.toUpperCase() === 'CN' ? 'zh' : 'en';
---

<Layout lang={initialLang} title="Submitted - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 600px; margin: 2rem auto; text-align: center;">
                <div class="form-container" style="padding: 3rem 2rem;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">✅</div>
                    <h1 style="font-size: 2rem; margin-bottom: 1rem;">
                        <span class="lang-zh">一切就绪！</span>
                        <span class="lang-en">You are all set!</span>
                    </h1>
                    <p style="color: var(--text-muted); margin-bottom: 2rem; line-height: 1.6;">
                        <span class="lang-zh">您的答卷已成功提交。考试结果将发送至您填写的邮箱中。</span>
                        <span class="lang-en">Your exam has been submitted successfully. Results will be sent to your email.</span>
                    </p>
                    <p style="margin-bottom: 2rem;">
                        <span class="lang-zh">有任何问题？<br/></span>
                        <span class="lang-en">Have any issues? Turn into me!</span>
                    </p>
                    <a href="https://qm.qq.com/q/Qme3jDzp2G" class="btn-exam btn-exam-outline" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
                        <span class="lang-zh">添加 QQ DM Me</span>
                        <span class="lang-en">Add QQ DM Me</span>
                    </a>
                    <div style="margin-top: 1.5rem;">
                        <a href="/" class="btn-exam btn-exam-outline" style="text-decoration: none;">
                            <span class="lang-zh">返回主页</span>
                            <span class="lang-en">Back to Home</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 双语显示逻辑 */
    :root { --lang-zh-display: block; --lang-en-display: none; }
    :global(html[lang="en"]) { --lang-zh-display: none; --lang-en-display: block; }
    .lang-zh { display: var(--lang-zh-display); }
    .lang-en { display: var(--lang-en-display); }

    .form-container {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        color: #000000;
    }
    @media (prefers-color-scheme: dark) {
        .form-container {
            background: #000000 !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
        }
        .form-container p { color: rgba(255, 255, 255, 0.7) !important; }
        .form-container h1 { color: #ffffff !important; }
    }
    .btn-exam {
        padding: 0.6rem 1.5rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        display: inline-block;
        text-align: center;
        box-sizing: border-box;
    }
    .btn-exam-outline {
        background: transparent;
        border: 1px solid #d1d5db;
        color: #000000;
    }
    .btn-exam-outline:hover { background: rgba(0, 0, 0, 0.05); }
    @media (prefers-color-scheme: dark) {
        .btn-exam-outline {
            border-color: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
        }
        .btn-exam-outline:hover { background: rgba(255, 255, 255, 0.05) !important; }
    }
</style>
