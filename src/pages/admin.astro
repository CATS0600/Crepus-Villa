---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="CORE SYSTEM - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <div class="scrolling-text">CORE SYSTEM ADMIN</div>

        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 40px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">DENIED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="INPUT SU PWD" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">INITIALIZE SYSTEM</span>
                        </button>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="button-group horizontal-tabs">
                        <button class="action-button active-tab" id="tab-send" onclick="switchTab('send')">
                            <span class="action-icon">📬</span>
                            <span class="action-text">MESSAGES</span>
                        </button>
                        <button class="action-button" id="tab-exam" onclick="switchTab('exam')">
                            <span class="action-icon">📝</span>
                            <span class="action-text">ENROLLMENT</span>
                        </button>
                    </div>

                    <div id="sendPanel" class="tab-content">
                        <div id="messagesList" class="admin-stack">
                            </div>
                    </div>

                    <div id="examPanel" class="tab-content" style="display: none;">
                        <div class="filter-row" style="margin-bottom: 25px;">
                            <select id="groupFilter" onchange="loadApplications()" class="admin-select">
                                <option value="all">ALL GROUPS</option>
                                <option value="dpmbg">DPMBG ONLY</option>
                            </select>
                        </div>
                        <div id="applicationsList" class="admin-stack">
                            </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .main-content { background-color: #f5f5f7; min-height: 100vh; padding-top: 100px; position: relative; }
    @media (prefers-color-scheme: dark) { .main-content { background-color: #000000; } }
    
    .scrolling-text { position: fixed; top: 15%; left: 0; font-size: 12vw; font-weight: 900; color: rgba(247, 196, 108, 0.03); white-space: nowrap; pointer-events: none; z-index: 0; }

    .horizontal-tabs { display: flex !important; flex-direction: row !important; gap: 20px; margin-bottom: 50px; justify-content: center; }

    /* 按钮化条目样式 */
    .item-entry-btn {
        width: 100%; display: flex; align-items: center; justify-content: space-between;
        padding: 22px 30px; background: #fff;
        border-radius: 20px; border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer; text-align: left;
    }
    .item-entry-btn:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); border-color: var(--accent-color); }
    
    .entry-title { font-size: 1.1rem; font-weight: 700; color: #1d1d1f; }
    .status-pill { padding: 6px 12px; border-radius: 10px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .status-pending { background: #fffbeb; color: #b45309; }
    .status-complete { background: #f0fdf4; color: #15803d; }
    .status-archived { background: #f1f5f9; color: #475569; }

    /* 分割线 */
    .msg-divider { height: 1px; background: rgba(0,0,0,0.05); margin: 20px 40px; }

    /* 信息块样式 */
    .detail-fold { display: none; padding: 25px; margin: -10px 10px 30px 10px; background: rgba(255,255,255,0.6); backdrop-filter: blur(20px); border-radius: 0 0 24px 24px; border: 1px solid rgba(0,0,0,0.05); }
    .info-block { background: #fff; border-radius: 16px; padding: 20px; margin-bottom: 12px; border: 1px solid rgba(0,0,0,0.03); }
    .info-label { font-size: 10px; font-weight: 800; color: #86868b; margin-bottom: 8px; display: block; text-transform: uppercase; }
    .admin-textarea { width: 100%; background: transparent; border: none; font-family: inherit; font-size: 1rem; font-weight: 600; outline: none; resize: vertical; color: #1d1d1f; }

    .ops-row { display: flex; gap: 10px; margin-top: 20px; }
    .btn-sync { flex: 2; padding: 18px; border-radius: 14px; background: #1d1d1f; color: #fff; border: none; font-weight: 700; cursor: pointer; transition: 0.3s; }
    .btn-delete { flex: 1; padding: 18px; border-radius: 14px; background: rgba(255, 69, 58, 0.1); color: #ff453a; border: 1px solid #ff453a; font-weight: 700; cursor: pointer; transition: 0.3s; }
    .btn-delete:hover { background: #ff453a; color: #fff; }

    .active-tab { background: #1d1d1f !important; color: #fff !important; }

    @media (prefers-color-scheme: dark) {
        .item-entry-btn, .info-block { background: #1c1c1e; border-color: rgba(255,255,255,0.05); }
        .entry-title, .admin-textarea { color: #f5f5f7; }
        .detail-fold { background: rgba(28,28,30,0.8); }
        .msg-divider { background: rgba(255,255,255,0.05); }
        .active-tab { background: #f5f5f7 !important; color: #1d1d1f !important; }
        .btn-sync { background: #f5f5f7; color: #1d1d1f; }
    }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    // --- 登录验证 ---
    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const msgBuffer = new TextEncoder().encode(input.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashed = Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
        
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else {
            alert("ACCESS DENIED");
        }
    }

    // --- Tab 切换 ---
    window.switchTab = function(tabName) {
        document.getElementById('tab-send').classList.toggle('active-tab', tabName === 'send');
        document.getElementById('tab-exam').classList.toggle('active-tab', tabName === 'exam');
        document.getElementById('sendPanel').style.display = tabName === 'send' ? 'block' : 'none';
        document.getElementById('examPanel').style.display = tabName === 'exam' ? 'block' : 'none';
        
        if (tabName === 'send') loadMessages();
        else window.loadApplications(); // 显式调用挂载在 window 上的方法
    }

    // --- 留言列表加载 ---
    window.loadMessages = async function() {
        const container = document.getElementById('messagesList');
        try {
            const response = await fetch('/api/admin', { headers: { 'X-Admin-Token': adminToken } });
            const data = await response.json();
            const order = { 'PENDING': 0, 'COMPLETE': 1, 'ARCHIVED': 2 };
            const sorted = (data.messages || []).sort((a, b) => order[a.type] - order[b.type]);

            container.innerHTML = sorted.map((msg, index) => `
                <div class="msg-unit">
                    <button class="item-entry-btn" onclick="toggleFold(${msg.id})">
                        <div class="entry-info">
                            <span class="entry-title">${escapeHtml(msg.title || 'UNTITLED')}</span>
                        </div>
                        <span class="status-pill status-${(msg.type || 'PENDING').toLowerCase()}">${msg.type || 'PENDING'}</span>
                    </button>
                    
                    <div id="fold-${msg.id}" class="detail-fold">
                        <div class="info-block"><span class="info-label">Title</span><input id="in-title-${msg.id}" class="admin-textarea" value="${escapeHtml(msg.title || '')}" /></div>
                        <div class="info-block"><span class="info-label">Content</span><textarea id="in-content-${msg.id}" class="admin-textarea">${escapeHtml(msg.content || '')}</textarea></div>
                        <div class="info-block"><span class="info-label">Reply</span><textarea id="in-reply-${msg.id}" class="admin-textarea" style="color:#0071e3" placeholder="Waiting for reply...">${escapeHtml(msg.reply || '')}</textarea></div>
                        <div class="info-block">
                            <span class="info-label">Status</span>
                            <select id="in-type-${msg.id}" class="admin-textarea" style="background:transparent; cursor:pointer;">
                                <option value="PENDING" ${msg.type === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                <option value="COMPLETE" ${msg.type === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                                <option value="ARCHIVED" ${msg.type === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                            </select>
                        </div>
                        <div class="ops-row">
                            <button class="btn-sync" onclick="updateMessage(${msg.id})">UPDATE UNIT</button>
                            <button class="btn-delete" onclick="deleteData('send', ${msg.id})">DELETE</button>
                        </div>
                    </div>
                    ${index !== sorted.length - 1 ? '<div class="msg-divider"></div>' : ''}
                </div>
            `).join('');
        } catch (e) { container.innerHTML = '<p>FETCH ERROR</p>'; }
    }

    // --- 申请加载 (修复 ReferenceError) ---
    window.loadApplications = async function() {
        const group = document.getElementById('groupFilter').value;
        const url = group === 'all' ? '/api/exam/admin' : `/api/exam/admin?group=${group}`;
        const container = document.getElementById('applicationsList');
        try {
            const res = await fetch(url, { headers: { 'X-Admin-Token': adminToken } });
            if (!res.ok) throw new Error();
            const data = await res.json();
            container.innerHTML = (data.applications || []).map(app => `
                <div class="info-block" style="border: 1px solid rgba(0,0,0,0.05);">
                    <div style="display:flex; justify-content:space-between; margin-bottom:15px;">
                        <span style="font-weight:800; font-size:1.2rem;">${escapeHtml(app.username)}</span>
                        <span class="status-pill status-pending">${app.status}</span>
                    </div>
                    <div class="info-block" style="background:rgba(0,0,0,0.02); font-size:13px; white-space: pre-wrap;">${escapeHtml(app.answers)}</div>
                    <div class="ops-row">
                        <button class="btn-sync" style="background:#22c55e" onclick="updateStatus(${app.id}, 'approved')">APPROVE</button>
                        <button class="btn-delete" style="background:rgba(255,69,58,0.1)" onclick="updateStatus(${app.id}, 'rejected')">REJECT</button>
                    </div>
                </div>
            `).join('') || '<p style="text-align:center; padding:50px;">NO APPLICATIONS FOUND</p>';
        } catch (e) { container.innerHTML = '<p>ERROR: UNABLE TO LOAD EXAMS</p>'; }
    }

    // --- 其他功能函数 ---
    window.toggleFold = function(id) {
        const fold = document.getElementById(`fold-${id}`);
        const isVisible = fold.style.display === 'block';
        document.querySelectorAll('.detail-fold').forEach(f => f.style.display = 'none');
        fold.style.display = isVisible ? 'none' : 'block';
    }

    window.updateMessage = async function(id) {
        const payload = {
            id,
            title: document.getElementById(`in-title-${id}`).value,
            type: document.getElementById(`in-type-${id}`).value,
            content: document.getElementById(`in-content-${id}`).value,
            reply: document.getElementById(`in-reply-${id}`).value
        };
        await fetch('/api/admin', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify(payload)
        });
        loadMessages();
    }

    window.deleteData = async function(type, id) {
        if (!confirm("PERMANENTLY DELETE THIS UNIT?")) return;
        const endpoint = type === 'send' ? '/api/admin' : '/api/exam/admin';
        await fetch(endpoint, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify({ id })
        });
        type === 'send' ? loadMessages() : loadApplications();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    // 页面初始化
    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('adminToken') === TARGET_HASH) {
            adminToken = TARGET_HASH;
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });
</script>