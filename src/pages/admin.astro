---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="CORE SYSTEM - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <div class="scrolling-text">CORE SYSTEM ADMIN</div>

        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 40px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">DENIED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="INPUT SU PWD" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">INITIALIZE SYSTEM</span>
                        </button>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="button-group horizontal-tabs">
                        <button class="action-button active-tab" id="tab-send" onclick="switchTab('send')">
                            <span class="action-icon">📬</span>
                            <span class="action-text">MESSAGES</span>
                        </button>
                        <button class="action-button" id="tab-exam" onclick="switchTab('exam')">
                            <span class="action-icon">📝</span>
                            <span class="action-text">ENROLLMENT</span>
                        </button>
                    </div>

                    <div id="sendPanel" class="tab-content">
                        <div id="messagesList" class="admin-stack">
                            </div>
                    </div>

                    <div id="examPanel" class="tab-content" style="display: none;">
                        <div class="filter-row" style="margin-bottom: 25px;">
                            <select id="groupFilter" onchange="loadApplications()" class="admin-select">
                                <option value="all">ALL GROUPS</option>
                                <option value="dpmbg">DPMBG ONLY</option>
                            </select>
                        </div>
                        <div id="applicationsList" class="admin-stack">
                            </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 基础容器 */
    .main-content { background-color: #f5f5f7; min-height: 100vh; padding-top: 100px; position: relative; }
    @media (prefers-color-scheme: dark) { .main-content { background-color: #000000; } }
    .scrolling-text { position: fixed; top: 15%; left: 0; font-size: 12vw; font-weight: 900; color: rgba(247, 196, 108, 0.03); white-space: nowrap; pointer-events: none; z-index: 0; }

    /* 横排 Tabs */
    .horizontal-tabs { 
        display: flex !important; 
        flex-direction: row !important; 
        gap: 20px; 
        margin-bottom: 50px; 
        justify-content: center;
        flex-wrap: nowrap;
    }

    /* 按钮化条目 */
    .item-entry-btn {
        width: 100%; display: flex; align-items: center; justify-content: space-between;
        padding: 22px 30px; margin-bottom: 15px; background: #fff;
        border-radius: 20px; border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer; text-align: left;
    }
    .item-entry-btn:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
    
    .entry-title { font-size: 1.1rem; font-weight: 700; color: #1d1d1f; }
    .status-pill { padding: 6px 12px; border-radius: 10px; font-size: 10px; font-weight: 800; }
    .status-pending { background: #fffbeb; color: #b45309; }
    .status-complete { background: #f0fdf4; color: #15803d; }

    /* 信息块按钮化展示 */
    .detail-fold {
        display: none; /* 默认隐藏 */
        padding: 25px; margin: -10px 10px 30px 10px;
        background: rgba(255,255,255,0.6); backdrop-filter: blur(20px);
        border-radius: 0 0 24px 24px; border: 1px solid rgba(0,0,0,0.05);
    }
    .info-block {
        background: #fff; border-radius: 16px; padding: 20px; margin-bottom: 12px;
        border: 1px solid rgba(0,0,0,0.03); transition: 0.3s;
    }
    .info-label { font-size: 10px; font-weight: 800; color: #86868b; margin-bottom: 8px; display: block; }
    .admin-textarea { 
        width: 100%; background: transparent; border: none; font-family: inherit;
        font-size: 1rem; font-weight: 600; outline: none; resize: vertical;
    }

    /* 按钮样式补丁 */
    .active-tab { background: #1d1d1f !important; color: #fff !important; }
    .btn-sync { width: 100%; padding: 18px; border-radius: 14px; background: #1d1d1f; color: #fff; border: none; font-weight: 700; cursor: pointer; }

    @media (prefers-color-scheme: dark) {
        .item-entry-btn, .info-block { background: #1c1c1e; border-color: rgba(255,255,255,0.05); }
        .entry-title, .admin-textarea { color: #f5f5f7; }
        .detail-fold { background: rgba(28,28,30,0.8); }
        .active-tab { background: #f5f5f7 !important; color: #1d1d1f !important; }
        .btn-sync { background: #f5f5f7; color: #1d1d1f; }
    }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    // 核心切换逻辑
    window.switchTab = function(tabName) {
        document.getElementById('tab-send').classList.toggle('active-tab', tabName === 'send');
        document.getElementById('tab-exam').classList.toggle('active-tab', tabName === 'exam');
        document.getElementById('sendPanel').style.display = tabName === 'send' ? 'block' : 'none';
        document.getElementById('examPanel').style.display = tabName === 'exam' ? 'block' : 'none';
        tabName === 'send' ? loadMessages() : loadApplications();
    }

    // 手风琴折叠修复
    window.toggleFold = function(id) {
        const fold = document.getElementById(`fold-${id}`);
        const allFolds = document.querySelectorAll('.detail-fold');
        const isCurrentlyVisible = fold.style.display === 'block';

        // 先全部关闭
        allFolds.forEach(f => f.style.display = 'none');
        // 如果之前是隐藏的，则打开
        if (!isCurrentlyVisible) {
            fold.style.display = 'block';
        }
    }

    // 登录校验
    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const msgBuffer = new TextEncoder().encode(input.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashed = Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
        
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else {
            alert("ACCESS DENIED");
        }
    }

    // 加载留言
    window.loadMessages = async function() {
        const container = document.getElementById('messagesList');
        try {
            const response = await fetch('/api/admin', { headers: { 'X-Admin-Token': adminToken } });
            const data = await response.json();
            const order = { 'PENDING': 0, 'COMPLETE': 1, 'ARCHIVED': 2 };
            const sorted = (data.messages || []).sort((a, b) => order[a.type] - order[b.type]);

            container.innerHTML = sorted.map(msg => `
                <div class="msg-unit">
                    <button class="item-entry-btn" onclick="toggleFold(${msg.id})">
                        <div class="entry-info">
                            <span class="entry-title">${escapeHtml(msg.title || 'UNTITLED')}</span>
                        </div>
                        <span class="status-pill status-${(msg.type || 'PENDING').toLowerCase()}">${msg.type || 'PENDING'}</span>
                    </button>
                    <div id="fold-${msg.id}" class="detail-fold">
                        <div class="info-block"><span class="info-label">Title</span><input id="in-title-${msg.id}" class="admin-textarea" value="${escapeHtml(msg.title || '')}" /></div>
                        <div class="info-block"><span class="info-label">Content</span><textarea id="in-content-${msg.id}" class="admin-textarea">${escapeHtml(msg.content || '')}</textarea></div>
                        <div class="info-block"><span class="info-label">Reply</span><textarea id="in-reply-${msg.id}" class="admin-textarea" style="color:#0071e3">${escapeHtml(msg.reply || '')}</textarea></div>
                        <div class="info-block">
                            <span class="info-label">Status</span>
                            <select id="in-type-${msg.id}" class="admin-textarea" style="background:transparent">
                                <option value="PENDING" ${msg.type === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                <option value="COMPLETE" ${msg.type === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                            </select>
                        </div>
                        <button class="btn-sync" onclick="updateMessage(${msg.id})">UPDATE UNIT</button>
                    </div>
                </div>
            `).join('');
        } catch (e) { console.error(e); }
    }

    // 初始化检查
    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('adminToken') === TARGET_HASH) {
            adminToken = TARGET_HASH;
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // 这里的 updateMessage, loadApplications 等函数保持之前的逻辑...
</script>