---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="CORE SYSTEM - ADMIN">
    <Header />
    
    <main class="main-content">
        <div class="scrolling-text">CORE SYSTEM ADMIN</div>

        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 950px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <!-- 权限验证密码框 -->
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 60px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">REQUIRED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="ENTER SYSTEM KEY" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">AUTHENTICATE</span>
                        </button>
                    </div>
                </div>

                <!-- 管理后台面板 -->
                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="horizontal-tabs">
                        <button class="tab-btn active" id="tab-send" onclick="switchTab('send')">MESSAGES</button>
                        <button class="tab-btn" id="tab-exam" onclick="switchTab('exam')">EXAM RECORDS</button>
                    </div>

                    <!-- 信件/消息选项卡 -->
                    <div id="panel-send" class="admin-tab-content">
                        <h3 class="partner-sub-title">MESSAGE <span class="accent-text">ARCHIVES</span></h3>
                        <div id="messageList" class="records-grid">
                            <p class="status-placeholder">LOADING ARCHIVES...</p>
                        </div>
                    </div>

                    <!-- 考试/准入双向审计选项卡 -->
                    <div id="panel-exam" class="admin-tab-content" style="display: none;">
                        <h3 class="partner-sub-title">EXAMINATION <span class="accent-text">AUDITS</span></h3>
                        <div id="examList" class="records-grid">
                            <p class="status-placeholder">LOADING EXAM RECORD DATA...</p>
                        </div>
                    </div>

                </div>

            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    // 匹配后端的 SHA-256 密文
    const TARGET_HASH = "6524aa49a54679d4e6a2234633fb9b23e33a2ed8724cbf887f0204098b6fd803";
    let adminToken = "";

    // Web Crypto API: 生成不可逆的 SHA-256 哈希
    async function sha256(string) {
        const utf8 = new TextEncoder().encode(string);
        const hashBuffer = await crypto.subtle.digest('SHA-256', utf8);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function authenticate() {
        const input = document.getElementById('adminPassword').value;
        const encoded = await sha256(input);
        
        if (encoded === TARGET_HASH) {
            sessionStorage.setItem('adminToken', encoded);
            adminToken = encoded;
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            alert("ACCESS DENIED: INVALID KEY");
        }
    }

    function switchTab(type) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.admin-tab-content').forEach(p => p.style.display = 'none');
        
        document.getElementById(`tab-${type}`).classList.add('active');
        document.getElementById(`panel-${type}`).style.display = 'block';
    }

    async function loadMessages() {
        try {
            const res = await fetch('/api/get-messages', {
                headers: { 'X-Admin-Token': adminToken }
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            
            const list = document.getElementById('messageList');
            if (!data.length) {
                list.innerHTML = `<p class="status-placeholder">NO ARCHIVED MESSAGES</p>`;
                return;
            }

            list.innerHTML = data.map(item => `
                <div class="record-card">
                    <div class="record-meta">
                        <span>ID: #${item.id}</span>
                        <span>SENDER: ${escapeHtml(item.username)}</span>
                    </div>
                    <div class="record-body">
                        <p>${escapeHtml(item.message)}</p>
                    </div>
                    <div class="record-footer">
                        <span>TIME: ${new Date(item.created_at).toLocaleString()}</span>
                        <button onclick="deleteData('send', ${item.id})" class="delete-btn">DELETE</button>
                    </div>
                </div>
            `).join('');
        } catch (e) {
            document.getElementById('messageList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING MESSAGES</p>`;
        }
    }

    async function loadApplications() {
        try {
            const res = await fetch('/api/exam/admin', {
                headers: { 'X-Admin-Token': adminToken }
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            
            const list = document.getElementById('examList');
            if (!data.length) {
                list.innerHTML = `<p class="status-placeholder">NO EXAM RECORDS IN D1</p>`;
                return;
            }

            list.innerHTML = data.map(item => {
                const isAchtung = item.achtung_notes && item.achtung_notes.includes('[ACHTUNG]');
                const cardClass = isAchtung ? 'record-card achtung-alert-card' : 'record-card';

                let answersHtml = '';
                if (item.answers) {
                    try {
                        const parsed = JSON.parse(item.answers);
                        answersHtml = `
                            <div class="exam-answers-details">
                                <span class="toggle-answers" onclick="this.nextElementSibling.classList.toggle('active')">查看完整试卷与简答 &darr;</span>
                                <div class="answers-content">
                                    <p><strong>选择 Q1:</strong> ${escapeHtml(parsed.q1 || '未填')}</p>
                                    <p><strong>选择 Q2:</strong> ${escapeHtml(parsed.q2 || '未填')}</p>
                                    <p><strong>选择 Q3:</strong> ${escapeHtml(parsed.q3 || '未填')}</p>
                                    <p><strong>选择 Q4:</strong> ${escapeHtml(parsed.q4 || '未填')}</p>
                                    <p><strong>选择 Q5:</strong> ${escapeHtml(parsed.q5 || '未填')}</p>
                                    <div class="essay-answer-box">
                                        <strong>Q6 简答内容:</strong>
                                        <p class="essay-text">${escapeHtml(parsed.essay || '未填')}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                    } catch (e) {
                        answersHtml = `<p class="text-error">答卷结构损坏: ${escapeHtml(item.answers)}</p>`;
                    }
                }

                return `
                    <div class="${cardClass}">
                        <div class="record-meta">
                            <span>ID: #${item.id}</span>
                            <span>QQID: <strong class="highlight-text">${item.qqid}</strong></span>
                            <span>第 <strong class="highlight-text">${item.exam_times}</strong> 次考试</span>
                        </div>
                        <div class="record-body">
                            <div class="exam-score-box">
                                客观题得分: <span class="score-num">${item.exam_result}</span> / 100 分
                            </div>
                            
                            ${answersHtml}

                            ${isAchtung ? `
                                <div class="achtung-tag">
                                    WARNING: ${escapeHtml(item.achtung_notes)}
                                </div>
                            ` : ''}

                            <div class="uuid-footprint">
                                设备 UUID: <span>${escapeHtml(item.user_uuid)}</span>
                            </div>
                        </div>
                        <div class="record-footer">
                            <span>提交时间: ${new Date(item.created_at).toLocaleString()}</span>
                            <button onclick="deleteData('exam', ${item.id})" class="delete-btn">DELETE</button>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) {
            document.getElementById('examList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING EXAM ARCHIVES</p>`;
        }
    }

    window.deleteData = async function(type, id) {
        if (!confirm("CONFIRM DATA DELETION? \n此操作直接作用于 Cloudflare D1 数据库且无法恢复。")) return;
        try {
            await fetch(type === 'send' ? '/api/admin' : '/api/exam/admin', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ id })
            });
            type === 'send' ? loadMessages() : loadApplications();
        } catch (err) {
            alert('删除异常，请检查权限。');
        }
    }

    function escapeHtml(t) { 
        if(!t) return '';
        const d = document.createElement('div'); 
        d.textContent = t; 
        return d.innerHTML; 
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('adminToken') === TARGET_HASH) {
            adminToken = TARGET_HASH;
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });
</script>

<style>
    .horizontal-tabs { display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 1px solid #222; padding-bottom: 15px; }
    .tab-btn { background: transparent; border: 1px solid #333; color: #777; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-family: monospace; letter-spacing: 1px; transition: all 0.2s ease; }
    .tab-btn.active, .tab-btn:hover { border-color: #00ff66; color: #fff; background: rgba(0, 255, 102, 0.03); }
    .records-grid { display: flex; flex-direction: column; gap: 20px; margin-top: 20px; }
    .record-card { background: rgba(10, 10, 10, 0.8); border: 1px solid #222; border-radius: 6px; padding: 20px; transition: border-color 0.2s ease; }
    .record-card:hover { border-color: #444; }
    .record-card.achtung-alert-card { border: 1px solid rgba(255, 95, 86, 0.4); background: rgba(255, 95, 86, 0.02); box-shadow: inset 0 0 10px rgba(255, 95, 86, 0.05); }
    .record-card.achtung-alert-card:hover { border-color: rgba(255, 95, 86, 0.8); }
    .record-meta { display: flex; justify-content: space-between; font-size: 11px; font-family: monospace; color: #555; border-bottom: 1px solid #1a1a1a; padding-bottom: 10px; margin-bottom: 15px; }
    .highlight-text { color: #00ff66; }
    .record-body { color: #ccc; font-size: 14px; line-height: 1.6; }
    .record-footer { display: flex; justify-content: space-between; align-items: center; font-size: 11px; font-family: monospace; color: #555; border-top: 1px solid #1a1a1a; padding-top: 10px; margin-top: 15px; }
    .delete-btn { background: transparent; border: 1px solid rgba(255,95,86,0.2); color: #ff5f56; padding: 4px 10px; border-radius: 4px; font-size: 10px; cursor: pointer; font-family: monospace; transition: all 0.2s ease; }
    .delete-btn:hover { background: #ff5f56; color: #000; border-color: #ff5f56; }
    .status-placeholder { text-align: center; padding: 40px; color: #555; font-family: monospace; }
    .exam-score-box { font-size: 15px; margin-bottom: 15px; color: #eee; }
    .score-num { color: #00ff66; font-weight: bold; font-family: monospace; }
    .achtung-tag { background: rgba(255, 95, 86, 0.1); border: 1px solid rgba(255, 95, 86, 0.2); color: #ff5f56; font-family: monospace; padding: 8px 12px; border-radius: 4px; font-size: 11px; margin: 15px 0; }
    .uuid-footprint { font-family: monospace; font-size: 10px; color: #444; margin-top: 10px; }
    .uuid-footprint span { color: #666; }
    .exam-answers-details { margin: 15px 0; }
    .toggle-answers { font-size: 11px; color: #00ff66; font-family: monospace; cursor: pointer; text-decoration: underline; user-select: none; }
    .answers-content { display: none; margin-top: 10px; background: #080808; border: 1px solid #161616; padding: 15px; border-radius: 4px; font-size: 12px; color: #999; }
    .answers-content.active { display: block; animation: slideDown 0.2s ease; }
    .answers-content p { margin-bottom: 6px; }
    .essay-answer-box { margin-top: 12px; border-top: 1px dashed #222; padding-top: 10px; }
    .essay-text { background: rgba(255,255,255,0.01); padding: 10px; border-radius: 4px; margin-top: 5px; color: #eee; line-height: 1.5; font-family: sans-serif; }
    .text-error { color: #ff5f56; font-family: monospace; font-size: 11px; }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
</style>