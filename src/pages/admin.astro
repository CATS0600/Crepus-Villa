---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout lang="en" title="Core System Admin - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 950px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 60px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">REQUIRED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="ENTER SYSTEM KEY" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">AUTHENTICATE</span>
                        </button>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="horizontal-tabs">
                        <button class="tab-btn active" id="tab-send" onclick="switchTab('send')">MESSAGES</button>
                        <button class="tab-btn" id="tab-exam" onclick="switchTab('exam')">EXAM RECORDS</button>
                    </div>

                    <div id="panel-send" class="admin-tab-content">
                        <h3 class="partner-sub-title">MESSAGE <span class="accent-text">ARCHIVES</span></h3>
                        <div id="messageList" class="records-grid">
                            <p class="status-placeholder">LOADING ARCHIVES...</p>
                        </div>
                    </div>

                    <div id="panel-exam" class="admin-tab-content" style="display: none;">
                        <h3 class="partner-sub-title">EXAMINATION <span class="accent-text">AUDITS</span></h3>
                        <div id="examList" class="records-grid">
                            <p class="status-placeholder">LOADING EXAM RECORD DATA...</p>
                        </div>
                    </div>

                </div>

            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    async function authenticate() {
        const input = document.getElementById('adminPassword').value;
        const response = await fetch('/api/auth/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ password: input })
        });

        if (response.ok) {
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            alert("ACCESS DENIED: INVALID KEY");
        }
    }

    function switchTab(type) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.admin-tab-content').forEach(p => p.style.display = 'none');
        
        document.getElementById(`tab-${type}`).classList.add('active');
        document.getElementById(`panel-${type}`).style.display = 'block';
    }

    async function loadMessages() {
        try {
            const res = await fetch('/api/get-messages', { credentials: 'same-origin' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            const messages = data.messages || data;

            const list = document.getElementById('messageList');
            if (!messages.length) {
                list.innerHTML = `<p class="status-placeholder">NO ARCHIVED MESSAGES</p>`;
                return;
            }

                    list.innerHTML = messages.map(item => {
                const statusVal = item.status || 'PENDING';
                const pubChecked = item.is_public ? 'checked' : '';
                return `
                <div class="record-card status-${statusVal.toLowerCase()}">
                    <div class="record-meta">
                        <span>TIME: ${new Date(item.created_at).toLocaleString()}</span>
                        <span>ID: #${item.id}</span>
                        <span>STATUS: <strong class="status-badge status-${statusVal.toLowerCase()}">${statusVal}</strong></span>
                    </div>
                    
                    <div class="record-body" style="margin-top: 10px;">
                        <div style="font-size: 12px; color: #666; margin-bottom: 8px; font-family: monospace; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                            <label>TITLE: <input type="text" id="rtitle-${item.id}" value="${escapeHtml(item.title || '')}" class="admin-edit-input" style="width:120px;" placeholder="Untitled" /></label>
                            <label>REPLY METHOD: 
                                <select id="rmethod-${item.id}" class="admin-edit-select">
                                    <option value="web" ${item.reply_method === 'web' ? 'selected' : ''}>Web</option>
                                    <option value="email" ${item.reply_method === 'email' ? 'selected' : ''}>Email</option>
                                </select>
                            </label>
                            <label>STATUS: 
                                <select id="rstatus-${item.id}" class="admin-edit-select">
                                    <option value="PENDING" ${statusVal === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                    <option value="COMPLETED" ${statusVal === 'COMPLETED' ? 'selected' : ''}>COMPLETED</option>
                                    <option value="ARCHIVED" ${statusVal === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                                </select>
                            </label>
                            <label style="display:flex;align-items:center;gap:4px;">
                                <input type="checkbox" id="rpublic-${item.id}" ${pubChecked} />
                                PUBLIC
                            </label>
                            ${item.email ? `<span>| EMAIL: <span style="color: #aaa;">${escapeHtml(item.email)}</span></span>` : ''}
                            ${item.token ? `<span>| TOKEN: <span style="color: #444;">${escapeHtml(item.token)}</span></span>` : ''}
                        </div>

                        <div style="background: rgba(255,255,255,0.02); border: 1px solid #1a1a1a; padding: 12px; border-radius: 4px; margin-bottom: 10px;">
                            <span style="font-size: 11px; color: #555; display: block; font-family: monospace; margin-bottom: 4px;">MESSAGE:</span>
                            <textarea id="rcontent-${item.id}" class="admin-edit-textarea">${escapeHtml(item.content)}</textarea>
                        </div>

                        <div style="background: rgba(0, 255, 102, 0.02); border: 1px solid rgba(0, 255, 102, 0.05); padding: 12px; border-radius: 4px;">
                            <span style="font-size: 11px; color: #348a53; display: block; font-family: monospace; margin-bottom: 4px;">REPLY:</span>
                            <textarea id="rreply-${item.id}" class="admin-edit-textarea" style="color:#00ff66;">${item.reply ? escapeHtml(item.reply) : ''}</textarea>
                        </div>
                    </div>

                    <div class="record-footer" style="margin-top: 15px; border-top: 1px solid #1a1a1a; padding-top: 10px; display: flex; justify-content: flex-end; gap: 10px;">
                        <button onclick="updateMessage(${item.id})" class="update-btn">UPDATE</button>
                        <button onclick="deleteData('send', ${item.id})" class="delete-btn">DELETE</button>
                    </div>
                </div>`;
            }).join('');
        } catch (e) {
            document.getElementById('messageList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING MESSAGES</p>`;
        }
    }

    async function loadApplications() {
        try {
            const res = await fetch('/api/exam/admin', { credentials: 'same-origin' });
            if (!res.ok) throw new Error();
            const data = await res.json();
            
            const list = document.getElementById('examList');
            if (!data.length) {
                list.innerHTML = `<p class="status-placeholder">NO EXAM RECORDS IN D1</p>`;
                return;
            }

            let dismissedIds = [];
            try { dismissedIds = JSON.parse(localStorage.getItem('admin_dismissed_warnings') || '[]'); } catch(e) {}
            const isDismissed = (id) => dismissedIds.includes(id);

            let filtered = data.filter(item => {
                if (isDismissed(item.id)) return false;
                return true;
            });

            filtered.sort((a, b) => (a.is_noted ? 1 : 0) - (b.is_noted ? 1 : 0));

            list.innerHTML = filtered.map(item => {
                const isAchtung = item.achtung_notes && item.achtung_notes.includes('[ACHTUNG]');
                const notedClass = item.is_noted ? 'status-noted' : '';
                const cardClass = isAchtung ? `record-card achtung-alert-card ${notedClass}` : `record-card ${notedClass}`;

                let metaNoted = item.is_noted ? `<span class="noted-badge">已标记</span>` : '';

                let infoHtml = '';
                if (item.basicInfo || item.comparison) {
                    let basic = item.basicInfo || {};
                    let comp = item.comparison || [];

                    let basicParts = [];
                    if (basic.username) basicParts.push(`用户名：${escapeHtml(basic.username)}`);
                    if (basic.qq) basicParts.push(`QQ号：${escapeHtml(basic.qq)}`);
                    if (basic.email) basicParts.push(`邮箱：${escapeHtml(basic.email)}`);
                    if (basic.app_type) basicParts.push(`类型：${escapeHtml(basic.app_type)}`);
                    let basicLine = basicParts.length ? `<div class="info-line">${basicParts.join(' | ')}</div>` : '';

                    let expParts = [];
                    if (basic.exp_a) expParts.push(`<div><strong>exp_a:</strong> ${escapeHtml(basic.exp_a)}</div>`);
                    if (basic.exp_b) expParts.push(`<div><strong>exp_b:</strong> ${escapeHtml(basic.exp_b)}</div>`);
                    if (basic.exp_c) expParts.push(`<div><strong>exp_c:</strong> ${escapeHtml(basic.exp_c)}</div>`);
                    if (basic.exp_d) expParts.push(`<div><strong>exp_d:</strong> ${escapeHtml(basic.exp_d)}</div>`);
                    let expHtml = expParts.length ? `<details class="exam-details"><summary>📋 经验描述（点击展开）</summary><div class="exam-details-body">${expParts.join('')}</div></details>` : '';

                    let tableHtml;
                    if (item.is_noted) {
                        let mutedRows = comp.map(c => {
                            return `<tr class="row-muted"><td class="col-q">${escapeHtml(c.q)}</td><td colspan="3" class="col-muted">（已标记，作答内容已隐藏）</td></tr>`;
                        }).join('');
                        tableHtml = `
                            <table class="comparison-table">
                                <thead><tr><th>题号</th><th>你的答案</th><th>正确答案</th><th>结果</th></tr></thead>
                                <tbody>${mutedRows}</tbody>
                            </table>`;
                    } else {
                        let tableRows = comp.map(c => {
                            let rowClass, icon;
                            if (c.isCorrect) { rowClass = 'row-correct'; icon = '✓'; }
                            else if (c.isPartial) { rowClass = 'row-partial'; icon = '~'; }
                            else { rowClass = 'row-incorrect'; icon = '✗'; }
                            const userAns = escapeHtml(c.userAns) || '(未作答)';
                            const correctAns = escapeHtml(c.correctAns);
                            return `<tr class="${rowClass}"><td class="col-q">${escapeHtml(c.q)}</td><td class="col-ans">${userAns}</td><td class="col-ans">${correctAns}</td><td class="col-result">${icon}</td></tr>`;
                        }).join('');
                        tableHtml = tableRows ? `
                            <table class="comparison-table">
                                <thead><tr><th>题号</th><th>你的答案</th><th>正确答案</th><th>结果</th></tr></thead>
                                <tbody>${tableRows}</tbody>
                            </table>` : '';
                    }

                    infoHtml = basicLine + expHtml + tableHtml;
                }

                const isNoted = item.is_noted;
                const noteBtnText = isNoted ? 'DISNOTE' : 'NOTE';

                return `
                    <div class="${cardClass}">
                        <div class="record-meta">
                            <span>ID: #${item.id}</span>
                            <span>${isNoted ? '*QQID*' : 'QQID'}: <strong class="highlight-text">${item.qqid}</strong></span>
                            <span>第 <strong class="highlight-text">${item.exam_times}</strong> 次考试</span>
                            ${metaNoted}
                        </div>
                        <div class="record-body">
                            <div class="exam-score-box" style="margin-bottom: 10px;">
                                客观题得分: <span class="score-num" style="font-size: 1.2rem; font-weight: bold;">${item.exam_result}</span> / 100 分
                            </div>
                            
                            ${infoHtml}

                            ${isAchtung ? `
                                <button class="achtung-tag dismiss-btn" data-id="${item.id}" onclick="dismissWarning(${item.id})" style="margin-top: 15px; padding: 8px; border: 1px solid rgba(255, 95, 86, 0.5); background: rgba(255, 95, 86, 0.1); color: #ff5f56; font-size: 12px; border-radius: 4px; cursor: pointer; width: 100%; text-align: left; font-family: inherit;">
                                    WARNING: ${escapeHtml(item.achtung_notes)} — 点击取消标记
                                </button>
                            ` : ''}
                            ${item.violation ? `
                                <button class="violation-tag dismiss-btn" data-id="${item.id}" onclick="dismissWarning(${item.id})" style="margin-top: 10px; padding: 8px; border: 1px solid rgba(255, 169, 64, 0.6); background: rgba(255, 169, 64, 0.1); color: #ffa940; font-size: 12px; border-radius: 4px; font-weight: bold; cursor: pointer; width: 100%; text-align: left; font-family: inherit;">
                                    ⚠️ ${escapeHtml(item.violation)} — 点击取消标记
                                </button>
                            ` : ''}

                            <div class="uuid-footprint" style="margin-top: 15px; font-size: 11px; color: #555;">
                                设备 UUID: <span>${escapeHtml(item.user_uuid)}</span>
                            </div>
                        </div>
                        <div class="record-footer">
                            <span>提交时间: ${new Date(item.created_at).toLocaleString()}</span>
                            <div style="display:flex;gap:6px;">
                                <button onclick="${isNoted ? `disnoteRecord(${item.id})` : `noteRecord(${item.id})`}" class="note-btn">${noteBtnText}</button>
                                <button onclick="deleteData('exam', ${item.id})" class="delete-btn">DELETE</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) {
            document.getElementById('examList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING EXAM ARCHIVES</p>`;
        }
    }

    window.noteRecord = async function(id) {
        try {
            const res = await fetch('/api/exam/admin', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id })
            });
            if (res.ok) {
                loadApplications();
            } else {
                const data = await res.json();
                alert('标记失败：' + (data.error || '未知错误'));
            }
        } catch (e) {
            alert('标记异常');
        }
    }

    window.disnoteRecord = async function(id) {
        try {
            const res = await fetch('/api/exam/admin', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id, disnote: true })
            });
            if (res.ok) {
                loadApplications();
            } else {
                const data = await res.json();
                alert('取消标记失败：' + (data.error || '未知错误'));
            }
        } catch (e) {
            alert('取消标记异常');
        }
    }

    window.updateMessage = async function(id) {
        const content = document.getElementById(`rcontent-${id}`).value;
        const reply = document.getElementById(`rreply-${id}`).value;
        const reply_method = document.getElementById(`rmethod-${id}`).value;
        const status = document.getElementById(`rstatus-${id}`).value;
        const title = document.getElementById(`rtitle-${id}`).value;
        const is_public = document.getElementById(`rpublic-${id}`).checked ? 1 : 0;

        try {
            const btn = document.querySelector(`button[onclick="updateMessage(${id})"]`);
            const oldText = btn.innerText;
            btn.innerText = 'WAIT';
            
            const res = await fetch('/api/admin', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id, content, reply, reply_method, status, title, is_public })
            });
            
            if (res.ok) {
                btn.innerText = 'SAVED';
                setTimeout(() => { btn.innerText = oldText; }, 1500);
            } else {
                alert('UPDATE FAILED');
                btn.innerText = oldText;
            }
        } catch(e) {
            alert('NETWORK ERROR');
        }
    }

    window.dismissWarning = function(id) {
        if (!confirm('取消此标记？记录 ID 将被忽略，刷新后不再显示。')) return;
        let list = [];
        try { list = JSON.parse(localStorage.getItem('admin_dismissed_warnings') || '[]'); } catch(e) {}
        if (!list.includes(id)) list.push(id);
        localStorage.setItem('admin_dismissed_warnings', JSON.stringify(list));
        const card = document.querySelector(`.dismiss-btn[data-id="${id}"]`)?.closest('.record-card');
        if (card) card.style.display = 'none';
    }

    window.deleteData = async function(type, id) {
        if (!confirm("CONFIRM DATA DELETION? \n此操作直接作用于 Cloudflare D1 数据库且无法恢复。")) return;
        try {
            const res = await fetch(type === 'send' ? '/api/admin' : '/api/exam/admin', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ id })
            });
            if (res.ok) {
                type === 'send' ? loadMessages() : loadApplications();
            } else {
                const data = await res.json();
                alert('删除失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('删除异常，请检查权限。');
        }
    }

    function escapeHtml(t) { 
        if(!t) return '';
        const d = document.createElement('div'); 
        d.textContent = t; 
        return d.innerHTML; 
    }

    document.addEventListener('DOMContentLoaded', async () => {
        const response = await fetch('/api/auth/admin', { credentials: 'same-origin' });
        if (response.ok) {
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });

</script>

<style>
    .horizontal-tabs { display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 1px solid #222; padding-bottom: 15px; }
    .tab-btn { background: transparent; border: 1px solid #333; color: #777; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-family: monospace; letter-spacing: 1px; transition: all 0.2s ease; }
    .tab-btn.active, .tab-btn:hover { border-color: #00ff66; color: #000000; border-bottom: 2px solid #000000; background: rgba(0, 255, 102, 0.03); }
    .records-grid { display: flex; flex-direction: column; gap: 44px; margin-top: 20px; }
    .record-card { background: rgba(10, 10, 10, 0.8); border: 1px solid #222; border-radius: 6px; padding: 20px; transition: border-color 0.2s ease; }
    .record-card:hover { border-color: #444; }
    .record-card.achtung-alert-card { border: 1px solid rgba(255, 95, 86, 0.4); background: rgba(255, 95, 86, 0.02); box-shadow: inset 0 0 10px rgba(255, 95, 86, 0.05); }
    .record-card.achtung-alert-card:hover { border-color: rgba(255, 95, 86, 0.8); }
    .record-meta { display: flex; justify-content: space-between; font-size: 11px; font-family: monospace; color: #555; border-bottom: 1px solid #1a1a1a; padding-bottom: 10px; margin-bottom: 15px; }
    .highlight-text { color: #00ff66; }
    .record-body { color: #ccc; font-size: 14px; line-height: 1.6; }
    .record-footer { display: flex; justify-content: space-between; align-items: center; font-size: 11px; font-family: monospace; color: #555; border-top: 1px solid #1a1a1a; padding-top: 10px; margin-top: 15px; }
    
    .update-btn { 
        background: #00ff66; 
        color: #000; 
        border: 1px solid #00ff66; 
        padding: 4px 12px; 
        border-radius: 4px; 
        font-size: 10px; 
        cursor: pointer; 
        font-family: monospace; 
        font-weight: bold;
        transition: all 0.2s ease; 
    }
    .update-btn:hover { box-shadow: 0 0 8px rgba(0,255,102,0.4); }
    .update-btn:active {
        color: #000;
        background: #00cc55;
    }

    .delete-btn { background: transparent; border: 1px solid rgba(255,95,86,0.2); color: #ff5f56; padding: 4px 10px; border-radius: 4px; font-size: 10px; cursor: pointer; font-family: monospace; transition: all 0.2s ease; font-weight: bold; }
    .delete-btn:hover { background: rgba(255,95,86,0.15); color: #ff5f56; border-color: #ff5f56; }

    .note-btn { background: transparent; border: 1px solid rgba(100,140,255,0.3); color: #648cff; padding: 4px 10px; border-radius: 4px; font-size: 10px; cursor: pointer; font-family: monospace; transition: all 0.2s ease; font-weight: bold; }
    .note-btn:hover { background: rgba(100,140,255,0.15); border-color: #648cff; }
    .record-card.status-noted { opacity: 0.5; border-left: 2px solid #ff4d4f; }
    .record-card.status-noted:hover { border-color: #444; border-left-color: #ff4d4f; }
    .record-card.achtung-alert-card.status-noted { border-left: 2px solid #ff4d4f; }

    .noted-badge { color: #ff4d4f; background: rgba(255,77,79,0.15); border: 1px solid rgba(255,77,79,0.3); font-size: 10px; padding: 2px 6px; border-radius: 3px; font-weight: 700; letter-spacing: 0.5px; }

    .comparison-table .row-partial td { color: #ffa940; }
    .comparison-table .row-partial { background: rgba(255,169,64,0.06); }
    .comparison-table .row-partial .col-result { color: #ffa940; }

    .comparison-table .row-muted td { color: #555; font-style: italic; }
    .comparison-table .col-muted { color: #555; font-size: 11px; }

    .status-placeholder { text-align: center; padding: 40px; color: #555; font-family: monospace; }
    .exam-score-box { font-size: 15px; margin-bottom: 15px; color: #eee; }
    .score-num { color: #00ff66; font-weight: bold; font-family: monospace; }
    .achtung-tag { background: rgba(255, 95, 86, 0.1); border: 1px solid rgba(255, 95, 86, 0.2); color: #ff5f56; font-family: monospace; padding: 8px 12px; border-radius: 4px; font-size: 11px; margin: 15px 0; }
    .uuid-footprint { font-family: monospace; font-size: 10px; color: #444; margin-top: 10px; }
    .uuid-footprint span { color: #666; }
    .info-line { font-size: 13px; color: #ccc; margin-bottom: 10px; font-family: monospace; padding: 6px 0; border-bottom: 1px solid #1a1a1a; }

    .comparison-table { width: 100%; border-collapse: collapse; font-family: monospace; font-size: 12px; margin-top: 12px; }
    .comparison-table th { background: rgba(255,255,255,0.04); color: #888; font-weight: 700; text-align: left; padding: 8px 10px; border-bottom: 1px solid #333; font-size: 11px; letter-spacing: 0.5px; }
    .comparison-table td { padding: 6px 10px; border-bottom: 1px solid #1a1a1a; }
    .comparison-table .col-q { width: 60px; color: #666; }
    .comparison-table .col-ans { width: auto; color: #ccc; }
    .comparison-table .col-result { width: 40px; text-align: center; font-weight: bold; }
    .comparison-table .row-correct td { color: #ccc; }
    .comparison-table .row-correct .col-result { color: #00ff66; }
    .comparison-table .row-incorrect td { color: #ff5f56; }
    .comparison-table .row-incorrect { background: rgba(255, 95, 86, 0.06); }
    .comparison-table .row-incorrect .col-result { color: #ff5f56; }
    .comparison-table tbody tr:hover { background: rgba(255,255,255,0.02); }

    .exam-details { margin-top: 12px; border: 1px solid #222; border-radius: 4px; background: rgba(255,255,255,0.01); }
    .exam-details summary { cursor: pointer; padding: 8px 12px; font-size: 12px; font-family: monospace; color: #888; user-select: none; }
    .exam-details summary:hover { color: #ccc; }
