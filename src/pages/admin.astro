---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="系统综合管理 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto;">
                <h1 style="text-align: center; margin-bottom: 2rem; font-family: 'RAGE', cursive; font-size: 3rem;">🎛️ Admin Dashboard</h1>
                
                <div id="passwordPanel" class="auth-panel" style="display: none;">
                    <div style="text-align: center; padding: 2rem;">
                        <p style="font-size: 1.1rem; margin-bottom: 1rem;">请输入SU PWD(5W)以解锁管理权限</p>
                        <input type="password" id="adminPassword" placeholder="word1 word2 word3 word4 word5" class="mlu-title-input" style="text-align: center; max-width: 450px;"/>
                        <button id="loginBtn" onclick="authenticate()" class="action-button cn-button" style="margin: 1.5rem auto; max-width: 200px;">
                            <span class="action-text">SIGN IN</span>
                        </button>
                        <p id="authError" style="color: #ef4444; margin-top: 1rem; display: none;">验证失败</p>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    <div class="button-group" style="margin-bottom: 2rem;">
                        <button class="action-button active-tab" id="tab-send" onclick="switchTab('send')">
                            <span class="action-icon">📬</span>
                            <span class="action-text">MLU 10 MGMT</span>
                        </button>
                        <button class="action-button" id="tab-exam" onclick="switchTab('exam')">
                            <span class="action-icon">📝</span>
                            <span class="action-text">EXAM MGMT</span>
                        </button>
                    </div>

                    <div id="sendPanel" class="tab-content active">
                        <div id="messagesList" class="admin-grid">
                            <p style="text-align: center; padding: 2rem; color: var(--text-muted);">Initializing Systems...</p>
                        </div>
                    </div>

                    <div id="examPanel" class="tab-content" style="display: none;">
                        <div id="applicationsList" class="admin-grid"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 继承并改良自 Index 的按钮样式 */
    .admin-grid { display: flex; flex-direction: column; gap: 16px; width: 100%; }
    
    .mlu-unit-wrapper { width: 100%; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); }

    .action-button.mlu-item-btn {
        display: flex;
        align-items: center;
        justify-content: space-between; /* 左右分布 */
        width: 100%;
        padding: 0 32px;
        background: linear-gradient(135deg, #fff 0%, #f5f5f7 100%);
        border: 2px solid rgba(0,0,0,0.05);
        border-radius: 16px;
        height: 70px;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* 状态颜色逻辑 */
    .status-tag {
        font-size: 10px;
        letter-spacing: 0.1em;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 20px;
        text-transform: uppercase;
    }
    .status-PENDING { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; }
    .status-COMPLETE { background: #dcfce7; color: #166534; border: 1px solid #22c55e; }
    .status-ARCHIVED { background: #f3f4f6; color: #374151; border: 1px solid #9ca3af; }

    .unit-info { display: flex; align-items: center; gap: 15px; }
    .unit-id-tag { font-family: serif; font-style: italic; font-size: 14px; color: var(--accent-color); }

    /* 展开后的编辑面板 */
    .edit-panel {
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-top: none;
        border-radius: 0 0 16px 16px;
        margin: -10px 10px 10px 10px;
        padding: 2rem;
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
    }

    /* 通用样式补丁 */
    .mlu-title-input, .content-textarea, .reply-textarea {
        width: 100%; padding: 12px; border: 1px solid rgba(0,0,0,0.1); border-radius: 8px;
        background: #fff; color: #1d1d1f; font-family: inherit; margin-bottom: 1rem;
    }
    .label { font-size: 10px; font-weight: 800; color: #86868b; margin-bottom: 5px; display: block; }
    .btn-group { display: flex; gap: 10px; }
    .save-btn { background: #1d1d1f; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; flex: 1; font-weight: 600; }
    .del-btn { background: transparent; color: #ef4444; border: 1px solid #ef4444; padding: 10px 20px; border-radius: 8px; cursor: pointer; }

    @media (prefers-color-scheme: dark) {
        .action-button.mlu-item-btn { background: linear-gradient(135deg, #1d1d1f 0%, #2a2a2c 100%); color: #f5f5f7; }
        .edit-panel { background: rgba(32, 32, 34, 0.5); border-color: rgba(255,255,255,0.1); }
        .mlu-title-input, .content-textarea, .reply-textarea { background: #000; color: #f5f5f7; border-color: rgba(255,255,255,0.1); }
    }

    /* 按钮样式从你的 index 复制 */
    .action-button { position: relative; overflow: hidden; cursor: pointer; text-decoration: none; }
    .action-button:hover { transform: translateY(-4px) scale(1.01); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
    .active-tab { border-color: var(--accent-color) !important; box-shadow: 0 0 15px rgba(247, 196, 108, 0.2); }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    document.addEventListener('DOMContentLoaded', () => {
        const savedToken = sessionStorage.getItem('adminToken');
        if (savedToken === TARGET_HASH) {
            adminToken = savedToken;
            showDashboard();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });

    async function hashMnemonic(words) {
        const msgBuffer = new TextEncoder().encode(words.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const hashed = await hashMnemonic(input);
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            showDashboard();
        } else {
            document.getElementById('authError').style.display = 'block';
        }
    }

    window.switchTab = function(tabName) {
        document.getElementById('sendPanel').style.display = tabName === 'send' ? 'block' : 'none';
        document.getElementById('examPanel').style.display = tabName === 'exam' ? 'block' : 'none';
        document.getElementById('tab-send').classList.toggle('active-tab', tabName === 'send');
        document.getElementById('tab-exam').classList.toggle('active-tab', tabName === 'exam');
        tabName === 'send' ? loadMessages() : loadApplications();
    }

    function showDashboard() {
        document.getElementById('dashboardPanel').style.display = 'block';
        loadMessages(); 
    }

    // --- MLU 10 排序与渲染 ---
    window.loadMessages = async function() {
        const container = document.getElementById('messagesList');
        try {
            const response = await fetch('/api/admin', {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await response.json();

            // 1. 优先级排序逻辑
            const statusOrder = { 'PENDING': 1, 'COMPLETE': 2, 'ARCHIVED': 3 };
            const sortedMessages = data.messages.sort((a, b) => {
                // 首先按状态优先级排
                if (statusOrder[a.type || 'PENDING'] !== statusOrder[b.type || 'PENDING']) {
                    return statusOrder[a.type || 'PENDING'] - statusOrder[b.type || 'PENDING'];
                }
                // 同状态按时间倒序
                return new Date(b.created_at) - new Date(a.created_at);
            });

            container.innerHTML = sortedMessages.map(msg => {
                const safeTitle = msg.title || 'Untitled Unit';
                const safeType = msg.type || 'PENDING';
                
                return `
                <div class="mlu-unit-wrapper" id="unit-${msg.id}">
                    <button class="action-button mlu-item-btn" onclick="toggleEdit(${msg.id})">
                        <div class="unit-info">
                            <span class="unit-id-tag">#${msg.id}</span>
                            <span class="action-text" id="preview-title-${msg.id}">${escapeHtml(safeTitle)}</span>
                        </div>
                        <span class="status-tag status-${safeType}" id="preview-tag-${msg.id}">${safeType}</span>
                    </button>

                    <div id="edit-panel-${msg.id}" class="edit-panel" style="display: none;">
                        <span class="label">Unit Identifier</span>
                        <input type="text" id="title-${msg.id}" class="mlu-title-input" value="${escapeHtml(safeTitle)}" />
                        
                        <div style="display: flex; gap: 20px; margin-bottom: 1rem;">
                            <div style="flex: 1;">
                                <span class="label">Current Status</span>
                                <select id="type-${msg.id}" class="mlu-title-input" style="margin-bottom:0">
                                    <option value="PENDING" ${safeType === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                    <option value="COMPLETE" ${safeType === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                                    <option value="ARCHIVED" ${safeType === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                                </select>
                            </div>
                            <div style="flex: 1;">
                                <span class="label">Received At</span>
                                <div style="font-size: 13px; padding-top: 10px;">${new Date(msg.created_at).toLocaleString()}</div>
                            </div>
                        </div>

                        <span class="label">Message Content</span>
                        <textarea id="content-${msg.id}" class="content-textarea" rows="4">${escapeHtml(msg.content || '')}</textarea>
                        
                        <span class="label">Station Manager Reply</span>
                        <textarea id="reply-${msg.id}" class="reply-textarea" rows="4" placeholder="Type your reply here...">${escapeHtml(msg.reply || '')}</textarea>
                        
                        <div class="btn-group">
                            <button class="save-btn" onclick="updateMessage(${msg.id})">SYNC TO CLOUD</button>
                            <button class="del-btn" onclick="deleteData('send', ${msg.id})">DELETE</button>
                        </div>
                    </div>
                </div>
            `}).join('');
        } catch (e) { 
            container.innerHTML = `<p style="color:red; text-align:center;">Load Failed: ${e.message}</p>`; 
        }
    }

    window.toggleEdit = function(id) {
        const panel = document.getElementById(`edit-panel-${id}`);
        const isHidden = panel.style.display === 'none';
        
        // 关闭其他已打开的面板 (可选，为了整洁)
        document.querySelectorAll('.edit-panel').forEach(p => {
            if (p.id !== `edit-panel-${id}`) p.style.display = 'none';
        });

        panel.style.display = isHidden ? 'block' : 'none';
    }

    window.updateMessage = async function(id) {
        const title = document.getElementById(`title-${id}`).value;
        const type = document.getElementById(`type-${id}`).value;
        const payload = {
            id, title, type,
            content: document.getElementById(`content-${id}`).value,
            reply: document.getElementById(`reply-${id}`).value
        };

        try {
            const res = await fetch('/api/admin', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                // 实时刷新预览标签和标题
                document.getElementById(`preview-title-${id}`).textContent = title;
                const tag = document.getElementById(`preview-tag-${id}`);
                tag.textContent = type;
                tag.className = `status-tag status-${type}`;
                
                // 成功反馈
                const btn = document.querySelector(`#edit-panel-${id} .save-btn`);
                btn.textContent = "✓ SYNCED";
                setTimeout(() => { 
                    btn.textContent = "SYNC TO CLOUD";
                    loadMessages(); // 重新加载以触发排序
                }, 1000);
            }
        } catch (e) { alert('Update Failed'); }
    }

    window.deleteData = async function(type, id) {
        if (!confirm(`Permanently delete this ${type} record?`)) return;
        await fetch(type === 'send' ? '/api/admin' : '/api/exam/admin', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify({ id })
        });
        type === 'send' ? loadMessages() : loadApplications();
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = String(text);
        return div.innerHTML;
    }
</script>