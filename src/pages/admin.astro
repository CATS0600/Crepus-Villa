---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="CORE SYSTEM - ADMIN">
    <Header />
    
    <main class="main-content">
        <div class="scrolling-text">CORE SYSTEM ADMIN</div>

        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 60px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">REQUIRED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="ENTER SYSTEM KEY" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">AUTHENTICATE</span>
                        </button>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="horizontal-tabs">
                        <button class="tab-btn active" id="tab-send" onclick="switchTab('send')">MESSAGES</button>
                        <button class="tab-btn" id="tab-exam" onclick="switchTab('exam')">ENROLLMENT</button>
                    </div>

                    <div id="sendPanel" class="tab-content">
                        <div id="messagesList" class="admin-stack"></div>
                    </div>

                    <div id="examPanel" class="tab-content" style="display: none;">
                        <div class="filter-row">
                            <select id="groupFilter" onchange="loadApplications()" class="admin-select">
                                <option value="all">ALL GROUPS</option>
                                <option value="dpmbg">DPMBG ONLY</option>
                            </select>
                        </div>
                        <div id="applicationsList" class="admin-stack"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .main-content { background-color: #f5f5f7; min-height: 100vh; padding-top: 100px; }
    @media (prefers-color-scheme: dark) { .main-content { background-color: #000; } }
    
    .scrolling-text { position: fixed; top: 15%; left: 0; font-size: 12vw; font-weight: 900; color: rgba(247,196,108,0.03); white-space: nowrap; pointer-events: none; z-index: 0; }

    /* Tab 样式 */
    .horizontal-tabs { display: flex; gap: 15px; margin-bottom: 40px; justify-content: center; }
    .tab-btn { 
        padding: 12px 30px; border-radius: 14px; border: none; background: rgba(0,0,0,0.05); 
        font-weight: 800; cursor: pointer; transition: 0.3s; color: #86868b;
    }
    .tab-btn.active { background: #1d1d1f; color: #fff; }
    @media (prefers-color-scheme: dark) { .tab-btn.active { background: #fff; color: #000; } .tab-btn { background: rgba(255,255,255,0.1); } }

    /* 条目按钮化 */
    .item-entry-btn {
        width: 100%; display: flex; align-items: center; justify-content: space-between;
        padding: 22px 30px; background: #fff; border-radius: 20px; border: 1px solid rgba(0,0,0,0.05);
        cursor: pointer; transition: 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .item-entry-btn:hover { transform: scale(1.02); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    
    .entry-title { font-size: 1.1rem; font-weight: 700; color: #1d1d1f; }
    .status-pill { padding: 6px 12px; border-radius: 10px; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .status-pending { background: #fffbeb; color: #b45309; }
    .status-complete { background: #f0fdf4; color: #15803d; }
    .status-archived { background: #f1f5f9; color: #475569; }

    /* 分割线 */
    .admin-divider { text-align: center; margin: 30px 0; color: rgba(0,0,0,0.1); font-weight: 300; letter-spacing: 8px; }

    /* 信息块 - 严格默认隐藏 */
    .detail-fold { display: none; padding: 25px; margin: -10px 10px 30px 10px; background: rgba(255,255,255,0.6); backdrop-filter: blur(20px); border-radius: 0 0 24px 24px; border: 1px solid rgba(0,0,0,0.05); }
    .info-block { background: #fff; border-radius: 16px; padding: 20px; margin-bottom: 12px; border: 1px solid rgba(0,0,0,0.03); }
    .info-label { font-size: 10px; font-weight: 800; color: #86868b; margin-bottom: 8px; display: block; text-transform: uppercase; }
    .admin-textarea { width: 100%; background: transparent; border: none; font-family: inherit; font-size: 1rem; font-weight: 600; outline: none; resize: vertical; color: #1d1d1f; }

    .ops-row { display: flex; gap: 10px; margin-top: 20px; }
    .btn-sync { flex: 2; padding: 18px; border-radius: 14px; background: #1d1d1f; color: #fff; border: none; font-weight: 700; cursor: pointer; }
    .btn-delete { flex: 1; padding: 18px; border-radius: 14px; background: rgba(255, 69, 58, 0.1); color: #ff453a; border: 1px solid #ff453a; font-weight: 700; cursor: pointer; }

    @media (prefers-color-scheme: dark) {
        .item-entry-btn, .info-block { background: #1c1c1e; border-color: rgba(255,255,255,0.05); }
        .entry-title, .admin-textarea { color: #f5f5f7; }
        .detail-fold { background: rgba(28,28,30,0.8); }
        .admin-divider { color: rgba(255,255,255,0.1); }
    }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const msgBuffer = new TextEncoder().encode(input.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashed = Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
        
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else { alert("KEY INVALID"); }
    }

    window.switchTab = function(tabName) {
        document.getElementById('tab-send').classList.toggle('active', tabName === 'send');
        document.getElementById('tab-exam').classList.toggle('active', tabName === 'exam');
        document.getElementById('sendPanel').style.display = tabName === 'send' ? 'block' : 'none';
        document.getElementById('examPanel').style.display = tabName === 'exam' ? 'block' : 'none';
        tabName === 'send' ? loadMessages() : loadApplications();
    }

    // admin.astro 中的 <script> 部分

// 1. 修改 loadMessages 的 HTML 模板
window.loadMessages = async function() {
    const container = document.getElementById('messagesList');
    try {
        const res = await fetch('/api/admin', { headers: { 'X-Admin-Token': adminToken } });
        const data = await res.json();
        const sorted = (data.messages || []).sort((a, b) => a.id - b.id); // 或按时间排序

        container.innerHTML = sorted.map((msg, idx) => `
            <div class="msg-unit">
                <button class="item-entry-btn" onclick="toggleFold('msg-${msg.id}')">
                    <span class="entry-title">${escapeHtml(msg.title || 'UNTITLED')}</span>
                    <span class="status-pill status-${(msg.type || 'PENDING').toLowerCase()}">${msg.type || 'PENDING'}</span>
                </button>
                <div id="fold-msg-${msg.id}" class="detail-fold">
                    <div class="info-block"><span class="info-label">Title</span><input id="in-title-${msg.id}" class="admin-textarea" value="${escapeHtml(msg.title)}" /></div>
                    <div class="info-block"><span class="info-label">Content</span><textarea id="in-content-${msg.id}" class="admin-textarea">${escapeHtml(msg.content)}</textarea></div>
                    <div class="info-block"><span class="info-label">Reply</span><textarea id="in-reply-${msg.id}" class="admin-textarea" style="color:#0071e3">${escapeHtml(msg.reply)}</textarea></div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <div class="info-block">
                            <span class="info-label">Status</span>
                            <select id="in-type-${msg.id}" class="admin-textarea">
                                <option value="PENDING" ${msg.type === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                <option value="COMPLETE" ${msg.type === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                                <option value="ARCHIVED" ${msg.type === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                            </select>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Visibility</span>
                            <select id="in-public-${msg.id}" class="admin-textarea">
                                <option value="1" ${msg.is_public == 1 ? 'selected' : ''}>PUBLIC</option>
                                <option value="0" ${msg.is_public == 0 ? 'selected' : ''}>PRIVATE</option>
                            </select>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <div class="info-block">
                            <span class="info-label">Reply Method</span>
                            <select id="in-reply-method-${msg.id}" class="admin-textarea">
                                <option value="web" ${msg.reply_method === 'web' ? 'selected' : ''}>Web</option>
                                <option value="email" ${msg.reply_method === 'email' ? 'selected' : ''}>Email</option>
                            </select>
                        </div>
                        <div class="info-block">
                            <span class="info-label">Email</span>
                            <input id="in-email-${msg.id}" class="admin-textarea" value="${escapeHtml(msg.email)}" placeholder="N/A" />
                        </div>
                    </div>

                    <div class="ops-row">
                        <button class="btn-sync" onclick="updateMessage(${msg.id})">UPDATE</button>
                        <button class="btn-delete" onclick="deleteData('send', ${msg.id})">DELETE</button>
                    </div>
                </div>
                ${idx !== sorted.length - 1 ? '<div class="admin-divider">---</div>' : ''}
            </div>
        `).join('');
    } catch (e) { container.innerHTML = 'LOAD ERROR'; }
}

// 2. 修改 updateMessage 提交逻辑
window.updateMessage = async function(id) {
    const payload = {
        id,
        title: document.getElementById(`in-title-${id}`).value,
        type: document.getElementById(`in-type-${id}`).value,
        content: document.getElementById(`in-content-${id}`).value,
        reply: document.getElementById(`in-reply-${id}`).value,
        email: document.getElementById(`in-email-${id}`).value,
        // 【关键】确保 ID 与你新改的 HTML 对应
        reply_method: document.getElementById(`in-reply-method-${id}`).value, 
        is_public: document.getElementById(`in-public-${id}`).value === "1"
    };
    
    const res = await fetch('/api/admin', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
        body: JSON.stringify(payload)
    });

    if(res.ok) {
        alert("SUCCESS");
        loadMessages();
    } else {
        alert("UPDATE FAILED");
    }
}

    window.toggleFold = function(id) {
        const target = document.getElementById(`fold-${id}`);
        const isCurrentlyVisible = target.style.display === 'block';
        document.querySelectorAll('.detail-fold').forEach(el => el.style.display = 'none');
        target.style.display = isCurrentlyVisible ? 'none' : 'block';
    }

    // window.updateMessage = async function(id) {
    //     const payload = {
    //         id,
    //         title: document.getElementById(`in-title-${id}`).value,
    //         type: document.getElementById(`in-type-${id}`).value,
    //         content: document.getElementById(`in-content-${id}`).value,
    //         reply: document.getElementById(`in-reply-${id}`).value
    //     };
    //     await fetch('/api/admin', {
    //         method: 'PUT',
    //         headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
    //         body: JSON.stringify(payload)
    //     });
    //     loadMessages();
    // }

    window.updateExamStatus = async function(id, status) {
        await fetch('/api/exam/admin', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify({ id, status })
        });
        loadApplications();
    }

    window.deleteData = async function(type, id) {
        if (!confirm("CONFIRM DELETE?")) return;
        await fetch(type === 'send' ? '/api/admin' : '/api/exam/admin', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify({ id })
        });
        type === 'send' ? loadMessages() : loadApplications();
    }

    function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }

    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('adminToken') === TARGET_HASH) {
            adminToken = TARGET_HASH;
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
        } else { document.getElementById('passwordPanel').style.display = 'block'; }
    });
</script>