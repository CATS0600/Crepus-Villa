---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="管理后台 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 900px; margin: 2rem auto;">
                <h1 style="text-align: center; margin-bottom: 2rem;">📊 管理后台</h1>
                
                <div id="adminPanel" class="admin-panel">
                    <div style="text-align: center; padding: 2rem;">
                        <p>加载中...</p>
                    </div>
                </div>

                <div style="text-align: center; margin-top: 2rem;">
                    <a href="/reply" class="action-btn">查看公开留言</a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .admin-panel {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .message-item {
        padding: 1.5rem;
        border-bottom: 1px solid var(--card-border);
        transition: background 0.2s;
    }

    .message-item:hover {
        background: var(--bg-color);
    }

    .message-item:last-child {
        border-bottom: none;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .message-info {
        flex: 1;
        min-width: 0;
    }

    .message-id {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }

    .message-status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-right: 0.5rem;
    }

    .status-public {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .status-private {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }

    .status-no-reply {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .status-replied {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .message-content {
        font-size: 1rem;
        line-height: 1.6;
        margin: 1rem 0;
        white-space: pre-wrap;
        word-break: break-word;
        background: var(--bg-color);
        padding: 0.75rem;
        border-radius: 6px;
    }

    .message-time {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    .reply-section {
        background: var(--bg-color);
        border-left: 3px solid var(--text-main);
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
    }

    .reply-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .reply-textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        background: var(--bg-color);
        color: var(--text-main);
        resize: vertical;
        min-height: 80px;
    }

    .reply-textarea:focus {
        outline: none;
        border-color: var(--text-main);
    }

    .actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-primary {
        background: var(--text-main);
        color: var(--bg-color);
    }

    .btn-primary:hover {
        opacity: 0.8;
    }

    .btn-danger {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .btn-danger:hover {
        opacity: 0.8;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-muted);
    }

    .action-btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: var(--text-main);
        color: var(--bg-color);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
    }

    .action-btn:hover {
        opacity: 0.8;
    }

    .token-display {
        font-family: 'Courier New', monospace;
        font-weight: 600;
        background: var(--bg-color);
        padding: 0.25rem 0.5rem;
        border-radius: 3px;
        user-select: all;
    }
</style>

<script>
    async function loadMessages() {
        const panel = document.getElementById('adminPanel');
        
        try {
            const response = await fetch('/api/admin');
            const data = await response.json();

            if (data.messages.length === 0) {
                panel.innerHTML = `
                    <div class="empty-state">
                        <p>📭</p>
                        <p>暂无留言</p>
                    </div>
                `;
                return;
            }

            panel.innerHTML = data.messages.map(msg => {
                const date = new Date(msg.created_at);
                const formattedDate = date.toLocaleString('zh-CN');
                const isPublic = msg.is_public === 1;
                const hasReply = msg.reply && msg.reply.trim() !== '';
                
                return `
                    <div class="message-item">
                        <div class="message-header">
                            <div class="message-info">
                                <div class="message-id">ID: ${msg.id}</div>
                                <span class="message-status ${isPublic ? 'status-public' : 'status-private'}">
                                    ${isPublic ? '🔓 公开' : '🔐 私密'}
                                </span>
                                <span class="message-status ${hasReply ? 'status-replied' : 'status-no-reply'}">
                                    ${hasReply ? '✓ 已回复' : '✗ 未回复'}
                                </span>
                            </div>
                        </div>
                        
                        <div class="message-time">${formattedDate}</div>
                        
                        <div class="message-content">${escapeHtml(msg.content)}</div>
                        
                        ${msg.token ? '<div class="token-display">Token: ' + msg.token + '</div>' : ''}
                        
                        <div class="reply-section">
                            <div class="reply-label">💬 回复</div>
                            <textarea 
                                class="reply-textarea" 
                                placeholder="输入回复内容..." 
                                data-message-id="${msg.id}"
                            >${msg.reply || ''}</textarea>
                            <div class="actions">
                                <button class="btn btn-primary" onclick="saveReply(${msg.id})">💾 保存回复</button>
                                <button class="btn btn-danger" onclick="deleteMessage(${msg.id})">🗑️ 删除留言</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (error) {
            panel.innerHTML = '<p style="color: red; padding: 2rem; text-align: center;">加载失败，请刷新重试</p>';
            console.error(error);
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function saveReply(messageId) {
        const textarea = document.querySelector(`textarea[data-message-id="${messageId}"]`);
        const reply = textarea.value;
        const btn = textarea.nextElementSibling.querySelector('button');

        btn.disabled = true;

        try {
            const response = await fetch('/api/admin', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: messageId, reply })
            });

            const data = await response.json();

            if (data.success) {
                alert('✅ 回复已保存');
            } else {
                alert('❌ 保存失败');
            }
        } catch (error) {
            alert('❌ 保存失败，请重试');
            console.error(error);
        }

        btn.disabled = false;
    }

    async function deleteMessage(messageId) {
        if (!confirm('确定要删除这条留言吗？此操作不可恢复')) {
            return;
        }

        try {
            const response = await fetch('/api/admin', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: messageId })
            });

            const data = await response.json();

            if (data.success) {
                alert('✅ 留言已删除');
                loadMessages();
            } else {
                alert('❌ 删除失败');
            }
        } catch (error) {
            alert('❌ 删除失败，请重试');
            console.error(error);
        }
    }

    document.addEventListener('DOMContentLoaded', loadMessages);
</script>
