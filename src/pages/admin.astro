---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="系统综合管理 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto; width: 90%;">
                <h1 style="text-align: center; margin-bottom: 2rem; font-weight: 800;">🎛️ SYSTEM DASHBOARD</h1>
                
                <div id="passwordPanel" class="auth-panel" style="display: none;">
                    <div style="text-align: center; padding: 2rem;">
                        <p style="font-size: 1.1rem; margin-bottom: 1rem;">请输入SU PWD(5W)以解锁管理权限</p>
                        <input type="password" id="adminPassword" placeholder="word1 word2 word3 word4 word5" class="mnemonic-input" />
                        <button id="loginBtn" onclick="authenticate()" class="login-btn">进入系统</button>
                        <p id="authError" style="color: #ef4444; margin-top: 1rem; display: none; font-size: 0.9rem;">SU PWD验证失败</p>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    <div class="tabs">
                        <button class="tab-btn active" onclick="switchTab('send')">📬 MLU 10</button>
                        <button class="tab-btn" onclick="switchTab('exam')">📝 EXAM</button>
                    </div>

                    <div id="sendPanel" class="admin-panel tab-content active">
                        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="panel-info">留言单元管理</span>
                            <button onclick="loadMessages()" class="btn-refresh">REFRESH LIST</button>
                        </div>
                        <div id="messagesList" class="button-group-vertical">
                            <p style="text-align: center; padding: 2rem;">INITIALIZING...</p>
                        </div>
                    </div>

                    <div id="examPanel" class="admin-panel tab-content" style="display: none;">
                        <div id="applicationsList" class="list-container"></div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* 继承并适配 Villa V4 Index 样式 */
    :root { --accent-color: #f7c46c; }
    .main-content { background-color: #f5f5f7; min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    @media (prefers-color-scheme: dark) { .main-content { background-color: #000000; } }

    .auth-panel { background: #fff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .mnemonic-input { width: 100%; max-width: 450px; padding: 1rem; border: 2px solid #f5f5f7; border-radius: 12px; font-size: 1rem; text-align: center; outline: none; transition: border-color 0.2s; }
    .mnemonic-input:focus { border-color: var(--accent-color); }
    .login-btn { display: block; margin: 1.5rem auto 0; padding: 0.8rem 3rem; background: #1d1d1f; color: #fff; border: none; border-radius: 12px; cursor: pointer; font-weight: 600; transition: transform 0.2s; }
    .login-btn:hover { transform: scale(1.02); }

    .tabs { display: flex; gap: 10px; margin-bottom: 2rem; justify-content: center; }
    .tab-btn { padding: 0.6rem 1.5rem; background: transparent; border: 1px solid rgba(0,0,0,0.1); border-radius: 30px; cursor: pointer; color: #86868b; font-weight: 600; transition: all 0.3s; }
    .tab-btn.active { background: #1d1d1f; color: #fff; border-color: #1d1d1f; }

    .button-group-vertical { display: flex; flex-direction: column; gap: 12px; width: 100%; }

    /* 重构后的 Action Button 样式 */
    .admin-action-item {
        width: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .item-main-button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        background: none;
        border: none;
        width: 100%;
        text-align: left;
    }

    .admin-action-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.06);
    }

    .btn-info-side { display: flex; align-items: center; gap: 15px; }
    .unit-badge { font-size: 0.65rem; font-weight: 800; padding: 2px 6px; background: #f5f5f7; border-radius: 4px; color: #86868b; }
    .item-title-text { font-size: 1.1rem; font-weight: 600; color: #1d1d1f; }

    .status-capsule {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* 状态颜色映射 */
    .cap-PENDING { background: #fffbeb; color: #d97706; border: 1px solid #fef3c7; }
    .cap-COMPLETE { background: #f0fdf4; color: #16a34a; border: 1px solid #dcfce7; }
    .cap-ARCHIVED { background: #f9fafb; color: #6b7280; border: 1px solid #f3f4f6; }

    /* 编辑面板动画 */
    .edit-panel {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
        background: rgba(0,0,0,0.01);
        padding: 0 1.5rem;
    }
    .edit-panel.active { max-height: 1000px; padding: 1.5rem; border-top: 1px solid #f5f5f7; }

    .mlu-input-group { margin-bottom: 1rem; }
    .mlu-label { font-size: 0.7rem; font-weight: 800; color: #b2b2b2; margin-bottom: 5px; display: block; }
    .mlu-field { width: 100%; padding: 0.75rem; border-radius: 10px; border: 1px solid #e5e5e7; background: #fff; font-size: 0.9rem; outline: none; }
    .mlu-field:focus { border-color: #1d1d1f; }

    .save-sync-btn { background: #1d1d1f; color: #fff; border: none; padding: 0.8rem 1.5rem; border-radius: 10px; font-weight: 600; cursor: pointer; width: 100%; margin-top: 1rem; }

    @media (prefers-color-scheme: dark) {
        .admin-action-item { background: #1d1d1f; border-color: rgba(255,255,255,0.08); }
        .item-title-text { color: #f5f5f7; }
        .unit-badge { background: #2a2a2c; }
        .mlu-field { background: #000; border-color: #2a2a2c; color: #fff; }
        .cap-PENDING { background: #451a03; color: #fbbf24; border: none; }
        .cap-COMPLETE { background: #064e3b; color: #4ade80; border: none; }
        .cap-ARCHIVED { background: #1f2937; color: #9ca3af; border: none; }
        .save-sync-btn { background: #f5f5f7; color: #1d1d1f; }
        .auth-panel { background: #1d1d1f; }
    }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    document.addEventListener('DOMContentLoaded', () => {
        const savedToken = sessionStorage.getItem('adminToken');
        if (savedToken === TARGET_HASH) {
            adminToken = savedToken;
            showDashboard();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });

    async function hashMnemonic(words) {
        const msgBuffer = new TextEncoder().encode(words.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const hashed = await hashMnemonic(input);
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            showDashboard();
        } else {
            document.getElementById('authError').style.display = 'block';
        }
    }

    function showDashboard() {
        document.getElementById('dashboardPanel').style.display = 'block';
        loadMessages(); 
    }

    window.switchTab = function(tabName) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.style.display = 'none');
        if (tabName === 'send') {
            document.querySelector('.tab-btn:nth-child(1)').classList.add('active');
            document.getElementById('sendPanel').style.display = 'block';
            loadMessages();
        } else {
            document.querySelector('.tab-btn:nth-child(2)').classList.add('active');
            document.getElementById('examPanel').style.display = 'block';
        }
    }

    // --- 逻辑：排序并加载留言 ---
    window.loadMessages = async function() {
        const container = document.getElementById('messagesList');
        try {
            const response = await fetch('/api/admin', {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await response.json();

            // 排序逻辑：PENDING(0) > COMPLETE(1) > ARCHIVED(2)
            const statusOrder = { 'PENDING': 0, 'COMPLETE': 1, 'ARCHIVED': 2 };
            const sorted = data.messages.sort((a, b) => {
                const orderA = statusOrder[a.type] ?? 99;
                const orderB = statusOrder[b.type] ?? 99;
                if (orderA !== orderB) return orderA - orderB;
                return b.id - a.id; // 同状态按 ID 倒序
            });

            const emojiMap = { 'PENDING': '⚡', 'COMPLETE': '✅', 'ARCHIVED': '📁' };

            container.innerHTML = sorted.map(msg => `
                <div class="admin-action-item" id="item-${msg.id}">
                    <button class="item-main-button" onclick="toggleEdit(${msg.id})">
                        <div class="btn-info-side">
                            <span class="unit-badge">#${msg.id}</span>
                            <span class="item-title-text">${escapeHtml(msg.title || 'UNTITLED')}</span>
                        </div>
                        <div class="status-capsule cap-${msg.type || 'PENDING'}">
                            <span>${emojiMap[msg.type] || '❓'}</span>
                            <span>${msg.type || 'PENDING'}</span>
                        </div>
                    </button>

                    <div id="panel-${msg.id}" class="edit-panel">
                        <div class="mlu-input-group">
                            <span class="mlu-label">UNIT TITLE</span>
                            <input type="text" id="title-${msg.id}" class="mlu-field" value="${escapeHtml(msg.title || '')}" />
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                            <div class="mlu-input-group">
                                <span class="mlu-label">STATUS</span>
                                <select id="type-${msg.id}" class="mlu-field">
                                    <option value="PENDING" ${msg.type === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                    <option value="COMPLETE" ${msg.type === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                                    <option value="ARCHIVED" ${msg.type === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                                </select>
                            </div>
                            <div class="mlu-input-group">
                                <span class="mlu-label">DANGER ZONE</span>
                                <button onclick="deleteData(${msg.id})" style="width:100%; padding:0.75rem; border-radius:10px; border:1px solid #ef4444; color:#ef4444; background:none; cursor:pointer; font-weight:600;">DELETE UNIT</button>
                            </div>
                        </div>

                        <div class="mlu-input-group">
                            <span class="mlu-label">MESSAGE CONTENT</span>
                            <textarea id="content-${msg.id}" class="mlu-field" style="height:120px; font-family:monospace;">${escapeHtml(msg.content || '')}</textarea>
                        </div>

                        <div class="mlu-input-group">
                            <span class="mlu-label">ADMIN REPLY</span>
                            <textarea id="reply-${msg.id}" class="mlu-field" style="height:80px;" placeholder="在此输入你的回复...">${escapeHtml(msg.reply || '')}</textarea>
                        </div>

                        <button class="save-sync-btn" id="save-btn-${msg.id}" onclick="updateMessage(${msg.id})">SYNC TO CLOUDFLARE D1</button>
                    </div>
                </div>
            `).join('');
        } catch (e) { container.innerHTML = '<p style="color:red; text-align:center;">ERROR: FAILED TO LOAD DATA</p>'; }
    }

    window.toggleEdit = function(id) {
        const panel = document.getElementById(`panel-${id}`);
        const allPanels = document.querySelectorAll('.edit-panel');
        // 可选：关闭其他面板
        // allPanels.forEach(p => { if(p.id !== `panel-${id}`) p.classList.remove('active') });
        panel.classList.toggle('active');
    }

    window.updateMessage = async function(id) {
        const btn = document.getElementById(`save-btn-${id}`);
        const title = document.getElementById(`title-${id}`).value;
        const type = document.getElementById(`type-${id}`).value;
        
        btn.textContent = "SYNCING...";
        btn.disabled = true;

        try {
            const res = await fetch('/api/admin', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({
                    id, title, type,
                    content: document.getElementById(`content-${id}`).value,
                    reply: document.getElementById(`reply-${id}`).value
                })
            });
            if (res.ok) {
                btn.textContent = "✅ SYNCED SUCCESSFUL";
                setTimeout(() => { 
                    btn.textContent = "SYNC TO CLOUDFLARE D1"; 
                    btn.disabled = false;
                    loadMessages(); // 重新加载以触发排序更新
                }, 1500);
            }
        } catch (e) { alert('Update Failed'); btn.disabled = false; }
    }

    window.deleteData = async function(id) {
        if(!confirm("确定要永久删除此单元吗？")) return;
        await fetch('/api/admin', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
            body: JSON.stringify({ id })
        });
        loadMessages();
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = String(text);
        return div.innerHTML;
    }
</script>