---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Core System Admin - Crepuscular's Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal active">
            <div class="container safe-zone" style="max-width: 950px; margin: 2rem auto; position: relative; z-index: 10;">
                
                <div id="passwordPanel" style="display: none;">
                    <div style="text-align: center; padding: 60px 20px;">
                        <h2 class="partner-sub-title">ACCESS <span class="accent-text">REQUIRED</span></h2>
                        <input type="password" id="adminPassword" class="admin-input-field" placeholder="ENTER SYSTEM KEY" style="margin-top:20px;" />
                        <button onclick="authenticate()" class="send-button" style="margin: 30px auto 0;">
                            <span class="send-text">AUTHENTICATE</span>
                        </button>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    
                    <div class="horizontal-tabs">
                        <button class="tab-btn active" id="tab-send" onclick="switchTab('send')">MESSAGES</button>
                        <button class="tab-btn" id="tab-exam" onclick="switchTab('exam')">EXAM RECORDS</button>
                    </div>

                    <div id="panel-send" class="admin-tab-content">
                        <h3 class="partner-sub-title">MESSAGE <span class="accent-text">ARCHIVES</span></h3>
                        <div id="messageList" class="records-grid">
                            <p class="status-placeholder">LOADING ARCHIVES...</p>
                        </div>
                    </div>

                    <div id="panel-exam" class="admin-tab-content" style="display: none;">
                        <h3 class="partner-sub-title">EXAMINATION <span class="accent-text">AUDITS</span></h3>
                        <div id="examList" class="records-grid">
                            <p class="status-placeholder">LOADING EXAM RECORD DATA...</p>
                        </div>
                    </div>

                </div>

            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    const TARGET_HASH = "443d24733cc9f2b66b66639313c5481ce7d35a36bf6523d1c5ab64332ed1b2ab";
    let adminToken = "";

    async function sha256(string) {
        const utf8 = new TextEncoder().encode(string);
        const hashBuffer = await crypto.subtle.digest('SHA-256', utf8);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function authenticate() {
        const input = document.getElementById('adminPassword').value;
        const encoded = await sha256(input);
        
        if (encoded === TARGET_HASH) {
            sessionStorage.setItem('adminToken', encoded);
            adminToken = encoded;
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            alert("ACCESS DENIED: INVALID KEY");
        }
    }

    function switchTab(type) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.admin-tab-content').forEach(p => p.style.display = 'none');
        
        document.getElementById(`tab-${type}`).classList.add('active');
        document.getElementById(`panel-${type}`).style.display = 'block';
    }

    async function loadMessages() {
        try {
            const res = await fetch('/api/get-messages', {
                headers: { 'X-Admin-Token': adminToken }
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            const messages = data.messages || data;

            const list = document.getElementById('messageList');
            if (!messages.length) {
                list.innerHTML = `<p class="status-placeholder">NO ARCHIVED MESSAGES</p>`;
                return;
            }

                    list.innerHTML = messages.map(item => {
                const statusVal = item.status || 'PENDING';
                const pubChecked = item.is_public ? 'checked' : '';
                return `
                <div class="record-card status-${statusVal.toLowerCase()}">
                    <div class="record-meta">
                        <span>TIME: ${new Date(item.created_at).toLocaleString()}</span>
                        <span>ID: #${item.id}</span>
                        <span>STATUS: <strong class="status-badge status-${statusVal.toLowerCase()}">${statusVal}</strong></span>
                    </div>
                    
                    <div class="record-body" style="margin-top: 10px;">
                        <div style="font-size: 12px; color: #666; margin-bottom: 8px; font-family: monospace; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                            <label>TITLE: <input type="text" id="rtitle-${item.id}" value="${escapeHtml(item.title || '')}" class="admin-edit-input" style="width:120px;" placeholder="Untitled" /></label>
                            <label>REPLY METHOD: 
                                <select id="rmethod-${item.id}" class="admin-edit-select">
                                    <option value="web" ${item.reply_method === 'web' ? 'selected' : ''}>Web</option>
                                    <option value="email" ${item.reply_method === 'email' ? 'selected' : ''}>Email</option>
                                </select>
                            </label>
                            <label>STATUS: 
                                <select id="rstatus-${item.id}" class="admin-edit-select">
                                    <option value="PENDING" ${statusVal === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                    <option value="COMPLETED" ${statusVal === 'COMPLETED' ? 'selected' : ''}>COMPLETED</option>
                                    <option value="ARCHIVED" ${statusVal === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                                </select>
                            </label>
                            <label style="display:flex;align-items:center;gap:4px;">
                                <input type="checkbox" id="rpublic-${item.id}" ${pubChecked} />
                                PUBLIC
                            </label>
                            ${item.email ? `<span>| EMAIL: <span style="color: #aaa;">${escapeHtml(item.email)}</span></span>` : ''}
                            ${item.token ? `<span>| TOKEN: <span style="color: #444;">${escapeHtml(item.token)}</span></span>` : ''}
                        </div>

                        <div style="background: rgba(255,255,255,0.02); border: 1px solid #1a1a1a; padding: 12px; border-radius: 4px; margin-bottom: 10px;">
                            <span style="font-size: 11px; color: #555; display: block; font-family: monospace; margin-bottom: 4px;">MESSAGE:</span>
                            <textarea id="rcontent-${item.id}" class="admin-edit-textarea">${escapeHtml(item.content)}</textarea>
                        </div>

                        <div style="background: rgba(0, 255, 102, 0.02); border: 1px solid rgba(0, 255, 102, 0.05); padding: 12px; border-radius: 4px;">
                            <span style="font-size: 11px; color: #348a53; display: block; font-family: monospace; margin-bottom: 4px;">REPLY:</span>
                            <textarea id="rreply-${item.id}" class="admin-edit-textarea" style="color:#00ff66;">${item.reply ? escapeHtml(item.reply) : ''}</textarea>
                        </div>
                    </div>

                    <div class="record-footer" style="margin-top: 15px; border-top: 1px solid #1a1a1a; padding-top: 10px; display: flex; justify-content: flex-end; gap: 10px;">
                        <button onclick="updateMessage(${item.id})" class="update-btn">UPDATE</button>
                        <button onclick="deleteData('send', ${item.id})" class="delete-btn">DELETE</button>
                    </div>
                </div>`;
            }).join('');
        } catch (e) {
            document.getElementById('messageList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING MESSAGES</p>`;
        }
    }

    async function loadApplications() {
        try {
            const res = await fetch('/api/exam/admin', {
                headers: { 'X-Admin-Token': adminToken }
            });
            if (!res.ok) throw new Error();
            const data = await res.json();
            
            const list = document.getElementById('examList');
            if (!data.length) {
                list.innerHTML = `<p class="status-placeholder">NO EXAM RECORDS IN D1</p>`;
                return;
            }

            list.innerHTML = data.map(item => {
                const isAchtung = item.achtung_notes && item.achtung_notes.includes('[ACHTUNG]');
                const cardClass = isAchtung ? 'record-card achtung-alert-card' : 'record-card';

                let answersHtml = '';
                if (item.answers) {
                    // 修复 1：将 onclick 逻辑改为直接操作 style.display，确保能正确展开/折叠
                    // 顺便优化了背景色使其在日间模式下也能清晰阅读
                    answersHtml = `
                        <div class="exam-answers-details" style="margin-top: 10px;">
                            <span class="toggle-answers" onclick="const el = this.nextElementSibling; el.style.display = el.style.display === 'none' ? 'block' : 'none';" style="cursor: pointer; color: #1890ff; font-size: 13px; text-decoration: underline;">查看完整试卷与简答 &darr;</span>
                            <div class="answers-content" style="display: none; margin-top: 15px; padding: 15px; background: rgba(128,128,128,0.1); border: 1px dashed #999; border-radius: 4px; line-height: 1.8; font-family: sans-serif; font-size: 14px;">
                                ${item.answers}
                            </div>
                        </div>
                    `;
                }

                return `
                    <div class="${cardClass}">
                        <div class="record-meta">
                            <span>ID: #${item.id}</span>
                            <span>QQID: <strong class="highlight-text">${item.qqid}</strong></span>
                            <span>第 <strong class="highlight-text">${item.exam_times}</strong> 次考试</span>
                        </div>
                        <div class="record-body">
                            <div class="exam-score-box" style="margin-bottom: 10px;">
                                客观题得分: <span class="score-num" style="font-size: 1.2rem; font-weight: bold;">${item.exam_result}</span> / 100 分
                            </div>
                            
                            ${answersHtml}

                            ${isAchtung ? `
                                <div class="achtung-tag" style="margin-top: 15px; padding: 8px; border: 1px solid rgba(255, 95, 86, 0.5); background: rgba(255, 95, 86, 0.1); color: #ff5f56; font-size: 12px; border-radius: 4px;">
                                    WARNING: ${escapeHtml(item.achtung_notes)}
                                </div>
                            ` : ''}

                            <div class="uuid-footprint" style="margin-top: 15px; font-size: 11px; color: #555;">
                                设备 UUID: <span>${escapeHtml(item.user_uuid)}</span>
                            </div>
                        </div>
                        <div class="record-footer">
                            <span>提交时间: ${new Date(item.created_at).toLocaleString()}</span>
                            <button onclick="deleteData('exam', ${item.id})" class="delete-btn">DELETE</button>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) {
            document.getElementById('examList').innerHTML = `<p class="status-placeholder" style="color: #ff5f56;">ERROR LOADING EXAM ARCHIVES</p>`;
        }
    }

    window.updateMessage = async function(id) {
        const content = document.getElementById(`rcontent-${id}`).value;
        const reply = document.getElementById(`rreply-${id}`).value;
        const reply_method = document.getElementById(`rmethod-${id}`).value;
        const status = document.getElementById(`rstatus-${id}`).value;
        const title = document.getElementById(`rtitle-${id}`).value;
        const is_public = document.getElementById(`rpublic-${id}`).checked ? 1 : 0;

        try {
            const btn = document.querySelector(`button[onclick="updateMessage(${id})"]`);
            const oldText = btn.innerText;
            btn.innerText = 'WAIT';
            
            const res = await fetch('/api/admin', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ id, content, reply, reply_method, status, title, is_public })
            });
            
            if (res.ok) {
                btn.innerText = 'SAVED';
                setTimeout(() => { btn.innerText = oldText; }, 1500);
            } else {
                alert('UPDATE FAILED');
                btn.innerText = oldText;
            }
        } catch(e) {
            alert('NETWORK ERROR');
        }
    }

    window.deleteData = async function(type, id) {
        if (!confirm("CONFIRM DATA DELETION? \n此操作直接作用于 Cloudflare D1 数据库且无法恢复。")) return;
        try {
            const res = await fetch(type === 'send' ? '/api/admin' : '/api/exam/admin', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify({ id })
            });
            if (res.ok) {
                type === 'send' ? loadMessages() : loadApplications();
            } else {
                const data = await res.json();
                alert('删除失败：' + (data.error || '未知错误'));
            }
        } catch (err) {
            alert('删除异常，请检查权限。');
        }
    }

    function escapeHtml(t) { 
        if(!t) return '';
        const d = document.createElement('div'); 
        d.textContent = t; 
        return d.innerHTML; 
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('adminToken') === TARGET_HASH) {
            adminToken = TARGET_HASH;
            document.getElementById('passwordPanel').style.display = 'none';
            document.getElementById('dashboardPanel').style.display = 'block';
            loadMessages();
            loadApplications();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });
</script>

<style>
    .horizontal-tabs { display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 1px solid #222; padding-bottom: 15px; }
    .tab-btn { background: transparent; border: 1px solid #333; color: #777; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-family: monospace; letter-spacing: 1px; transition: all 0.2s ease; }
    .tab-btn.active, .tab-btn:hover { border-color: #00ff66; color: #000000; border-bottom: 2px solid #000000; background: rgba(0, 255, 102, 0.03); }
    .records-grid { display: flex; flex-direction: column; gap: 20px; margin-top: 20px; }
    .record-card { background: rgba(10, 10, 10, 0.8); border: 1px solid #222; border-radius: 6px; padding: 20px; transition: border-color 0.2s ease; }
    .record-card:hover { border-color: #444; }
    .record-card.achtung-alert-card { border: 1px solid rgba(255, 95, 86, 0.4); background: rgba(255, 95, 86, 0.02); box-shadow: inset 0 0 10px rgba(255, 95, 86, 0.05); }
    .record-card.achtung-alert-card:hover { border-color: rgba(255, 95, 86, 0.8); }
    .record-meta { display: flex; justify-content: space-between; font-size: 11px; font-family: monospace; color: #555; border-bottom: 1px solid #1a1a1a; padding-bottom: 10px; margin-bottom: 15px; }
    .highlight-text { color: #00ff66; }
    .record-body { color: #ccc; font-size: 14px; line-height: 1.6; }
    .record-footer { display: flex; justify-content: space-between; align-items: center; font-size: 11px; font-family: monospace; color: #555; border-top: 1px solid #1a1a1a; padding-top: 10px; margin-top: 15px; }
    
    .update-btn { 
        background: #00ff66; 
        color: #000; 
        border: 1px solid #00ff66; 
        padding: 4px 12px; 
        border-radius: 4px; 
        font-size: 10px; 
        cursor: pointer; 
        font-family: monospace; 
        font-weight: bold;
        transition: all 0.2s ease; 
    }
    .update-btn:hover { box-shadow: 0 0 8px rgba(0,255,102,0.4); }
    .update-btn:active {
        color: #000;
        background: #00cc55;
    }

    .delete-btn { background: transparent; border: 1px solid rgba(255,95,86,0.2); color: #ff5f56; padding: 4px 10px; border-radius: 4px; font-size: 10px; cursor: pointer; font-family: monospace; transition: all 0.2s ease; }
    .delete-btn:hover { background: #ff5f56; color: #000; border-color: #ff5f56; }
    .status-placeholder { text-align: center; padding: 40px; color: #555; font-family: monospace; }
    .exam-score-box { font-size: 15px; margin-bottom: 15px; color: #eee; }
    .score-num { color: #00ff66; font-weight: bold; font-family: monospace; }
    .achtung-tag { background: rgba(255, 95, 86, 0.1); border: 1px solid rgba(255, 95, 86, 0.2); color: #ff5f56; font-family: monospace; padding: 8px 12px; border-radius: 4px; font-size: 11px; margin: 15px 0; }
    .uuid-footprint { font-family: monospace; font-size: 10px; color: #444; margin-top: 10px; }
    .uuid-footprint span { color: #666; }
    .exam-answers-details { margin: 15px 0; }
    .toggle-answers { font-size: 11px; color: #00ff66; font-family: monospace; cursor: pointer; text-decoration: underline; user-select: none; }
    .answers-content { display: none; margin-top: 10px; background: #080808; border: 1px solid #161616; padding: 15px; border-radius: 4px; font-size: 12px; color: #999; }
    .answers-content.active { display: block; animation: slideDown 0.2s ease; }
    .answers-content p { margin-bottom: 6px; }
    .essay-answer-box { margin-top: 12px; border-top: 1px dashed #222; padding-top: 10px; }
    .essay-text { background: rgba(255,255,255,0.01); padding: 10px; border-radius: 4px; margin-top: 5px; color: #eee; line-height: 1.5; font-family: sans-serif; }
    .text-error { color: #ff5f56; font-family: monospace; font-size: 11px; }

    .admin-edit-input {
        background: rgba(0,0,0,0.3);
        border: 1px dashed #444;
        color: #fff;
        padding: 2px 4px;
        font-family: monospace;
        border-radius: 2px;
        outline: none;
    }
    .admin-edit-select {
        background: rgba(0,0,0,0.3);
        border: 1px dashed #444;
        color: #fff;
        padding: 2px 4px;
        font-family: monospace;
        border-radius: 2px;
        outline: none;
        cursor: pointer;
    }
    .admin-edit-select option {
        background: #111;
        color: #fff;
    }

    .status-badge {
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
    .status-badge.status-pending { color: #ffa940; background: rgba(255, 169, 64, 0.15); border: 1px solid rgba(255, 169, 64, 0.3); }
    .status-badge.status-completed { color: #00ff66; background: rgba(0, 255, 102, 0.15); border: 1px solid rgba(0, 255, 102, 0.3); }
    .status-badge.status-archived { color: #888; background: rgba(136, 136, 136, 0.15); border: 1px solid rgba(136, 136, 136, 0.3); }
    .admin-edit-textarea {
        width: 100%;
        min-height: 60px;
        background: rgba(0,0,0,0.3);
        border: 1px dashed #444;
        color: #ccc;
        padding: 8px;
        font-family: sans-serif;
        border-radius: 4px;
        resize: vertical;
        outline: none;
        box-sizing: border-box;
    }
    .admin-edit-input:focus, .admin-edit-textarea:focus {
        border-color: #00ff66;
    }

    @keyframes slideDown { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

    @media (prefers-color-scheme: dark) {
        .update-btn:active {
            color: #fff;
        }
        .tab-btn.active {
        color: #ffffff;
        border-bottom-color: #ffffff;
    }
    }
</style>