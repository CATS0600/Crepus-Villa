---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="系统综合管理 - Crepus Villa">
    <Header />
    
    <main class="main-content">
        <section class="content-section reveal">
            <div class="container safe-zone" style="max-width: 1000px; margin: 2rem auto;">
                <h1 style="text-align: center; margin-bottom: 2rem;">🎛️ 系统管理后台</h1>
                
                <div id="passwordPanel" class="auth-panel" style="display: none;">
                    <div style="text-align: center; padding: 2rem;">
                        <p style="font-size: 1.1rem; margin-bottom: 1rem;">请输入SU PWD(5W)以解锁管理权限</p>
                        <input 
                            type="password" 
                            id="adminPassword" 
                            placeholder="word1 word2 word3 word4 word5"
                            style="width: 100%; max-width: 450px; padding: 0.75rem; border: 1px solid var(--card-border); border-radius: 8px; font-size: 1rem; text-align: center;"
                        />
                        <button id="loginBtn" onclick="authenticate()" style="display: block; margin: 1.5rem auto 0; padding: 0.75rem 2.5rem; background: var(--text-main); color: var(--bg-color); border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">
                            进入系统
                        </button>
                        <p id="authError" style="color: #ef4444; margin-top: 1rem; display: none; font-size: 0.9rem;">SU PWD验证失败</p>
                    </div>
                </div>

                <div id="dashboardPanel" style="display: none;">
                    <div class="tabs">
                        <button class="tab-btn active" onclick="switchTab('send')">📬 留言管理 (MLU 10)</button>
                        <button class="tab-btn" onclick="switchTab('exam')">📝 申请管理 (Exam)</button>
                    </div>

                    <div id="sendPanel" class="admin-panel tab-content active">
                        <div class="panel-header">
                            <button onclick="loadMessages()" class="btn-refresh">刷新留言列表</button>
                        </div>
                        <div id="messagesList" class="list-container">
                            <p style="text-align: center; padding: 2rem;">加载中...</p>
                        </div>
                    </div>

                    <div id="examPanel" class="admin-panel tab-content" style="display: none;">
                        <div class="panel-header" style="display: flex; gap: 1rem; align-items: center;">
                            <select id="groupFilter" onchange="loadApplications()" style="padding: 0.6rem; border: 1px solid var(--card-border); border-radius: 6px; background: var(--bg-color); color: var(--text-main);">
                                <option value="dpmbg">DPMBG 群组</option>
                                <option value="">所有群组</option>
                            </select>
                            <button onclick="loadApplications()" class="btn-refresh">刷新申请</button>
                        </div>
                        <div id="applicationsList" class="list-container">
                            <p style="text-align: center; padding: 2rem;">加载中...</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .main-content { background: var(--bg-color); min-height: 100vh; }
    .auth-panel { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    .admin-panel { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; }
    
    .tabs { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .tab-btn { padding: 0.8rem 1.5rem; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 8px; cursor: pointer; font-weight: 600; color: var(--text-main); transition: all 0.2s; }
    .tab-btn.active { background: var(--text-main); color: var(--bg-color); border-color: var(--text-main); }
    
    .panel-header { padding: 1.25rem; border-bottom: 1px solid var(--card-border); background: rgba(0,0,0,0.02); }
    .btn-refresh { padding: 0.6rem 1.2rem; background: var(--text-main); color: var(--bg-color); border: none; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }

    .item-card { padding: 2rem; border-bottom: 1px solid var(--card-border); transition: background 0.2s; }
    .item-card:hover { background: rgba(0,0,0,0.01); }
    
    /* MLU 10 标题样式 */
    .mlu-title-input { width: 100%; background: transparent; border: none; border-bottom: 2px solid transparent; font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem; padding: 0.5rem 0; transition: border-color 0.2s; }
    .mlu-title-input:focus { outline: none; border-color: var(--text-main); }

    .item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .item-meta { font-size: 0.85rem; color: var(--text-muted); }
    
    /* Type 选择器样式 */
    .type-select { padding: 0.4rem; border-radius: 6px; font-weight: 700; font-size: 0.75rem; cursor: pointer; border: 1px solid var(--card-border); }
    .type-PENDING { background: #fef3c7; color: #92400e; }
    .type-COMPLETE { background: #dcfce7; color: #166534; }
    .type-ARCHIVED { background: #f3f4f6; color: #374151; }

    .edit-area { margin: 1rem 0; }
    .label { font-size: 0.75rem; font-weight: bold; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem; display: block; }
    
    .content-textarea, .reply-textarea { width: 100%; padding: 0.8rem; border: 1px solid var(--card-border); border-radius: 8px; background: var(--bg-color); color: var(--text-main); font-size: 0.95rem; line-height: 1.6; resize: vertical; margin-bottom: 1rem; }
    .content-textarea { border-style: dashed; } /* 区分正文和回复 */

    .btn-group { display: flex; gap: 0.75rem; }
    .btn { padding: 0.6rem 1.2rem; border: none; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: opacity 0.2s; }
    .btn-save { background: #3b82f6; color: white; flex-grow: 1; }
    .btn-danger { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid #ef4444; }

    @media (prefers-color-scheme: dark) { 
        .type-PENDING { background: #451a03; color: #fbbf24; }
        .type-COMPLETE { background: #064e3b; color: #4ade80; }
        .type-ARCHIVED { background: #1f2937; color: #9ca3af; }
    }
</style>

<script>
    // @ts-nocheck
    const TARGET_HASH = "98757df4549e87f22ede90d906cf20ac8a65a6cacf3e95f02533c23772ea351b"; 
    let adminToken = null;

    document.addEventListener('DOMContentLoaded', () => {
        const savedToken = sessionStorage.getItem('adminToken');
        if (savedToken === TARGET_HASH) {
            adminToken = savedToken;
            showDashboard();
        } else {
            document.getElementById('passwordPanel').style.display = 'block';
        }
    });

    async function hashMnemonic(words) {
        const msgBuffer = new TextEncoder().encode(words.trim().toLowerCase());
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    }

    window.authenticate = async function() {
        const input = document.getElementById('adminPassword').value;
        const hashed = await hashMnemonic(input);
        if (hashed === TARGET_HASH) {
            adminToken = hashed;
            sessionStorage.setItem('adminToken', hashed);
            document.getElementById('passwordPanel').style.display = 'none';
            showDashboard();
        } else {
            document.getElementById('authError').style.display = 'block';
        }
    }

    window.switchTab = function(tabName) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.style.display = 'none');
        if (tabName === 'send') {
            document.querySelector('.tab-btn:nth-child(1)').classList.add('active');
            document.getElementById('sendPanel').style.display = 'block';
            loadMessages();
        } else {
            document.querySelector('.tab-btn:nth-child(2)').classList.add('active');
            document.getElementById('examPanel').style.display = 'block';
            loadApplications();
        }
    }

    function showDashboard() {
        document.getElementById('dashboardPanel').style.display = 'block';
        loadMessages(); 
    }

    // --- MLU 10 核心管理逻辑 ---
    window.loadMessages = async function() {
        const container = document.getElementById('messagesList');
        try {
            const response = await fetch('/api/admin', {
                headers: { 'X-Admin-Token': adminToken }
            });
            const data = await response.json();

            container.innerHTML = data.messages.map(msg => `
                <div class="item-card" id="card-${msg.id}">
                    <div class="item-header">
                        <div style="flex-grow: 1;">
                            <span class="label" style="margin:0">UNIT ${msg.id}</span>
                            <h2 class="preview-title" id="preview-title-${msg.id}">${escapeHtml(msg.title || 'Untitled')}</h2>
                            <div class="item-meta">
                                📅 ${new Date(msg.created_at).toLocaleString()} | 
                                <span class="type-tag type-${msg.type}">${msg.type}</span>
                            </div>
                        </div>
                        <div class="header-actions">
                            <button class="btn-toggle" onclick="toggleEdit(${msg.id})">📝 编辑单元</button>
                        </div>
                    </div>

                    <div id="edit-panel-${msg.id}" class="edit-panel" style="display: none; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px dashed var(--card-border);">
                        <div class="edit-field">
                            <span class="label">单元标题 (Title)</span>
                            <input type="text" id="title-${msg.id}" class="mlu-title-input" value="${escapeHtml(msg.title || 'Untitled')}" />
                        </div>

                        <div class="edit-field">
                            <span class="label">当前状态 (Type)</span>
                            <select id="type-${msg.id}" class="type-select type-${msg.type}" onchange="this.className='type-select type='+this.value">
                                <option value="PENDING" ${msg.type === 'PENDING' ? 'selected' : ''}>PENDING</option>
                                <option value="COMPLETE" ${msg.type === 'COMPLETE' ? 'selected' : ''}>COMPLETE</option>
                                <option value="ARCHIVED" ${msg.type === 'ARCHIVED' ? 'selected' : ''}>ARCHIVED</option>
                            </select>
                        </div>

                        <div class="edit-area">
                            <span class="label">正文内容 (Content)</span>
                            <textarea id="content-${msg.id}" class="content-textarea">${msg.content || ''}</textarea>
                            
                            <span class="label">站长回复 (Reply)</span>
                            <textarea id="reply-${msg.id}" class="reply-textarea" placeholder="在此输入回复...">${msg.reply || ''}</textarea>
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-save" onclick="updateMessage(${msg.id})">🚀 保存并同步云端</button>
                            <button class="btn btn-danger" onclick="deleteData('send', ${msg.id})">🗑️ 删除</button>
                        </div>
                    </div>
                </div>
            `).join('');
        } catch (e) { container.innerHTML = '<p style="color:red; text-align:center;">加载失败</p>'; }
    }

    // 新增：切换编辑区显示
    window.toggleEdit = function(id) {
        const panel = document.getElementById(`edit-panel-${id}`);
        const btn = document.querySelector(`#card-${id} .btn-toggle`);
        if (panel.style.display === 'none') {
            panel.style.display = 'block';
            btn.textContent = '收起面板';
            btn.style.background = 'var(--card-border)';
        } else {
            panel.style.display = 'none';
            btn.textContent = '📝 编辑单元';
            btn.style.background = 'transparent';
        }
    }

    // 更新函数增加 UI 反馈
    window.updateMessage = async function(id) {
        const title = document.getElementById(`title-${id}`).value;
        const type = document.getElementById(`type-${id}`).value;
        const payload = {
            id,
            title: title,
            content: document.getElementById(`content-${id}`).value,
            reply: document.getElementById(`reply-${id}`).value,
            type: type
        };

        try {
            const res = await fetch('/api/admin', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Admin-Token': adminToken },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                // 同步更新预览区域的标题和状态色
                document.getElementById(`preview-title-${id}`).textContent = title;
                // 提示成功
                const btn = document.querySelector(`#card-${id} .btn-save`);
                btn.textContent = "✅ 同步成功";
                setTimeout(() => { btn.textContent = "🚀 保存并同步云端"; }, 2000);
            }
        } catch (e) { alert('更新失败'); }
    }
</script>
<style>
    /* 增加和优化样式 */
    .preview-title { font-size: 1.5rem; font-weight: 700; margin: 0.25rem 0; color: var(--text-main); }
    .btn-toggle { padding: 0.5rem 1rem; border: 1px solid var(--card-border); border-radius: 6px; background: transparent; color: var(--text-main); cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .btn-toggle:hover { background: var(--text-main); color: var(--bg-color); }
    
    .type-tag { font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; text-transform: uppercase; }
    
    /* 其他 MLU 10 样式与之前保持一致 */
    .mlu-title-input { width: 100%; padding: 0.75rem; font-size: 1.25rem; font-weight: bold; border: 1px solid var(--card-border); border-radius: 8px; background: var(--bg-color); color: var(--text-main); margin-bottom: 1rem; }
    .label { display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: bold; margin-bottom: 0.5rem; text-transform: uppercase; }
</style>