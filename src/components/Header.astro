---
// src/components/Header.astro
---
<header class="apple-header">
    <nav class="safe-zone">
        <a href="/" class="logo">Crepuscular's Villa</a>
        <div class="links">
            <a href="/about" class="nav-about">About</a>
            {/* <a href="/send" class="nav-send">Send</a>
            <a href="/reply" class="nav-reply">Reply</a> */}
            <a href="/sponsor" class="nav-sponsor">Sponsor</a>
        </div>
    </nav>
</header>

<style>
    .apple-header {
        position: fixed;
        top: 0;
        width: 100%;
        height: 52px;
        background: rgba(251, 251, 253, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    nav {
        width: 100%;
        max-width: 1200px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 var(--container-padding, 1.5rem);
    }
    .logo { font-weight: 600; text-decoration: none; color: #1d1d1f; }
    .links { display: flex; gap: 30px; }
    .links a { 
        text-decoration: none; 
        color: #86868b; 
        font-size: 14px; 
        transition: color 0.3s;
    }
    .links a:hover { color: #1d1d1f; }

    /* 移动端优化 */
    @media (max-width: 640px) {
        nav {
            justify-content: flex-start;
        }
        .links {
            margin-left: auto;
            gap: 16px;
        }
        .links a { font-size: 13px; }

        /* 使用 CSS 修改小屏幕下的显示文字 - 已注释掉 */
        /* .nav-about { font-size: 0 !important; }
        .nav-about::before { content: "Abt."; font-size: 13px; }

        .nav-send { font-size: 0 !important; }
        .nav-send::before { content: "Send"; font-size: 13px; }

        .nav-reply { font-size: 0 !important; }
        .nav-reply::before { content: "Rpl."; font-size: 13px; }

        .nav-sponsor { font-size: 0 !important; }
        .nav-sponsor::before { content: "Sps."; font-size: 13px; } */
    }
</style>

<script is:inline>
// 移除了 client:load 换成 is:inline 确保在 Astro 中脚本正常执行
// 如果你使用的是标准 Astro 项目，is:inline 或不加修饰符均可
let clickTimes = [];
const logoLink = document.querySelector('.logo');
if (logoLink) {
  logoLink.addEventListener('click', (e) => {
    const now = Date.now();
    clickTimes.push(now);
    clickTimes = clickTimes.filter(ts => now - ts <= 10000);
    if (clickTimes.length > 10) {
      e.preventDefault();
      alert('Bro you should get a job');
      window.location.href = 'https://www.bing.com';
    }
  });
}
</script>