---
// src/components/Header.astro
const currentPath = Astro.url.pathname;
const chapterMap: Record<string, string> = {
    '/about': 'define',
    '/about/en': 'define',
    '/about/zh': 'define',
    '/send': 'endure',
    '/reply': 'endure',
    '/reply/private': 'endure',
    '/sponsor': 'endure',
    '/application/kemdr': 'manifest',
    '/application/dpmbg': 'manifest',
};
const currentChapter = chapterMap[currentPath] || '';
---
<header class="apple-header">
    <nav class="safe-zone">
        <a href="/" class="logo">Crepuscular's Villa</a>
        <div class="nav-spacer"></div>
        <div class="links">
            <a href="/about" class="nav-about" data-full="About" data-short="Ab." data-chapter="define">About</a>
            <a href="/sponsor" class="nav-sponsor" data-full="Sponsor" data-short="Sp." data-chapter="endure">Sponsor</a>
            <a href="/application/kemdr" class="nav-application" data-full="KVIV" data-short="KV." data-chapter="manifest">KVIV</a>
        </div>
    </nav>
</header>

<style>
    .apple-header {
        position: fixed;
        top: 0;
        width: 100%;
        height: 52px;
        background: rgba(251, 251, 253, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    nav {
        width: 100%;
        max-width: 1200px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 var(--safe-area, 20px);
        gap: 12px;
    }
    
    .nav-spacer {
        flex: 1;
        min-width: 8px;
    }

    .logo { 
        font-family: 'RAGE', cursive;
        font-size: 1.5rem;
        font-weight: normal;
        text-decoration: none; 
        color: var(--text-main, #1d1d1f); 
        transition: opacity 0.3s;
        flex-shrink: 0;
        margin-right: 4px;
    }
    .logo:hover {
        opacity: 0.8;
    }

    .links { 
        display: flex; 
        gap: 30px; 
        flex-shrink: 1;
        min-width: 0;
        overflow: hidden;
    }
    .links a { 
        text-decoration: none; 
        color: #86868b; 
        font-size: 14px; 
        transition: color 0.3s;
        white-space: nowrap;
    }
    .links a:hover { color: #1d1d1f; }

    @media (max-width: 640px) {
        .links { gap: 16px; }
        .links a { font-size: 13px; }
        .logo { font-size: 1.3rem; }
    }

    @media (prefers-color-scheme: dark) {
        .apple-header {
            background: rgba(0, 0, 0, 0.8);
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }
        .links a:hover { color: #f5f5f7; }
    }

    .links a.active-chapter {
        color: var(--accent-color, #f7c46c);
        position: relative;
    }
    .links a.active-chapter::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--accent-color, #f7c46c);
        border-radius: 1px;
    }
</style>

<script is:inline>
let clickTimes = [];

function attachLogoEasterEgg() {
  const logoLink = document.querySelector('.logo');
  if (!logoLink) return;
  logoLink.addEventListener('click', (e) => {
    const now = Date.now();
    clickTimes.push(now);
    clickTimes = clickTimes.filter(ts => now - ts <= 10000);
    if (clickTimes.length > 10) {
      e.preventDefault();
      alert('Bro you should get a job');
      window.location.href = 'https://www.bing.com';
    }
  });
}

// CONST HERE
const isBirthdaySpecialized = false;
// BOOL TYPE, true OR false



function gaussianRandom() {
  let u = 0, v = 0;
  while (u === 0) u = Math.random();
  while (v === 0) v = Math.random();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}

function createBirthdayCanvas() {
  const canvas = document.createElement('canvas');
  canvas.style.position = 'fixed';
  canvas.style.top = '0';
  canvas.style.left = '0';
  canvas.style.width = '100%';
  canvas.style.height = '100%';
  canvas.style.pointerEvents = 'none';
  canvas.style.zIndex = '9999';
  canvas.style.opacity = '1';
  document.body.appendChild(canvas);
  return canvas;
}

function initBirthdayParticles() {
  const canvas = createBirthdayCanvas();
  const ctx = canvas.getContext('2d');
  const particles = [];
  let width = 0;
  let height = 0;
  let rafId = null;
  const maxSpawnTime = 1000;
  const spawnInterval = 70;
  let spawnWindowEnd = performance.now() + maxSpawnTime;
  let lastSpawn = performance.now();

  const colors = ['#ff7fbf', '#ffd37f', '#7fdbff', '#a67fff', '#ff9a7f', '#81ff9a'];

  function resizeCanvas() {
    const dpr = window.devicePixelRatio || 1;
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function randomColor() {
    return colors[Math.floor(Math.random() * colors.length)];
  }

  function spawnAutoParticle() {
    const size = 16 + Math.random() * 14;
    particles.push({
      type: 'balloon',
      x: Math.random() * width,
      y: -size * 2,
      size,
      vy: 320 + Math.random() * 140,
      color: randomColor(),
      gaussSigma: 0.18 + Math.random() * 0.18,
    });
  }

  function spawnClickParticle(clientX, clientY) {
    const size = 30 + Math.random() * 20;
    const now = performance.now();
    particles.push({
      type: 'burst',
      x: clientX,
      y: clientY,
      size,
      color: randomColor(),
      createdAt: now,
      duration: 500,
      alpha: 1,
    });
  }

  function updateParticles(deltaTime) {
    const now = performance.now();
    if (now < spawnWindowEnd && now - lastSpawn >= spawnInterval) {
      for (let i = 0; i < 2; i += 1) spawnAutoParticle();
      lastSpawn = now;
    }

    for (let i = particles.length - 1; i >= 0; i -= 1) {
      const p = particles[i];
      if (p.type === 'balloon') {
        p.x += gaussianRandom() * p.gaussSigma * deltaTime * 0.12;
        p.y += p.vy * deltaTime * 0.001;
        if (p.y - p.size > height) {
          particles.splice(i, 1);
          continue;
        }
      } else {
        const elapsed = now - p.createdAt;
        const progress = Math.min(1, elapsed / p.duration);
        p.alpha = 1 - progress;
        p.drawSize = p.size * progress;
        if (progress >= 1) {
          particles.splice(i, 1);
          continue;
        }
      }
    }
  }

  function drawParticles() {
    ctx.clearRect(0, 0, width, height);
    for (const p of particles) {
      if (p.type === 'burst') {
        ctx.globalAlpha = p.alpha;
      } else {
        ctx.globalAlpha = 0.95;
      }
      ctx.fillStyle = p.color;
      const radius = p.type === 'burst' ? (p.drawSize || 0) * 0.5 : p.size * 0.7;
      ctx.beginPath();
      ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      ctx.fill();
      if (p.type === 'balloon') {
        ctx.globalAlpha = 0.6;
        ctx.strokeStyle = 'rgba(255,255,255,0.65)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y + radius);
        ctx.lineTo(p.x, p.y + radius + 18);
        ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;
  }

  let lastTimestamp = performance.now();
  function animationLoop(timestamp) {
    const deltaTime = timestamp - lastTimestamp;
    lastTimestamp = timestamp;
    updateParticles(deltaTime);
    drawParticles();
    rafId = requestAnimationFrame(animationLoop);
  }

  function handleNavigationClick(event) {
    const anchor = event.target.closest('a');
    if (!anchor || !anchor.href) return;
    const url = new URL(anchor.href, window.location.href);
    if (url.origin !== window.location.origin) return;
    const rect = anchor.getBoundingClientRect();
    spawnClickParticle(rect.left + rect.width / 2, rect.top + rect.height / 2);
  }

  window.addEventListener('resize', resizeCanvas);
  window.addEventListener('mousedown', (event) => {
    if (event.target.closest('a')) return;
    spawnClickParticle(event.clientX, event.clientY);
  });
  window.addEventListener('click', handleNavigationClick, true);
  window.addEventListener('touchstart', (event) => {
    const touch = event.touches[0];
    if (!touch || event.target.closest('a')) return;
    spawnClickParticle(touch.clientX, touch.clientY);
  }, { passive: true });

  resizeCanvas();
  rafId = requestAnimationFrame(animationLoop);

  return () => {
    cancelAnimationFrame(rafId);
    window.removeEventListener('resize', resizeCanvas);
    window.removeEventListener('click', handleNavigationClick, true);
  };
}

function abbreviateNavLinks() {
  const links = document.querySelectorAll('.links a');
  const nav = document.querySelector('nav');
  if (!nav || !links.length) return;

  const navRect = nav.getBoundingClientRect();
  const linksEl = document.querySelector('.links');
  if (!linksEl) return;
  const linksRect = linksEl.getBoundingClientRect();

  const overflowRight = linksRect.right > navRect.right;
  const overflowLeft = linksRect.left < navRect.left;

  if (overflowRight || overflowLeft) {
    links.forEach(a => {
      const short = a.getAttribute('data-short');
      if (short && a.textContent !== short) {
        a.textContent = short;
      }
    });
  } else {
    links.forEach(a => {
      const full = a.getAttribute('data-full');
      if (full && a.textContent !== full) {
        a.textContent = full;
      }
    });
  }
}

document.addEventListener('DOMContentLoaded', () => {
  attachLogoEasterEgg();
  abbreviateNavLinks();
  if (isBirthdaySpecialized) {
    initBirthdayParticles();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  abbreviateNavLinks();
});

window.addEventListener('resize', abbreviateNavLinks);

    // Narrative chapter highlight
    const navLinks = document.querySelectorAll('.links a');
    navLinks.forEach(link => {
        const chapter = link.getAttribute('data-chapter');
        const path = window.location.pathname;
        if (chapter === 'define' && (path === '/about' || path.startsWith('/about/'))) {
            link.classList.add('active-chapter');
        } else if (chapter === 'endure' && (path === '/sponsor' || path === '/send' || path === '/reply')) {
            link.classList.add('active-chapter');
        } else if (chapter === 'manifest' && path.startsWith('/application/')) {
            link.classList.add('active-chapter');
        }
    });
</script>