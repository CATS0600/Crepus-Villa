---
// src/components/Header.astro
---
<header class="apple-header">
    <nav class="safe-zone">
        <a href="/" class="logo">Crepuscular's Villa</a>
        <div class="links">
            <a href="/about" class="nav-about">About</a>
            <a href="/sponsor" class="nav-sponsor">Sponsor</a>
        </div>
    </nav>
</header>

<style>
    .apple-header {
        position: fixed;
        top: 0;
        width: 100%;
        height: 52px;
        background: rgba(251, 251, 253, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    nav {
        width: 100%;
        max-width: 1200px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 var(--container-padding, 1.5rem);
    }
    
    /* 核心修改部分 */
    .logo { 
        font-family: 'RAGE', cursive; /* 引用全局定义的 RAGE */
        font-size: 1.5rem; /* RAGE 字体通常偏小，适当放大 */
        font-weight: normal; /* 书法字体通常不需要额外的加粗 */
        text-decoration: none; 
        color: var(--text-main, #1d1d1f); 
        transition: opacity 0.3s;
    }
    .logo:hover {
        opacity: 0.8;
    }

    .links { display: flex; gap: 30px; }
    .links a { 
        text-decoration: none; 
        color: #86868b; 
        font-size: 14px; 
        transition: color 0.3s;
    }
    .links a:hover { color: #1d1d1f; }

    @media (max-width: 640px) {
        nav { justify-content: flex-start; }
        .links { margin-left: auto; gap: 16px; }
        .links a { font-size: 13px; }
        .logo { font-size: 1.3rem; } /* 移动端稍作缩小 */
    }

    @media (prefers-color-scheme: dark) {
        .apple-header {
            background: rgba(0, 0, 0, 0.8);
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }
        .links a:hover { color: #f5f5f7; }
    }
</style>

<script is:inline>
// 保持原有的彩蛋逻辑
let clickTimes = [];
const logoLink = document.querySelector('.logo');
if (logoLink) {
  logoLink.addEventListener('click', (e) => {
    const now = Date.now();
    clickTimes.push(now);
    clickTimes = clickTimes.filter(ts => now - ts <= 10000);
    if (clickTimes.length > 10) {
      e.preventDefault();
      alert('Bro you should get a job');
      window.location.href = 'https://www.bing.com';
    }
  });
}
</script>