---
import BgmPanel from '../components/BgmPanel.astro';
import '../styles/tailwind.css';

interface SEO {
    description?: string;
    image?: string;
    url?: string;
}

interface Props {
    title: string;
    seo?: SEO;
    narrative?: { chapter: string; quote: string };
}

const { title, seo, narrative } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={seo?.description ?? "Crepus Villa"} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/CRVL-TypeB.svg" />
        <link rel="canonical" href={seo?.url ?? "https://crepus.asia"} />
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={seo?.description ?? "Crepus Villa"} />
        <meta property="og:image" content={seo?.image ?? "/CRVL-TypeB.svg"} />
        <meta property="og:url" content={seo?.url ?? "https://crepus.asia"} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={seo?.description ?? "Crepus Villa"} />
        <meta name="twitter:image" content={seo?.image ?? "/CRVL-TypeB.svg"} />
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Crepuscular's Villa",
            "url": "https://crepus.asia",
            "description": seo?.description ?? "Crepus Villa"
        })} />
    </head>
    <body>
        <slot />
        {
            narrative && (
                <div class="narrative-marker">
                    <span class="narrative-chapter">· {narrative.chapter} ·</span>
                    <span class="narrative-quote">{narrative.quote}</span>
                </div>
            )
        }
        <BgmPanel client:load />
        
        <footer class="site-footer">
            <div class="safe-zone footer-content">
                <p class="footer-text">Powered By CloudFlare & Crepuscular, Designed and Developed by Cyril</p>
                <p class="footer-text">
                    Copyright © 2026 Crepuscular's Villa. All rights reserved. 
                    <a class="privacy-link" href="/privacy" rel="external">Privacy Policy</a>
                </p>
            </div>
        </footer>

        <script>
            import Lenis from '@studio-freight/lenis';
            import gsap from 'gsap';
            import { ScrollTrigger } from 'gsap/ScrollTrigger';
            import { bgmController } from '../lib/BgmController';

            gsap.registerPlugin(ScrollTrigger);

            if (typeof window !== 'undefined' && 'scrollRestoration' in window.history) {
                window.history.scrollRestoration = 'manual';
            }

            let lenis: Lenis | null = null;
            let lenisScrollAllowed = true;
            let lastFrameTime = 0;
            let scrollBlockerInstalled = false;

            const safeScrollUpdate = () => {
                if (!lenisScrollAllowed) return;
                ScrollTrigger.update();
            };

            const updateLenis = (time: number) => {
                if (!lenisScrollAllowed) return;
                if (typeof time !== 'number') return;
                if (time === lastFrameTime) return;
                const delta = time - lastFrameTime;
                if (delta > 0 && delta < 0.008) return;
                lastFrameTime = time;
                lenis?.raf(time * 1000);
            };

            function installScrollBlockers() {
                if (scrollBlockerInstalled) return;
                scrollBlockerInstalled = true;

                window.addEventListener('scroll', (event) => {
                    if (lenis) {
                        event.stopImmediatePropagation();
                    }
                }, { capture: true, passive: true });

                window.addEventListener('scrollend', (event) => {
                    if (lenis) {
                        event.stopImmediatePropagation();
                    }
                }, { capture: true, passive: true });
            }

            function initScroll() {
                if (lenis) {
                    lenis.destroy();
                    gsap.ticker.remove(updateLenis);
                }

                lenis = new Lenis({
                    duration: 1.2,
                    smoothWheel: true,
                    wrapper: window as unknown as HTMLElement,
                    content: document.documentElement as HTMLElement,
                });

                lenis.on('scroll', (e: any) => {
                    safeScrollUpdate();
                    const st = document.getElementById('scrollText');
                    if (st) st.style.transform = `translateX(${-e.animatedScroll * 0.45}px)`;
                });

                gsap.ticker.add(updateLenis);
                gsap.ticker.lagSmoothing(0);
                installScrollBlockers();
            }

            // 初始化 BGM 控制器
            bgmController.init({ autoplay: true, volume: 0.5 });

            document.addEventListener('DOMContentLoaded', () => {
                lenisScrollAllowed = true;
                initScroll();
                bgmController.restoreStateOnPageSwap();
            });
        </script>
    </body>
</html>

<style is:global>
    /* --- Lenis 核心辅助样式 --- */
    html.lenis, html.lenis body {
        height: auto;
    }

    .lenis.lenis-smooth {
        scroll-behavior: auto !important;
    }

    .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
    }

    .lenis.lenis-stopped {
        overflow: hidden;
    }

    .lenis.lenis-scrolling iframe {
        pointer-events: none;
    }

    /* --- 全局变量与样式 --- */
    :root {
        --bg-color: #FAFAFA;
        --text-main: #1d1d1f;
        --text-muted: #86868b;
        --card-bg: rgba(255, 255, 255, 0.8);
        --card-border: rgba(0, 0, 0, 0.05);
        --nav-bg: rgba(251, 251, 253, 0.8);
        --fw-light: 300;
        --fw-regular: 400;
        --fw-medium: 500;
        --fw-bold: 700;
        --container-padding: 1.5rem;
        --container-max-width: 1000px;
        --safe-area: clamp(20px, 6vw, 80px);
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg-color: #000000;
            --text-main: #f5f5f7;
            --text-muted: #a1a1a6;
            --card-bg: #1c1c1e;
            --card-border: rgba(255, 255, 255, 0.1);
            --nav-bg: rgba(0, 0, 0, 0.8);
            --accent-color: #f7c46c;
        }
    }

    @font-face {
        font-family: 'RAGE';
        src: url('/fonts/RAGE.woff2') format('woff2');
        font-weight: normal; font-style: normal; font-display: swap;
    }
    @font-face {
        font-family: 'Noto Sans TC Variable';
        src: url('/fonts/NotoSansTC-VF.woff2') format('woff2');
        font-weight: 100 900; font-style: normal; font-display: swap;
    }

    html {
        font-family: 'Noto Sans TC Variable', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        transition: background 0.3s ease;
    }

    body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root { --header-height: 52px; }
    main { padding-top: var(--header-height); }
    .safe-zone { padding-left: var(--safe-area); padding-right: var(--safe-area); }
    h1, h2, h3 { scroll-margin-top: calc(var(--header-height) + 1rem); }

    .site-footer {
        background: var(--bg-color);
        border-top: 1px solid rgba(0,0,0,0.1);
    }

    .footer-content {
        padding: 40px var(--container-padding, 1.5rem);
        text-align: center;
    }

    .footer-text {
        margin: 10px 0;
        font-size: 13px;
        color: #86868b;
    }

    @media (prefers-color-scheme: dark) {
        .site-footer { border-top-color: rgba(255, 255, 255, 0.1); }
        .footer-text { color: #a1a1a6; }
    }
    
    .privacy-link { color: inherit; text-decoration: none; }
    .privacy-link:hover { text-decoration: underline; }

    .narrative-marker {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
        text-align: right;
        pointer-events: none;
        opacity: 0.6;
        transition: opacity 0.3s ease;
    }
    .narrative-marker:hover {
        opacity: 1;
    }
    .narrative-chapter {
        display: block;
        font-size: 11px;
        letter-spacing: 0.15em;
        color: var(--accent-color, #f7c46c);
        font-weight: 700;
        text-transform: uppercase;
    }
    .narrative-quote {
        display: block;
        font-size: 10px;
        color: var(--text-muted, #86868b);
        font-style: italic;
        margin-top: 2px;
    }
</style>