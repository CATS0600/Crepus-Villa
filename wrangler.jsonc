{
	"main": "dist/_worker.js/index.js",
	"name": "crepus-villa",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crepus-villa",
			"database_id": "e3dfa794-4fcd-4b15-9222-c53b74af6f47"
		}
	],
	"observability": {
    "enabled": true
  }
}