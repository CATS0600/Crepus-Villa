{
  "name": "crepus-villa",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 关键：指定 Pages 的输出目录，这会替代你之前的 "assets" 和 "main" 配置
  "pages_build_output_dir": "./dist", 
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crepus-villa",
      "database_id": "e3dfa794-4fcd-4b15-9222-c53b74af6f47"
    }
  ],
  "observability": {
    "enabled": true
  }
}